# Everything personal lives in ~/.config/shell/*.sh, shared with bash and
# sourced in numeric order. See that directory's README for what goes where.
#
# Do not add configuration to this file. Machine-local additions -- including
# anything an installer appends -- belong in ~/.config/shell/local.sh, which is
# unmanaged and loaded last by dot_config/shell/80-local.sh. This file is
# managed by chezmoi, so edits made here are overwritten on the next
# `chezmoi apply`.
#
# The (N) glob qualifier is required: without it zsh errors on an unmatched
# glob rather than skipping the loop.
for _shell_module in "${XDG_CONFIG_HOME:-$HOME/.config}"/shell/*.sh(N); do
  [ -r "$_shell_module" ] && source "$_shell_module"
done
unset _shell_module

# Added by codebase-memory-mcp install
export PATH="/Users/harlan/.local/bin:$PATH"
