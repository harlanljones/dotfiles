{{ if eq .machine "augustus" -}}
#!/usr/bin/env bash
# Converge the Theme modes widget's light/dark slots from the dots theme
# registry, so `dots theme set` also steers the Omarchy desktop theme.
# Runs after every apply but is a cheap no-op when the matching slot already
# names the registry's Omarchy slug. Only the slot matching the registry
# entry's appearance is touched — the user's mode (manual/schedule/battery)
# is never flipped; the desktop follows the next time that mode is active.
#
# Needs the fork's setter IPC (setLightTheme/setDarkTheme on the
# esemczak.theme-modes target) and Backdrop re-splitting, both carried by
# harlanljones/omarchy-theme-modes. Generated (matugen) registry entries
# have no Omarchy slug and are skipped.
{{- $tname := (index .machines .machine).theme.name }}
{{- $t := index .themes $tname }}
set -euo pipefail

DOTS_THEME="{{ $tname }}"
DESIRED_SLUG="{{ if and $t $t.source (hasKey $t.source "kind") }}{{ if eq $t.source.kind "omarchy-public-theme" }}{{ $t.source.name }}{{ end }}{{ end }}"
DESIRED_APPEARANCE="{{ if $t }}{{ $t.appearance }}{{ end }}"

if [[ -z "$DESIRED_SLUG" ]]; then
	echo "run_after_35: dots theme '$DOTS_THEME' has no Omarchy slug (generated theme?), skipping modes convergence"
	exit 0
fi
if [[ ! "$DESIRED_SLUG" =~ ^[a-z0-9-]+$ ]]; then
	echo "run_after_35: refusing unexpected Omarchy slug '$DESIRED_SLUG'" >&2
	exit 0
fi
if [[ "$DESIRED_APPEARANCE" != "light" && "$DESIRED_APPEARANCE" != "dark" ]]; then
	echo "run_after_35: dots theme '$DOTS_THEME' has unknown appearance '$DESIRED_APPEARANCE', skipping" >&2
	exit 0
fi
for cmd in omarchy-shell jq; do
	command -v "$cmd" >/dev/null 2>&1 || {
		echo "run_after_35: missing '$cmd', skipping modes convergence" >&2
		exit 0
	}
done

status="$(omarchy-shell esemczak.theme-modes status 2>/dev/null || true)"
if [[ -z "$status" ]] || ! jq -e . >/dev/null 2>&1 <<<"$status"; then
	echo "run_after_35: theme-modes IPC unavailable (plugin off or shell down), skipping" >&2
	exit 0
fi

if [[ "$DESIRED_APPEARANCE" == "dark" ]]; then
	slot="darkTheme"
	setter="setDarkTheme"
else
	slot="lightTheme"
	setter="setLightTheme"
fi
current="$(jq -r --arg slot "$slot" '.[$slot] // ""' <<<"$status")"
mode="$(jq -r '.mode // ""' <<<"$status")"
if [[ "$current" == "$DESIRED_SLUG" ]]; then
	exit 0
fi

echo "run_after_35: theme-modes $slot: '${current:-none}' -> '$DESIRED_SLUG' (dots theme '$DOTS_THEME')"
if ! omarchy-shell "esemczak.theme-modes" "$setter" "$DESIRED_SLUG" >/dev/null 2>&1; then
	echo "run_after_35: modes convergence IPC failed (non-fatal)" >&2
	exit 0
fi
if [[ "$mode" != "$DESIRED_APPEARANCE" ]]; then
	echo "run_after_35: mode is '$mode'; desktop follows '$DESIRED_SLUG' when $DESIRED_APPEARANCE mode is active"
fi
{{- end }}
