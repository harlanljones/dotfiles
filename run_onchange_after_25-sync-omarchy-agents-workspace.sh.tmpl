{{- if and (hasKey .chezmoi.osRelease "id") (eq .chezmoi.osRelease.id "omarchy") -}}
#!/bin/bash
# Builds and deploys omarchy-agents workspace when package manifests change
# or when OMARCHY_AGENTS_FORCE_BUILD=1 is set.
#
# package.json hash: {{ if stat (printf "%s/dev/omarchy-agents/package.json" .chezmoi.homeDir) }}{{ include (printf "%s/dev/omarchy-agents/package.json" .chezmoi.homeDir) | sha256sum }}{{ end }}
# bun.lock hash: {{ if stat (printf "%s/dev/omarchy-agents/bun.lock" .chezmoi.homeDir) }}{{ include (printf "%s/dev/omarchy-agents/bun.lock" .chezmoi.homeDir) | sha256sum }}{{ end }}

set -euo pipefail

repo="$HOME/dev/omarchy-agents"
repo_url="https://github.com/harlanljones/omarchy-agents.git"
bun="$HOME/.local/share/mise/installs/bun/latest/bin/bun"

if [[ ! -f "$repo/package.json" ]]; then
  echo "omarchy-agents: $repo is not checked out from $repo_url; skipping workspace deployment" >&2
  exit 0
fi

if [[ ! -x "$bun" ]]; then
  echo "omarchy-agents: Bun is unavailable at $bun; skipping workspace deployment" >&2
  exit 0
fi

cd "$repo" || exit 1
"$bun" install --frozen-lockfile
"$bun" run check
"$bun" run deploy:local
systemctl --user daemon-reload
{{- end -}}
