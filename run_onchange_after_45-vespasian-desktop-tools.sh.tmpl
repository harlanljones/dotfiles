# Set Flow Launcher's active theme to Dots, preserving any other settings
# that already exist (Flow Launcher only writes Settings.json after first
# launch, so it may not exist yet on a fresh install).
flow_settings_dir="$flow_dir/UserData/Settings"
mkdir -p "$flow_settings_dir"
python3 - "$flow_settings_dir/Settings.json" <<'PY_EOF'
import json
import sys

path = sys.argv[1]
try:
    with open(path) as f:
        settings = json.load(f)
except (FileNotFoundError, json.JSONDecodeError):
    settings = {}

settings["Theme"] = "Dots"

with open(path, "w") as f:
    json.dump(settings, f, indent=4)
PY_EOF

# 10. Setup user startup shortcuts so tools auto-start on Windows login
