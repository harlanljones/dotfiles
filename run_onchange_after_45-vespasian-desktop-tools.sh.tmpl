#!/usr/bin/env bash
# Vespasian (WSL) setup; non-vespasian machines: no-op.
{{- if and (hasKey . "machine") (eq .machine "vespasian") -}}
{{- $name := (index .machines .machine).theme.name -}}
{{- $scheme := regexReplaceAll "(?m)^#.*$" (include (printf ".chezmoitemplates/themes/%s/windows_terminal.json" $name)) "" | fromJson -}}
# Deploy and configure Linux-like desktop tools on Windows for Vespasian:
# - GlazeWM (tiling window manager)
# - Zebar (status bar)
# - Flow Launcher (keyboard launcher)
# - QuickLook (spacebar preview)
# - TranslucentTB (transparent Windows taskbar)
# - AutoHotkey (prevents Super bindings from opening the Start menu)
#
# Theme: {{ (index .themes $name).label }}
# Active border: {{ $scheme.blue }}
# Inactive border: {{ $scheme.brightBlack }}

set -euo pipefail

windows_tool="$HOME/.local/bin/wsl-windows-tool"
if [[ ! -x "$windows_tool" ]] || ! command -v wslpath >/dev/null 2>&1 || \
   ! cmd_exe="$($windows_tool path cmd)" || ! powershell_exe="$($windows_tool path powershell)"; then
  echo "desktop-tools: not running under WSL, skipping"
  exit 0
fi
winget_exe=""
winget_exe="$($windows_tool path winget 2>/dev/null || true)"

win_localappdata="$(cd /mnt/c && "$cmd_exe" /d /c 'echo %LOCALAPPDATA%' 2>/dev/null | tr -d '\r')"
wsl_localappdata="$(wslpath "$win_localappdata")"
win_userprofile="$(cd /mnt/c && "$cmd_exe" /d /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r')"
wsl_userprofile="$(wslpath "$win_userprofile")"

programs_dir="$wsl_localappdata/Programs"
mkdir -p "$programs_dir"

# 1. Install GlazeWM if missing
glazewm_dir="$programs_dir/glazewm"
if [[ ! -f "$glazewm_dir/glazewm.exe" ]]; then
  echo "desktop-tools: installing GlazeWM v3.10.1..."
  tmp_dir="$(mktemp -d -p "$wsl_localappdata/Temp")"
  curl -fsSL -o "$tmp_dir/glazewm.msi" "https://github.com/glzr-io/glazewm/releases/download/v3.10.1/standalone-glazewm-v3.10.1-x64.msi"
  win_tmp="$(cd /mnt/c && "$cmd_exe" /d /c "echo $(wslpath -w "$tmp_dir/glazewm.msi")" 2>/dev/null | tr -d '\r')"
  "$cmd_exe" /c "msiexec.exe /a \"$win_tmp\" /qn TARGETDIR=\"$win_localappdata\\Programs\\glazewm_extract\"" < /dev/null
  mkdir -p "$glazewm_dir"
  mv "$wsl_localappdata/Programs/glazewm_extract/PFiles64/glzr.io/glazewm/"* "$glazewm_dir/"
  rm -rf "$tmp_dir" "$wsl_localappdata/Programs/glazewm_extract"
fi

# 2. Install Zebar if missing
zebar_dir="$programs_dir/zebar"
if [[ ! -f "$zebar_dir/zebar.exe" ]]; then
  echo "desktop-tools: installing Zebar v3.3.1..."
  tmp_dir="$(mktemp -d -p "$wsl_localappdata/Temp")"
  curl -fsSL -o "$tmp_dir/zebar.msi" "https://github.com/glzr-io/zebar/releases/download/v3.3.1/zebar-v3.3.1-opt1-x64.msi"
  win_tmp="$(cd /mnt/c && "$cmd_exe" /d /c "echo $(wslpath -w "$tmp_dir/zebar.msi")" 2>/dev/null | tr -d '\r')"
  "$cmd_exe" /c "msiexec.exe /a \"$win_tmp\" /qn TARGETDIR=\"$win_localappdata\\Programs\\zebar_extract\"" < /dev/null
  mkdir -p "$zebar_dir"
  mv "$wsl_localappdata/Programs/zebar_extract/PFiles/glzr.io/Zebar/"* "$zebar_dir/"
  rm -rf "$tmp_dir" "$wsl_localappdata/Programs/zebar_extract"
fi

# 3. Install Flow Launcher if missing
flow_dir="$wsl_localappdata/FlowLauncher"
if [[ ! -f "$flow_dir/Flow.Launcher.exe" ]]; then
  echo "desktop-tools: installing Flow Launcher..."
  tmp_dir="$(mktemp -d -p "$wsl_localappdata/Temp")"
  curl -fsSL -o "$tmp_dir/flow.zip" "https://github.com/Flow-Launcher/Flow.Launcher/releases/download/v2.1.3/Flow-Launcher-Portable.zip"
  mkdir -p "$flow_dir"
  unzip -q -o "$tmp_dir/flow.zip" -d "$flow_dir"
  if [[ -d "$flow_dir/FlowLauncher" ]]; then
    mv "$flow_dir/FlowLauncher/"* "$flow_dir/"
    rmdir "$flow_dir/FlowLauncher"
  fi
  rm -rf "$tmp_dir"
fi

# 4. Install QuickLook if missing
quicklook_dir="$programs_dir/QuickLook"
if [[ ! -f "$quicklook_dir/QuickLook.exe" ]]; then
  echo "desktop-tools: installing QuickLook..."
  tmp_dir="$(mktemp -d -p "$wsl_localappdata/Temp")"
  curl -fsSL -o "$tmp_dir/quicklook.zip" "https://github.com/QL-Win/QuickLook/releases/download/4.5.0/QuickLook-4.5.0.zip"
  mkdir -p "$quicklook_dir"
  unzip -q -o "$tmp_dir/quicklook.zip" -d "$quicklook_dir"
  rm -rf "$tmp_dir"
fi

# 5. Install TranslucentTB for a transparent taskbar if missing
if [[ -n "$winget_exe" ]] && \
   ! "$winget_exe" list --id CharlesMilette.TranslucentTB --exact --accept-source-agreements >/dev/null 2>&1; then
  echo "desktop-tools: installing TranslucentTB..."
  "$winget_exe" install \
    --id CharlesMilette.TranslucentTB \
    --exact \
    --source winget \
    --scope user \
    --silent \
    --accept-package-agreements \
    --accept-source-agreements \
    --disable-interactivity < /dev/null
fi

# 6. Install AutoHotkey v2 for the Super-key mask if missing
autohotkey_exe="$wsl_localappdata/Programs/AutoHotkey/v2/AutoHotkey64.exe"
if [[ -n "$winget_exe" && ! -f "$autohotkey_exe" ]]; then
  echo "desktop-tools: installing AutoHotkey v2..."
  "$winget_exe" install \
    --id AutoHotkey.AutoHotkey \
    --exact \
    --source winget \
    --scope user \
    --silent \
    --accept-package-agreements \
    --accept-source-agreements \
    --disable-interactivity < /dev/null
fi

# 6c. Install WezTerm if missing
wezterm_dir="$programs_dir/wezterm"
if [[ ! -f "$wezterm_dir/wezterm-gui.exe" ]]; then
  echo "desktop-tools: installing WezTerm v20240203..."
  tmp_dir="$(mktemp -d -p "$wsl_localappdata/Temp")"
  curl -fsSL -o "$tmp_dir/wezterm.zip" "https://github.com/wez/wezterm/releases/download/20240203-110809-5046fc22/WezTerm-windows-20240203-110809-5046fc22.zip"
  mkdir -p "$wezterm_dir"
  unzip -q -o "$tmp_dir/wezterm.zip" -d "$tmp_dir/extract"
  mv "$tmp_dir/extract/WezTerm-windows-"*/* "$wezterm_dir/"
  rm -rf "$tmp_dir"
fi

# 7. Ensure paths are registered in Windows user PATH
python3 - "$win_localappdata" "$powershell_exe" <<'PY_EOF'
import subprocess
import sys

win_appdata, powershell_exe = sys.argv[1:3]
extra_paths = [
    rf"{win_appdata}\Programs\glazewm",
    rf"{win_appdata}\Programs\glazewm\cli",
    rf"{win_appdata}\Programs\zebar",
    rf"{win_appdata}\Programs\wezterm",
    rf"{win_appdata}\FlowLauncher",
]

ps_cmd = r'(Get-ItemProperty -Path HKCU:\Environment -Name Path -ErrorAction SilentlyContinue).Path'
current_path = subprocess.check_output([powershell_exe, "-NoProfile", "-Command", ps_cmd], text=True).strip()

parts = [p.strip() for p in current_path.split(';') if p.strip()]
updated = False
for ep in extra_paths:
    if not any(p.lower() == ep.lower() for p in parts):
        parts.append(ep)
        updated = True

if updated:
    new_path = ';'.join(parts) + ';'
    set_cmd = f'[Environment]::SetEnvironmentVariable("Path", "{new_path}", [System.EnvironmentVariableTarget]::User)'
    subprocess.run([powershell_exe, "-NoProfile", "-Command", set_cmd], check=True)
PY_EOF

# 8. Configure GlazeWM with the active dots theme's border colors and dev keybindings
glzr_dir="$wsl_userprofile/.glzr/glazewm"
mkdir -p "$glzr_dir"

cat <<'EOF_CONFIG' > "$glzr_dir/config.yaml"
general:
  startup_commands: ['shell-exec C:\Users\harlan\AppData\Local\Programs\zebar\zebar.exe']
  shutdown_commands: []
  config_reload_commands: []
  focus_follows_cursor: false
  toggle_workspace_on_refocus: false
  cursor_jump:
    enabled: true
    trigger: 'monitor_focus'
  hide_method: 'cloak'
  show_all_in_taskbar: false

gaps:
  # Matches Augustus's Hyprland gaps_in=2/gaps_out=5 ratio. Zebar reserves its
  # own space via dockToEdge (see zpack.json), so GlazeWM's work area already
  # excludes the bar — outer_gap.top only needs the same small margin as the
  # other edges, not extra clearance for the bar itself.
  scale_with_dpi: true
  inner_gap: '4px'
  outer_gap:
    top: '8px'
    right: '8px'
    bottom: '8px'
    left: '8px'

window_effects:
  focused_window:
    border:
      enabled: true
      color: '{{ $scheme.blue }}'
    hide_title_bar:
      enabled: false
    corner_style:
      # 'small_rounded' is the closest match to Hyprland's modest rounding=8;
      # 'rounded' is Windows 11's larger default radius.
      enabled: true
      style: 'small_rounded'
  other_windows:
    border:
      enabled: true
      color: '{{ $scheme.brightBlack }}'
    hide_title_bar:
      enabled: false
    corner_style:
      enabled: true
      style: 'small_rounded'

window_behavior:
  initial_state: 'tiling'
  state_defaults:
    floating:
      centered: true
      shown_on_top: false
    fullscreen:
      maximized: false
      shown_on_top: false

workspaces:
  # Match Augustus's Hyprland connector order:
  #   1 = LG UltraGear (DP-1, bottom left)
  #   2 = Lenovo T32p-20 (DP-2, right)
  #   3 = Acer XF270HU (DP-3, upper left)
  # GlazeWM indexes monitors geometrically as Acer=0, LG=1, Lenovo=2.
  - name: '1'
    bind_to_monitor: 1
  - name: '2'
    bind_to_monitor: 2
  - name: '3'
    bind_to_monitor: 0
  - name: '4'
  - name: '5'
  - name: '6'
  - name: '7'
  - name: '8'
  - name: '9'

window_rules:
  - commands: ['ignore']
    match:
      - window_process: { equals: 'zebar' }
      - window_process: { equals: 'Flow.Launcher' }
      - window_process: { equals: 'QuickLook' }
      - window_process: { equals: '1Password' }
      - window_process: { equals: 'Steam' }
      - window_process: { equals: 'steamwebhelper' }
      - window_process: { equals: 'discord' }
      - window_process: { equals: 'Taskmgr' }
      - window_process: { equals: 'PowerToys' }
      - window_title: { regex: '[Pp]icture.in.[Pp]icture' }
        window_class: { regex: 'Chrome_WidgetWin_1|MozillaDialogClass' }
      - window_class: { regex: '#32770' }

binding_modes:
  - name: 'resize'
    keybindings:
      - commands: ['resize --width -2%']
        bindings: ['h', 'left']
      - commands: ['resize --width +2%']
        bindings: ['l', 'right']
      - commands: ['resize --height +2%']
        bindings: ['k', 'up']
      - commands: ['resize --height -2%']
        bindings: ['j', 'down']
      - commands: ['wm-disable-binding-mode --name resize']
        bindings: ['escape', 'enter']

keybindings:
  # Focus navigation (Arrow keys, plus Vim left/up/right)
  - commands: ['focus --direction left']
    bindings: ['lwin+left', 'alt+left', 'lwin+h', 'alt+h']
  - commands: ['focus --direction right']
    bindings: ['lwin+right', 'alt+right', 'lwin+l', 'alt+l']
  - commands: ['focus --direction up']
    bindings: ['lwin+up', 'alt+up', 'lwin+k', 'alt+k']
  - commands: ['focus --direction down']
    bindings: ['lwin+down', 'alt+down']

  # Move window (Super + Shift + Arrows or Vim HJKL)
  - commands: ['move --direction left']
    bindings: ['lwin+shift+left', 'alt+shift+left', 'lwin+shift+h', 'alt+shift+h']
  - commands: ['move --direction right']
    bindings: ['lwin+shift+right', 'alt+shift+right', 'lwin+shift+l', 'alt+shift+l']
  - commands: ['move --direction up']
    bindings: ['lwin+shift+up', 'alt+shift+up', 'lwin+shift+k', 'alt+shift+k']
  - commands: ['move --direction down']
    bindings: ['lwin+shift+down', 'alt+shift+down', 'lwin+shift+j', 'alt+shift+j']

  # Resize mode (Super + R or Alt + R)
  - commands: ['wm-enable-binding-mode --name resize']
    bindings: ['lwin+r', 'alt+r']

  # Gaming & emergency pause toggle
  - commands: ['wm-toggle-pause']
    bindings: ['lwin+shift+p', 'alt+shift+p']

  # Layout controls (Omarchy / Hyprland parity)
  # Toggle split direction: Super + J (matches Hyprland togglesplit)
  - commands: ['toggle-tiling-direction']
    bindings: ['lwin+j', 'alt+j']
  # Toggle floating: Super + V or Super + T (matches Hyprland togglefloating)
  - commands: ['toggle-floating --centered']
    bindings: ['lwin+v', 'alt+v', 'lwin+t', 'alt+t', 'lwin+shift+space', 'alt+shift+space']
  - commands: ['toggle-fullscreen']
    bindings: ['lwin+f', 'alt+f']
  - commands: ['toggle-minimized']
    bindings: ['lwin+m', 'alt+m']
  - commands: ['close']
    bindings: ['lwin+w', 'alt+w', 'lwin+q', 'lwin+shift+q', 'alt+shift+q']
  - commands: ['wm-reload-config']
    bindings: ['lwin+shift+r', 'alt+shift+r']
  - commands: ['wm-exit']
    bindings: ['lwin+shift+e', 'alt+shift+e']

  # Primary terminal: WezTerm running natively on Windows with DirectWrite and WSL domain
  - commands: ['shell-exec C:\Users\harlan\AppData\Local\Programs\wezterm\wezterm-gui.exe']
    bindings: ['lwin+enter']
  # Fallback terminal: Windows Terminal running Ubuntu profile natively
  - commands: ['shell-exec wt -p Ubuntu-24.04']
    bindings: ['alt+enter']

  # App launcher: Flow Launcher (Super + Space)
  - commands: ['shell-exec C:\Users\harlan\AppData\Local\FlowLauncher\Flow.Launcher.exe']
    bindings: ['lwin+space', 'alt+space']

  # Browser launcher: Google Chrome (Super + Shift + B, Super + B, Super + Shift + Enter, Alt fallbacks)
  - commands: ['shell-exec --hide-window cmd.exe /c start chrome']
    bindings: ['lwin+shift+b', 'lwin+b', 'lwin+shift+enter', 'alt+shift+b', 'alt+b', 'alt+shift+enter']

  # Browser private / incognito (Super + Shift + Alt + B)
  - commands: ['shell-exec --hide-window cmd.exe /c start chrome --incognito']
    bindings: ['lwin+shift+alt+b']

  # File manager: Explorer (Super + E, Super + Shift + F)
  - commands: ['shell-exec explorer.exe']
    bindings: ['lwin+e', 'alt+e', 'lwin+shift+f', 'alt+shift+f']

  # Editor: VS Code (Super + Shift + N)
  - commands: ['shell-exec --hide-window cmd.exe /c start code']
    bindings: ['lwin+shift+n', 'alt+shift+n']

  # Passwords: 1Password (Super + Shift + Slash)
  - commands: ['shell-exec --hide-window cmd.exe /c start 1password:']
    bindings: ['lwin+shift+slash', 'alt+shift+slash']

  # Calculator: Windows Calculator (Super + Ctrl + Q)
  - commands: ['shell-exec calc.exe']
    bindings: ['lwin+ctrl+q', 'alt+ctrl+q']

  # Web apps (Omarchy defaults)
  # ChatGPT (Super + Shift + A)
  - commands: ['shell-exec --hide-window cmd.exe /c start https://chatgpt.com']
    bindings: ['lwin+shift+a', 'alt+shift+a']

  # Grok (Super + Shift + Alt + A)
  - commands: ['shell-exec --hide-window cmd.exe /c start https://grok.com']
    bindings: ['lwin+shift+alt+a']

  # X (Super + Shift + X)
  - commands: ['shell-exec --hide-window cmd.exe /c start https://x.com']
    bindings: ['lwin+shift+x', 'alt+shift+x']

  # YouTube (Super + Shift + Y)
  - commands: ['shell-exec --hide-window cmd.exe /c start https://youtube.com']
    bindings: ['lwin+shift+y', 'alt+shift+y']

  # Workspace switching (Super + 1..9 or Alt + 1..9)
  - commands: ['focus --workspace 1']
    bindings: ['lwin+1', 'alt+1']
  - commands: ['focus --workspace 2']
    bindings: ['lwin+2', 'alt+2']
  - commands: ['focus --workspace 3']
    bindings: ['lwin+3', 'alt+3']
  - commands: ['focus --workspace 4']
    bindings: ['lwin+4', 'alt+4']
  - commands: ['focus --workspace 5']
    bindings: ['lwin+5', 'alt+5']
  - commands: ['focus --workspace 6']
    bindings: ['lwin+6', 'alt+6']
  - commands: ['focus --workspace 7']
    bindings: ['lwin+7', 'alt+7']
  - commands: ['focus --workspace 8']
    bindings: ['lwin+8', 'alt+8']
  - commands: ['focus --workspace 9']
    bindings: ['lwin+9', 'alt+9']

  # Move window to workspace (Super + Shift + 1..9 or Alt + Shift + 1..9)
  - commands: ['move --workspace 1', 'focus --workspace 1']
    bindings: ['lwin+shift+1', 'alt+shift+1']
  - commands: ['move --workspace 2', 'focus --workspace 2']
    bindings: ['lwin+shift+2', 'alt+shift+2']
  - commands: ['move --workspace 3', 'focus --workspace 3']
    bindings: ['lwin+shift+3', 'alt+shift+3']
  - commands: ['move --workspace 4', 'focus --workspace 4']
    bindings: ['lwin+shift+4', 'alt+shift+4']
  - commands: ['move --workspace 5', 'focus --workspace 5']
    bindings: ['lwin+shift+5', 'alt+shift+5']
  - commands: ['move --workspace 6', 'focus --workspace 6']
    bindings: ['lwin+shift+6', 'alt+shift+6']
  - commands: ['move --workspace 7', 'focus --workspace 7']
    bindings: ['lwin+shift+7', 'alt+shift+7']
  - commands: ['move --workspace 8', 'focus --workspace 8']
    bindings: ['lwin+shift+8', 'alt+shift+8']
  - commands: ['move --workspace 9', 'focus --workspace 9']
    bindings: ['lwin+shift+9', 'alt+shift+9']
EOF_CONFIG

# 9. Deploy the Zebar status bar with mode indicator, themed from the active
# dots theme's colors (same $scheme source as Windows Terminal, above).
zebar_conf_dir="$wsl_userprofile/.glzr/zebar"

# Previously shipped as a Tokyo-Night-only pack; drop the old directory so a
# theme switch doesn't leave a stale, unreferenced copy behind.
if [[ -d "$zebar_conf_dir/tokyonight" ]]; then
  rm -rf "$zebar_conf_dir/tokyonight"
fi

mkdir -p "$zebar_conf_dir/dots"

# settings.json — point Zebar at our custom pack
cat <<'ZEBAR_SETTINGS' > "$zebar_conf_dir/settings.json"
{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.3.1/resources/settings-schema.json",
  "startupConfigs": [
    {
      "pack": "dots",
      "widget": "bar",
      "preset": "default"
    }
  ]
}
ZEBAR_SETTINGS

# zpack.json — widget pack manifest
cat <<'ZBAR_PACK' > "$zebar_conf_dir/dots/zpack.json"
{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.0.0/resources/zpack-schema.json",
  "name": "dots",
  "version": "1.0.0",
  "description": "dots-themed status bar for GlazeWM with Gaming vs Dev mode indicator",
  "widgets": [
    {
      "name": "bar",
      "htmlPath": "./index.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": true,
      "transparent": true,
      "includeFiles": ["*.html", "*.css"],
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "44px",
          "monitorSelection": { "type": "all" },
          "dockToEdge": { "enabled": true, "edge": "top", "windowMargin": "0px" }
        }
      ]
    }
  ]
}
ZBAR_PACK

# styles.css — bar theme derived from the active dots theme's palette. Alpha
# variants use CSS color-mix() so no rgba() literal here is tied to any one
# theme's colors (WebView2/Chromium 111+ required; Zebar's runtime qualifies).
cat > "$zebar_conf_dir/dots/styles.css" <<'ZBAR_CSS'
@import 'https://www.nerdfonts.com/assets/css/webfont.css';

:root {
  --bg: {{ $scheme.background }};
  --bg-dark: {{ $scheme.black }};
  --fg: {{ $scheme.foreground }};
  --fg-bright: {{ $scheme.brightWhite }};
  --muted: {{ $scheme.brightBlack }};
  --accent-blue: {{ $scheme.blue }};
  --accent-cyan: {{ $scheme.cyan }};
  --accent-green: {{ $scheme.green }};
  --accent-purple: {{ $scheme.purple }};
  --accent-red: {{ $scheme.red }};
  --accent-yellow: {{ $scheme.yellow }};

  --bg-primary: color-mix(in srgb, var(--bg) 90%, transparent);
  --bg-secondary: color-mix(in srgb, var(--bg-dark) 70%, transparent);
  --text-main: var(--fg);
  --text-muted: var(--accent-blue);
  --border-color: color-mix(in srgb, var(--muted) 60%, transparent);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: 'JetBrainsMono Nerd Font', 'JetBrains Mono', ui-monospace, monospace;
  user-select: none;
}

html, body, #root {
  height: 100%;
  overflow: hidden;
}

body {
  background: transparent;
  color: var(--text-main);
  font-size: 14px;
}

.bar-container {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  height: 100%;
  padding: 0 16px;
  background: var(--bg-primary);
  border-bottom: 1px solid var(--border-color);
  backdrop-filter: blur(12px);
}

.left, .center, .right {
  display: flex;
  align-items: center;
  gap: 8px;
}

.center {
  justify-content: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.right {
  justify-content: flex-end;
}

/* Right-side clusters: system / network / utility, each capped with a
   micro-label so the eye can jump to a cluster instead of one long row. */
.group {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  padding-top: 3px;
  padding-bottom: 3px;
}

.group-row {
  display: flex;
  align-items: center;
  gap: 6px;
}

.group-label {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: color-mix(in srgb, var(--fg) 55%, transparent);
}

.divider {
  width: 1px;
  height: 20px;
  background: color-mix(in srgb, var(--fg) 55%, transparent);
}

/* Mode pill styling */
.mode-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border-radius: 4px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.5px;
  cursor: pointer;
  border: 1px solid transparent;
  transition: all 0.2s ease;
}

.mode-badge.dev {
  background: color-mix(in srgb, var(--accent-blue) 18%, transparent);
  border-color: var(--accent-blue);
  color: var(--accent-blue);
}

.mode-badge.dev:hover {
  background: color-mix(in srgb, var(--accent-blue) 35%, transparent);
}

.mode-badge.gaming {
  background: color-mix(in srgb, var(--accent-red) 25%, transparent);
  border-color: var(--accent-red);
  color: var(--accent-red);
  animation: pulse-glow 2s infinite;
}

.mode-badge.gaming:hover {
  background: color-mix(in srgb, var(--accent-red) 40%, transparent);
}

.mode-badge.resize {
  background: color-mix(in srgb, var(--accent-purple) 25%, transparent);
  border-color: var(--accent-purple);
  color: var(--accent-purple);
}

@keyframes pulse-glow {
  0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent-red) 40%, transparent); }
  70% { box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent-red) 0%, transparent); }
  100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent-red) 0%, transparent); }
}

/* Workspaces */
.workspaces {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-left: 6px;
}

.ws-btn {
  background: var(--bg-secondary);
  color: var(--text-main);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 4px;
  padding: 3px 8px;
  font-size: 13px;
  cursor: pointer;
  transition: all 0.15s ease;
}

.ws-btn:hover {
  background: color-mix(in srgb, var(--accent-blue) 25%, transparent);
  border-color: var(--accent-blue);
}

.ws-btn.focused {
  background: var(--accent-blue);
  color: var(--bg);
  font-weight: 700;
  border-color: var(--accent-blue);
}

.ws-btn.displayed:not(.focused) {
  background: color-mix(in srgb, var(--accent-blue) 15%, transparent);
  border-color: color-mix(in srgb, var(--accent-blue) 40%, transparent);
}

/* Window title */
.window-title {
  color: var(--fg-bright);
  font-size: 13px;
  font-weight: 500;
  max-width: 450px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.window-title.idle {
  color: var(--muted);
  font-style: italic;
  letter-spacing: 0.5px;
}

/* Right stats */
.stat-item {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 3px 8px;
  background: var(--bg-secondary);
  border-radius: 4px;
  border: 1px solid rgba(255, 255, 255, 0.05);
  font-size: 13px;
}

.stat-item i { color: var(--accent-cyan); }
.stat-item.clock i { color: var(--accent-purple); }
.stat-item.memory i { color: var(--accent-green); }
.stat-item.cpu i { color: var(--accent-yellow); }
.stat-item.ip i { color: var(--accent-blue); }
.stat-item.network i { color: var(--accent-cyan); font-size: 10px; }
.stat-item.volume { cursor: pointer; }
.stat-item.volume i { color: var(--accent-blue); }
.stat-item.disk i { color: var(--accent-green); }
.stat-item.disk.low { border-color: var(--accent-red); }
.stat-item.disk.low i { color: var(--accent-red); }
.stat-item.weather i { color: var(--accent-yellow); }

.sparkline {
  color: var(--accent-yellow);
  margin-left: 2px;
}

/* Systray menu: collapsed behind a toggle button (chevron + count) so hidden
   icons don't clutter the bar by default; clicking reveals them inline. */
.systray-menu {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.systray-toggle i { color: var(--accent-blue); }

.systray {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 0 4px;
}

.systray-icon {
  width: 16px;
  height: 16px;
  cursor: pointer;
  opacity: 0.85;
  transition: opacity 0.15s ease;
}

.systray-icon:hover {
  opacity: 1;
}
ZBAR_CSS

# index.html — React widget with live Gaming/Dev mode indicator
cat <<'ZBAR_HTML' > "$zebar_conf_dir/dots/index.html"
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" type="text/css" href="./styles.css" />
    <script
      src="https://unpkg.com/@babel/standalone@7.25.6/babel.min.js"
      crossorigin="anonymous"
    ></script>
  </head>
  <body>
    <div id="root"></div>

    <script type="text/babel" data-type="module">
      import React, { useState, useEffect } from 'https://esm.sh/react@18?dev';
      import { createRoot } from 'https://esm.sh/react-dom@18/client?dev';
      import * as zebar from 'https://esm.sh/zebar@3.0';

      const providers = zebar.createProviderGroup({
        glazewm: { type: 'glazewm' },
        cpu: { type: 'cpu' },
        memory: { type: 'memory' },
        date: { type: 'date', formatting: 'EEE MMM d  HH:mm' },
        network: { type: 'network' },
        ip: { type: 'ip' },
        audio: { type: 'audio' },
        systray: { type: 'systray' },
        disk: { type: 'disk' },
        weather: { type: 'weather' },
      });

      function formatDataRate(measure) {
        if (!measure) return '0 KB/s';
        return `${measure.siValue.toFixed(1)} ${measure.siUnit}/s`;
      }

      const WEATHER_ICONS = {
        clear_day: 'nf-weather-day_sunny',
        clear_night: 'nf-weather-night_clear',
        cloudy_day: 'nf-weather-day_cloudy',
        cloudy_night: 'nf-weather-night_alt_cloudy',
        light_rain_day: 'nf-weather-day_rain',
        light_rain_night: 'nf-weather-night_alt_rain',
        heavy_rain_day: 'nf-weather-day_rain_wind',
        heavy_rain_night: 'nf-weather-night_alt_rain_wind',
        snow_day: 'nf-weather-day_snow',
        snow_night: 'nf-weather-night_alt_snow',
        thunder_day: 'nf-weather-day_thunderstorm',
        thunder_night: 'nf-weather-night_alt_thunderstorm',
      };

      // Walks a workspace's focus order down to the actual focused window,
      // rather than GlazeWM's global focusedContainer (which is the same for
      // every monitor's bar). Returns null when the workspace has no windows.
      function focusedWindowTitle(container) {
        let node = container;
        while (node && node.type !== 'window') {
          if (!node.children || node.children.length === 0) return null;
          const focusedId = node.childFocusOrder?.[0];
          node = node.children.find(c => c.id === focusedId) ?? node.children[0];
        }
        return node?.title || null;
      }

      createRoot(document.getElementById('root')).render(<App />);

      function App() {
        const [output, setOutput] = useState(providers.outputMap);

        useEffect(() => {
          providers.onOutput(() => setOutput(providers.outputMap));
        }, []);

        const g = output.glazewm;
        const isPaused = g?.isPaused ?? false;
        const bindingModes = g?.bindingModes ?? [];
        const workspaces = g?.currentWorkspaces ?? [];
        const displayedWorkspace = workspaces.find(ws => ws.isDisplayed);
        const windowTitle = focusedWindowTitle(displayedWorkspace);
        const cursor_pointer = {cursor: 'pointer'};

        // AudioDevice has no isMuted field, so track mute locally; this can
        // drift if volume is changed from outside Zebar (e.g. Windows mixer).
        const [isMuted, setIsMuted] = useState(false);
        const [systrayOpen, setSystrayOpen] = useState(false);
        const playbackDevice = output.audio?.defaultPlaybackDevice;
        const volume = playbackDevice?.volume ?? 0;

        const handleVolumeWheel = (e) => {
          if (!output.audio) return;
          const delta = e.deltaY < 0 ? 5 : -5;
          const nextVolume = Math.max(0, Math.min(100, volume + delta));
          output.audio.setVolume(nextVolume);
        };

        const toggleMute = () => {
          if (!output.audio) return;
          output.audio.setMute(!isMuted);
          setIsMuted(!isMuted);
        };

        const traffic = output.network?.traffic;

        // Rolling CPU usage history for the sparkline (last 20 samples).
        const [cpuHistory, setCpuHistory] = useState([]);
        useEffect(() => {
          if (output.cpu) {
            setCpuHistory(prev => [...prev.slice(-19), output.cpu.usage]);
          }
        }, [output.cpu?.usage]);

        const primaryDisk = output.disk?.disks?.find(d =>
          d.mountPoint.toUpperCase().startsWith('C'),
        );
        const diskPercentFree = primaryDisk
          ? (primaryDisk.availableSpace.bytes / primaryDisk.totalSpace.bytes) * 100
          : null;

        return (
          <div className="bar-container">
            <div className="left">
              {/* Mode indicator: Gaming vs Dev/Tiling */}
              {isPaused ? (
                <button
                  className="mode-badge gaming"
                  onClick={() => g?.runCommand('wm-toggle-pause')}
                  title="Gaming Mode Active: Window management paused. Click or press Super+Shift+P to resume dev/tiling."
                >
                  🎮 GAMING
                </button>
              ) : (
                <button
                  className="mode-badge dev"
                  onClick={() => g?.runCommand('wm-toggle-pause')}
                  title="Dev / Tiling Mode Active. Click or press Super+Shift+P to pause for gaming."
                >
                  ⚡ DEV
                </button>
              )}

              {/* Binding modes (e.g. resize) */}
              {bindingModes.map(mode => (
                <button
                  className="mode-badge resize"
                  key={mode.name}
                  onClick={() => g?.runCommand(`wm-disable-binding-mode --name ${mode.name}`)}
                  title="Press Escape or Enter to exit resize mode"
                >
                  󰩨 {mode.displayName ?? mode.name.toUpperCase()}
                </button>
              ))}

              {/* Workspaces */}
              <div className="workspaces">
                {workspaces.map(ws => (
                  <button
                    key={ws.name}
                    className={`ws-btn ${ws.hasFocus ? 'focused' : ''} ${ws.isDisplayed ? 'displayed' : ''}`}
                    onClick={() => g?.runCommand(`focus --workspace ${ws.name}`)}
                  >
                    {ws.displayName ?? ws.name}
                  </button>
                ))}
              </div>

              {/* Tiling direction toggle (workspace/WM control, lives with the others) */}
              {g && (
                <span
                  className="stat-item"
                  style={cursor_pointer}
                  onClick={() => g.runCommand('toggle-tiling-direction')}
                  title="Click to toggle tiling direction (horizontal / vertical)"
                >
                  {g.tilingDirection === 'horizontal' ? '󰤝 SPLIT-H' : '󰤼 SPLIT-V'}
                </span>
              )}
            </div>

            <div className="center">
              <span className={`window-title ${windowTitle ? '' : 'idle'}`} title={windowTitle ?? ''}>
                {windowTitle ?? 'IDLE'}
              </span>
            </div>

            <div className="right">
              {/* System: cpu, memory, disk */}
              <div className="group">
                <div className="group-row">
                  {output.cpu && (
                    <span className="stat-item cpu">
                      <i className="nf nf-oct-cpu"></i>
                      {Math.round(output.cpu.usage)}%
                      <svg className="sparkline" width="32" height="14" viewBox="0 0 32 14">
                        <polyline
                          fill="none"
                          stroke="currentColor"
                          strokeWidth="1.5"
                          points={cpuHistory
                            .map((v, i) => `${(i / Math.max(cpuHistory.length - 1, 1)) * 32},${14 - (v / 100) * 14}`)
                            .join(' ')}
                        />
                      </svg>
                    </span>
                  )}

                  {output.memory && (
                    <span className="stat-item memory">
                      <i className="nf nf-fae-chip"></i>
                      {Math.round(output.memory.usage)}%
                    </span>
                  )}

                  {primaryDisk && (
                    <span
                      className={`stat-item disk ${diskPercentFree < 15 ? 'low' : ''}`}
                      title={`${primaryDisk.mountPoint} — ${primaryDisk.availableSpace.iecValue.toFixed(0)}${primaryDisk.availableSpace.iecUnit} free of ${primaryDisk.totalSpace.iecValue.toFixed(0)}${primaryDisk.totalSpace.iecUnit}`}
                    >
                      <i className="nf nf-oct-database"></i>
                      {primaryDisk.availableSpace.iecValue.toFixed(0)}{primaryDisk.availableSpace.iecUnit} free
                    </span>
                  )}
                </div>
                <span className="group-label">SYSTEM</span>
              </div>

              <div className="divider"></div>

              {/* Network: ip, throughput */}
              <div className="group">
                <div className="group-row">
                  {output.ip && (
                    <span
                      className="stat-item ip"
                      title={`Approx. location: ${output.ip.approxCity}, ${output.ip.approxCountry}`}
                    >
                      <i className="nf nf-fa-globe"></i>
                      {output.ip.address}
                    </span>
                  )}

                  {traffic && (
                    <span
                      className="stat-item network"
                      title={output.network?.defaultInterface?.friendlyName ?? 'Network traffic'}
                    >
                      <i className="nf nf-fa-arrow_down"></i>
                      {formatDataRate(traffic.received)}
                      <i className="nf nf-fa-arrow_up"></i>
                      {formatDataRate(traffic.transmitted)}
                    </span>
                  )}
                </div>
                <span className="group-label">NETWORK</span>
              </div>

              <div className="divider"></div>

              {/* Utility: weather, volume, systray */}
              <div className="group">
                <div className="group-row">
                  {output.weather && (
                    <span
                      className="stat-item weather"
                      title={`Wind ${Math.round(output.weather.windSpeed)} mph`}
                    >
                      <i className={`nf ${WEATHER_ICONS[output.weather.status] ?? 'nf-weather-na'}`}></i>
                      {Math.round(output.weather.fahrenheitTemp)}°F
                    </span>
                  )}

                  {output.audio && (
                    <span
                      className="stat-item volume"
                      style={cursor_pointer}
                      onWheel={handleVolumeWheel}
                      onClick={toggleMute}
                      title="Scroll to change volume, click to mute/unmute"
                    >
                      <i className={`nf ${isMuted || volume === 0 ? 'nf-fa-volume_off' : 'nf-fa-volume_up'}`}></i>
                      {isMuted ? 'MUTED' : `${Math.round(volume)}%`}
                    </span>
                  )}

                  {output.systray && output.systray.icons.length > 0 && (
                    <span className="systray-menu">
                      {systrayOpen && (
                        <span className="systray">
                          {output.systray.icons.map(icon => (
                            <img
                              key={icon.id}
                              className="systray-icon"
                              src={icon.iconUrl}
                              title={icon.tooltip}
                              onClick={() => output.systray.onLeftClick(icon.id)}
                              onDoubleClick={() => output.systray.onLeftDoubleClick(icon.id)}
                              onContextMenu={(e) => { e.preventDefault(); output.systray.onRightClick(icon.id); }}
                            />
                          ))}
                        </span>
                      )}
                      <button
                        className="stat-item systray-toggle"
                        onClick={() => setSystrayOpen(!systrayOpen)}
                        title={systrayOpen ? 'Hide hidden icons' : 'Show hidden icons'}
                      >
                        <i className={`nf ${systrayOpen ? 'nf-md-chevron_down' : 'nf-md-chevron_up'}`}></i>
                        {output.systray.icons.length}
                      </button>
                    </span>
                  )}
                </div>
                <span className="group-label">UTILITY</span>
              </div>

              <div className="divider"></div>

              {output.date && (
                <div className="group">
                  <div className="group-row">
                    <span className="stat-item clock">
                      <i className="nf nf-fa-clock_o"></i>
                      {output.date.formatted}
                    </span>
                  </div>
                  <span className="group-label">TIME</span>
                </div>
              )}
            </div>
          </div>
        );
      }
    </script>
  </body>
</html>
ZBAR_HTML

