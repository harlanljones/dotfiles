mkdir -p "$startup_dir"

python3 - "$win_userprofile" "$win_localappdata" "$powershell_exe" <<'PY_EOF'
import subprocess
import sys

win_userprofile, win_appdata, powershell_exe = sys.argv[1:4]
targets = {
    "GlazeWM.lnk": (rf"{win_appdata}\Programs\glazewm\glazewm.exe", ""),
    "GlazeWM Super Key Mask.lnk": (
        rf"{win_appdata}\Programs\AutoHotkey\v2\AutoHotkey64.exe",
        rf'"{win_appdata}\Programs\glazewm\super-mask.ahk"',
    ),
    "Zebar.lnk": (rf"{win_appdata}\Programs\zebar\zebar.exe", ""),
    "FlowLauncher.lnk": (rf"{win_appdata}\FlowLauncher\Flow.Launcher.exe", ""),
    "QuickLook.lnk": (rf"{win_appdata}\Programs\QuickLook\QuickLook.exe", ""),
}

for name, (target, arguments) in targets.items():
    link_path = rf"{win_userprofile}\AppData\Roaming\Microsoft\Windows\Start Menu\Programs\Startup\{name}"
    ps = rf'''
    $ws = New-Object -ComObject WScript.Shell
    $s = $ws.CreateShortcut("{link_path}")
    $s.TargetPath = "{target}"
    $s.Arguments = '{arguments}'
    $s.WorkingDirectory = [System.IO.Path]::GetDirectoryName("{target}")
    $s.Save()
    '''
    subprocess.run([powershell_exe, "-NoProfile", "-Command", ps], check=True)
PY_EOF

# 11. Ensure desktop tools are running as detached Windows processes, then reload GlazeWM
if [[ -f "$autohotkey_exe" ]]; then
  ahk_win_exe="$(wslpath -w "$autohotkey_exe")"
  ahk_win_script="$(wslpath -w "$glazewm_dir/super-mask.ahk")"
  "$powershell_exe" -NoProfile -NonInteractive -Command "
    if (-not (Get-Process AutoHotkey64 -ErrorAction SilentlyContinue)) {
      Start-Process -FilePath '$ahk_win_exe' -ArgumentList '\"$ahk_win_script\"'
    }
  " < /dev/null
fi

"$powershell_exe" -NoProfile -Command '
  if (-not (Get-Process TranslucentTB -ErrorAction SilentlyContinue)) {
    $package = Get-AppxPackage -Name "*TranslucentTB*";
    if ($package) {
      Start-Process explorer.exe "shell:AppsFolder\$($package.PackageFamilyName)!TranslucentTB"
    }
  }' < /dev/null

if [[ -f "$glazewm_dir/cli/glazewm.exe" ]]; then
  "$glazewm_dir/cli/glazewm.exe" command wm-reload-config </dev/null 2>&1 || true
fi

glazewm_win_exe="$(wslpath -w "$glazewm_dir/glazewm.exe")"
"$powershell_exe" -NoProfile -NonInteractive -Command "
  if (-not (Get-Process glazewm -ErrorAction SilentlyContinue)) {
    Start-Process -FilePath '$glazewm_win_exe'
  }
" < /dev/null

if [[ -f "$zebar_dir/zebar.exe" ]]; then
  zebar_win_exe="$(wslpath -w "$zebar_dir/zebar.exe")"
  "$powershell_exe" -NoProfile -NonInteractive -Command "
    if (-not (Get-Process zebar -ErrorAction SilentlyContinue)) {
      Start-Process -FilePath '$zebar_win_exe'
    }
  " < /dev/null
fi

# 11. Hide desktop icons so the themed wallpaper is the whole desktop surface
# and apps are launched via Flow Launcher instead. There is no plain registry
# setting for this - "Show desktop icons" is a Progman WM_COMMAND toggle - so
# send the same message the context-menu item sends, but only when icons
# aren't already hidden (Windows persists the resulting state in HideIcons,
# so this read makes the toggle idempotent). FindWindow("Progman", ...) comes
# back empty when called from this WSL-interop-launched PowerShell process
# (tested directly - EnumWindows sees "Program Manager" with class "Progman"
# just fine, but FindWindow can't resolve it, seemingly a window-station quirk
# specific to how the interop spawns the process), so this walks EnumWindows
# and matches by title instead.
"$powershell_exe" -NoProfile -NonInteractive -Command '
  $hideIcons = (Get-ItemProperty -Path "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" -Name HideIcons -ErrorAction SilentlyContinue).HideIcons
  if ($hideIcons -ne 1) {
    Add-Type -Name Win32Toggle -Namespace DesktopIcons -MemberDefinition @"
      [DllImport("user32.dll")]
      public static extern bool EnumWindows(EnumWindowsProc lpEnumFunc, System.IntPtr lParam);
      [DllImport("user32.dll")]
      public static extern int GetWindowText(System.IntPtr hWnd, System.Text.StringBuilder lpString, int nMaxCount);
      [DllImport("user32.dll")]
      public static extern System.IntPtr SendMessage(System.IntPtr hWnd, uint Msg, System.IntPtr wParam, System.IntPtr lParam);
      public delegate bool EnumWindowsProc(System.IntPtr hWnd, System.IntPtr lParam);
"@
    $progman = [System.IntPtr]::Zero
    $callback = {
      param($hWnd, $lParam)
      $sb = New-Object System.Text.StringBuilder 256
      [DesktopIcons.Win32Toggle]::GetWindowText($hWnd, $sb, 256) | Out-Null
      if ($sb.ToString() -eq "Program Manager") {
        $script:progman = $hWnd
        return $false
      }
      return $true
    }
    [DesktopIcons.Win32Toggle]::EnumWindows($callback, [System.IntPtr]::Zero) | Out-Null
    if ($progman -ne [System.IntPtr]::Zero) {
      [DesktopIcons.Win32Toggle]::SendMessage($progman, 0x111, [System.IntPtr]0x7402, [System.IntPtr]::Zero) | Out-Null
      Write-Output "desktop-tools: hid desktop icons"
    } else {
      Write-Output "desktop-tools: could not find Program Manager window, skipping desktop icon hide"
    }
  } else {
    Write-Output "desktop-tools: desktop icons already hidden"
  }
' < /dev/null

echo "desktop-tools: GlazeWM, Zebar, Flow Launcher, QuickLook, TranslucentTB, Super-key mask configured successfully"
{{- end -}}
