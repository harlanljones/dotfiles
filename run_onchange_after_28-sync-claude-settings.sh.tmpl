#!/usr/bin/env bash
# Sync baseline settings into live Claude settings file (~/.claude/settings.json)
# while preserving runtime/dynamic fields (autoMode, push notifications, etc.).
# Idempotent: exits early when managed keys are already in sync.
#
# Two layers from .chezmoidata/claude_settings.yaml:
#   claudeSettings          enforced -- overrides the live value on every sync
#   claudeSettingsDefaults  seeds -- only fills keys the live file lacks, so a
#                           /model or /effort change made in Claude Code sticks
#
# chezmoi data hash: {{ .claudeSettings | toJson | sha256sum }}
# chezmoi defaults hash: {{ .claudeSettingsDefaults | toJson | sha256sum }}

set -euo pipefail

SETTINGS_FILE="${HOME}/.claude/settings.json"
# Intentional single quotes: these are literal JSON payloads for jq, and the
# Go template inside must NOT be expanded by the shell.
# shellcheck disable=SC2016
BASELINE='{{ .claudeSettings | toJson }}'
DEFAULTS='{{ .claudeSettingsDefaults | toJson }}'

mkdir -p "$(dirname "$SETTINGS_FILE")"

if [[ ! -f "$SETTINGS_FILE" ]]; then
  jq -s '.[0] * .[1]' <(printf '%s' "$DEFAULTS") <(printf '%s' "$BASELINE") > "$SETTINGS_FILE"
  chmod 600 "$SETTINGS_FILE"
  echo "created $SETTINGS_FILE from baseline"
  exit 0
fi

if ! jq -e . "$SETTINGS_FILE" >/dev/null 2>&1; then
  echo "error: $SETTINGS_FILE is not valid JSON; refusing to modify" >&2
  exit 1
fi

# defaults < live < baseline: seeds lose to anything already set, enforced keys
# win, and dynamic fields (autoMode, agentPushNotifEnabled, etc.) are preserved.
merged=$(jq -s '.[0] * .[1] * .[2]' <(printf '%s' "$DEFAULTS") "$SETTINGS_FILE" <(printf '%s' "$BASELINE"))

# Check if merged result is already what's on disk
if [[ "$(jq -S . "$SETTINGS_FILE")" == "$(printf '%s' "$merged" | jq -S .)" ]]; then
  exit 0
fi

cp "$SETTINGS_FILE" "$SETTINGS_FILE.bak-settings-sync"

tmp="$(mktemp)"
printf '%s\n' "$merged" | jq . > "$tmp"
mv "$tmp" "$SETTINGS_FILE"
chmod 600 "$SETTINGS_FILE"

echo "synced baseline settings into $SETTINGS_FILE (backup: $SETTINGS_FILE.bak-settings-sync)"
