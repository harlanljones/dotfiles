# SSH client configuration
#
# This file is managed by chezmoi (permissions 0600 via private_ prefix).
# Private keys are NOT stored here and are intentionally not managed by
# chezmoi -- provision those out-of-band on each machine.

Host *
    AddKeysToAgent yes
    # 1Password SSH agent first (keys stay in the vault, served via
    # ~/.config/1password/ssh/agent.toml); falls back to on-disk keys in
    # ~/.ssh when the socket is absent or has no matching key.
{{- if eq .chezmoi.os "darwin" }}
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- else }}
    IdentityAgent ~/.1password/agent.sock
{{- end }}

