#!/usr/bin/env bash
# Installs/restores declarative skill packs before the cross-harness sync.
# Managed by chezmoi and rerun when the pack manifest changes.
# manifest hash: {{ .agentSkills | toJson | sha256sum }}

set -euo pipefail

skill_home="${AGENT_SKILL_SYNC_HOME:-{{ .chezmoi.homeDir }}}"

if ! command -v npx >/dev/null 2>&1; then
  printf 'agent-skill-install: npx not found; skill packs were not restored\n' >&2
  exit 0
fi

# Each pack is (re)installed only if one of its listed skills is missing, so
# unrelated manifest changes do not re-clone every source repo. Missing skills
# are added with repeated --skill flags; '*' targets every harness.
{{- range $pack := .agentSkills.packs }}
missing_args=()
{{- range $s := $pack.skills }}
if [[ ! -f "$skill_home/.agents/skills/{{ $s }}/SKILL.md" ]]; then
  missing_args+=(--skill {{ $s | quote }})
fi
{{- end }}
if [[ ${#missing_args[@]} -gt 0 ]]; then
  npx -y skills add {{ $pack.repo | quote }} -g -a '*' -y "${missing_args[@]}" \
    || printf 'agent-skill-install: failed to install %s (non-fatal)\n' {{ $pack.repo | quote }} >&2
fi
{{- end }}

# Provider-generated builds (impeccable) are restored when missing.
missing_impeccable_providers=()
{{- range .agentSkills.impeccableProviders }}
if [[ ! -f "$skill_home/{{ .skillPath }}" ]]; then
  missing_impeccable_providers+=({{ .name | quote }})
fi
{{- end }}
if [[ ${#missing_impeccable_providers[@]} -gt 0 ]]; then
  provider_csv=$(IFS=,; printf '%s' "${missing_impeccable_providers[*]}")
  npx -y impeccable install --providers="$provider_csv" --scope=global -y --no-hooks
fi
