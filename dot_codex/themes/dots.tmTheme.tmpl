{{- /* Codex TUI "dots" theme, derived from the active `dots theme` palette
       via theme-palette.tmpl — same colors the other agent TUIs get. Codex
       reads $CODEX_HOME/themes/*.tmTheme; selected with [tui] theme = "dots"
       in the merged config (dot_codex/modify_private_config.toml). */ -}}
{{- $p := includeTemplate ".chezmoitemplates/theme-palette.tmpl" . | fromJson -}}
{{- $scopes := list
    (list "Comment" "comment, punctuation.definition.comment" $p.muted)
    (list "String" "string, constant.other.symbol" $p.green)
    (list "Number" "constant.numeric" $p.yellow)
    (list "Constant / Boolean" "constant.language, constant.other" $p.cyan)
    (list "Keyword" "keyword, keyword.control, storage, storage.type, storage.modifier" $p.magenta)
    (list "Function / Method" "entity.name.function, support.function, meta.function-call" $p.accent)
    (list "Type / Class" "entity.name.type, entity.name.class, support.type, support.class" $p.brightCyan)
    (list "Variable / Parameter" "variable, variable.parameter, variable.other" $p.fg)
    (list "Tag" "entity.name.tag, meta.tag" $p.brightBlue)
    (list "Attribute" "entity.other.attribute-name" $p.yellow)
    (list "Operator / Punctuation" "keyword.operator, punctuation" $p.muted)
    (list "Invalid" "invalid, invalid.illegal" $p.red)
    (list "Diff Added" "markup.inserted, diff.inserted" $p.brightGreen)
    (list "Diff Removed" "markup.deleted, diff.deleted" $p.brightRed)
}}<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>author</key>
	<string>dots theme (generated by chezmoi)</string>
	<key>colorSpaceName</key>
	<string>sRGB</string>
	<key>name</key>
	<string>dots</string>
	<key>semanticClass</key>
	<string>dots.theme.codex</string>
	<key>settings</key>
	<array>
		<dict>
			<key>settings</key>
			<dict>
				<key>background</key>
				<string>{{ $p.bg }}</string>
				<key>foreground</key>
				<string>{{ $p.fg }}</string>
				<key>caret</key>
				<string>{{ $p.cursor }}</string>
				<key>invisibles</key>
				<string>{{ $p.muted }}</string>
				<key>lineHighlight</key>
				<string>{{ $p.selection }}</string>
				<key>selection</key>
				<string>{{ $p.selection }}</string>
				<key>findHighlight</key>
				<string>{{ $p.yellow }}</string>
				<key>findHighlightForeground</key>
				<string>{{ $p.bg }}</string>
				<key>gutter</key>
				<string>{{ $p.bg }}</string>
				<key>gutterForeground</key>
				<string>{{ $p.muted }}</string>
			</dict>
		</dict>
{{- range $scope := $scopes }}
		<dict>
			<key>name</key>
			<string>{{ index $scope 0 }}</string>
			<key>scope</key>
			<string>{{ index $scope 1 }}</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>{{ index $scope 2 }}</string>
			</dict>
		</dict>
{{- end }}
	</array>
	<key>uuid</key>
	<string>7a1f6d5e-0000-4000-8000-d075c0de0001</string>
</dict>
</plist>
