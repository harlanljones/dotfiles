{
  "hooks": {
    "SessionStart": [
    {
        "hooks": [
            {
                "command": "bash '/home/harlan/.codex/herdr-agent-state.sh' session >/dev/null && printf '%s\\n' '{}'",
                "timeout": 10,
                "type": "command"
            }
        ]
    },
    {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
            {
                "type": "command",
                "command": "'/home/harlan/.local/bin/codebase-memory-mcp' hook-augment",
                "command_windows": "& '/home/harlan/.local/bin/codebase-memory-mcp' hook-augment",
                "timeout": 5
            }
        ]
    }
],
    "SubagentStart": [
    {
        "matcher": "*",
        "hooks": [
            {
                "type": "command",
                "command": "'/home/harlan/.local/bin/codebase-memory-mcp' hook-augment",
                "command_windows": "& '/home/harlan/.local/bin/codebase-memory-mcp' hook-augment",
                "timeout": 5
            }
        ]
    }
],
    "UserPromptSubmit": [
    {
        "matcher": "*",
        "hooks": [
            {
                "type": "command",
                "command": "herdr-agent-lifecycle codex working",
                "timeout": 5
            }
        ]
    }
],
    "PreToolUse": [
    {
        "matcher": "*",
        "hooks": [
            {
                "type": "command",
                "command": "herdr-agent-lifecycle codex working",
                "timeout": 5
            }
        ]
    }
],
    "PermissionRequest": [
    {
        "matcher": "*",
        "hooks": [
            {
                "type": "command",
                "command": "herdr-agent-lifecycle codex blocked",
                "timeout": 5
            }
        ]
    }
],
    "Stop": [
    {
        "matcher": "*",
        "hooks": [
            {
                "type": "command",
                "command": "herdr-agent-lifecycle codex idle",
                "timeout": 5
            }
        ]
    }
],
    "SessionEnd": [
    {
        "matcher": "*",
        "hooks": [
            {
                "type": "command",
                "command": "herdr-agent-lifecycle codex release",
                "timeout": 5
            }
        ]
    }
]
  }
}
