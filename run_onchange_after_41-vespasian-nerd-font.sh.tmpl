{{- /* hasKey: CI's shellcheck job renders scripts without a chezmoi config. */ -}}
{{- if and (hasKey . "machine") (eq .machine "vespasian") -}}
{{- $wt := (index .machines "vespasian").windowsTerminal -}}
#!/usr/bin/env bash
# Install JetBrainsMono Nerd Font for the current Windows user.
#
# Windows Terminal draws this box's glyphs, so the font has to exist on the
# Windows side. A per-user install (copy into %LOCALAPPDATA%\Microsoft\Windows\
# Fonts plus an HKCU registry entry) needs no administrator rights. Re-runs when
# the pinned release in .chezmoidata/machines.yaml changes: {{ $wt.nerdFontsVersion }}

set -euo pipefail

windows_tool="$HOME/.local/bin/wsl-windows-tool"
if [[ ! -x "$windows_tool" ]] || ! command -v wslpath >/dev/null 2>&1 || \
   ! cmd_exe="$($windows_tool path cmd)" || ! reg_exe="$($windows_tool path reg)"; then
  echo "nerd-font: not running under WSL, skipping"
  exit 0
fi

version="{{ $wt.nerdFontsVersion }}"
win_localappdata="$(cd /mnt/c && "$cmd_exe" /d /c 'echo %LOCALAPPDATA%' 2>/dev/null | tr -d '\r')"
win_fonts_dir="$win_localappdata\\Microsoft\\Windows\\Fonts"
fonts_dir="$(wslpath "$win_localappdata")/Microsoft/Windows/Fonts"
marker="$fonts_dir/.jetbrainsmono-nerd-font-$version"

if [[ -f "$marker" ]]; then
  echo "nerd-font: JetBrainsMono Nerd Font $version already installed"
else

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

echo "nerd-font: downloading JetBrainsMono Nerd Font $version"
curl -fsSL -o "$tmp/JetBrainsMono.zip" \
  "https://github.com/ryanoasis/nerd-fonts/releases/download/$version/JetBrainsMono.zip"
# Only the terminal family (not the Mono/Propo variants) is needed.
unzip -q -o "$tmp/JetBrainsMono.zip" 'JetBrainsMonoNerdFont-*.ttf' -d "$tmp/ttf"

mkdir -p "$fonts_dir"
count=0
for ttf in "$tmp"/ttf/*.ttf; do
  file="${ttf##*/}"
  cp -f "$ttf" "$fonts_dir/$file"
  "$reg_exe" add 'HKCU\Software\Microsoft\Windows NT\CurrentVersion\Fonts' \
    /v "${file%.ttf} (TrueType)" /t REG_SZ /d "$win_fonts_dir\\$file" /f >/dev/null
  count=$((count + 1))
done

# Also install into the WSL user's local font cache so Linux tools and fontconfig discover it
wsl_fonts_dir="$HOME/.local/share/fonts/JetBrainsMono"
mkdir -p "$wsl_fonts_dir"
cp -f "$tmp"/ttf/*.ttf "$wsl_fonts_dir/"
if command -v fc-cache >/dev/null 2>&1; then
  fc-cache -f "$HOME/.local/share/fonts"
fi

touch "$marker"

echo "nerd-font: installed $count faces into Windows and WSL font cache (restart Windows Terminal)"

fi

# Substitute the Nerd Font for Segoe UI system-wide (File Explorer, dialog
# boxes, title bars, most classic Win32 UI) via the FontSubstitutes registry
# key. This key lives under HKLM, so the write needs one UAC-elevated
# PowerShell prompt; read the current value first (HKLM is readable without
# elevation) so re-applying is a no-op and doesn't re-prompt every sync.
#
# Windows 11's Fluent surfaces (Settings, Start menu, some Store apps) render
# with "Segoe UI Variable" instead of "Segoe UI" and are NOT covered by this
# substitution. FontSubstitutes is read into a per-session win32k font-mapper
# cache, not re-read when an individual process (even explorer.exe) restarts
# - confirmed by testing: killing and relaunching explorer.exe left desktop
# icon labels on the old font. So this script does NOT restart explorer.exe
# (that would only add risk, since killing it also drops Zebar's dockToEdge
# work-area reservation with nothing to re-register it) - a full
# sign-out/sign-in is the only way to make every surface, including desktop
# icon labels, pick up the new font.
target_font="{{ $wt.fontFace }}"
current_sub="$("$reg_exe" query 'HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\FontSubstitutes' /v 'Segoe UI' 2>/dev/null | grep -oP 'REG_SZ\s+\K.*' | tr -d '\r' || true)"

if [[ "$current_sub" == "$target_font" ]]; then
  echo "nerd-font: system UI font substitution already set to '$target_font'"
else
  if ! powershell_exe="$($windows_tool path powershell)"; then
    echo "nerd-font: could not resolve powershell.exe, skipping system UI font substitution"
  else
    echo "nerd-font: elevating to set Segoe UI -> '$target_font' system-wide (approve the UAC prompt)"
    "$powershell_exe" -NoProfile -Command "
      \$psi = New-Object System.Diagnostics.ProcessStartInfo;
      \$psi.FileName = 'powershell.exe';
      \$psi.Verb = 'runas';
      \$psi.Arguments = '-NoProfile -Command \"' +
        'Set-ItemProperty -Path ''HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\FontSubstitutes'' -Name ''Segoe UI'' -Value ''$target_font'' -Type String' +
        '\"';
      \$psi.WindowStyle = 'Hidden';
      try {
        \$p = [System.Diagnostics.Process]::Start(\$psi);
        \$p.WaitForExit();
      } catch {
        Write-Output 'nerd-font: UAC prompt was declined or elevation failed, skipping';
      }
    " < /dev/null
    echo "nerd-font: system UI font substitution applied (sign out and back in for every app to pick it up)"
  fi
fi
{{- end -}}
