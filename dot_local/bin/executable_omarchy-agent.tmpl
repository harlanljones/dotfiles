{{- if and (hasKey .chezmoi.osRelease "id") (eq .chezmoi.osRelease.id "omarchy") -}}
#!/bin/bash

# omarchy:summary=Launch the default coding agent in a terminal
# omarchy:args=[--inline] [--pick]
# omarchy:examples=omarchy agent | omarchy agent --inline

inline=false
pick=false
prompt=""

while (($#)); do
  case "$1" in
    --inline)
      inline=true
      shift
      ;;
    --pick)
      pick=true
      shift
      ;;
    --prompt)
      prompt=${2:?--prompt needs a value}
      shift 2
      ;;
    *)
      echo "Unexpected argument: $1" >&2
      echo "To pass a prompt: omarchy agent prompt \"$*\"" >&2
      exit 1
      ;;
  esac
done

if [[ $PWD == "$HOME" && -d $HOME/Work ]]; then
  cd "$HOME/Work" || exit 1
fi

agent=$(omarchy-default-agent 2>/dev/null || cat "$HOME/.config/omarchy/defaults/agent" 2>/dev/null || true)

if [[ -z $agent && $pick == "true" ]]; then
  exec omarchy-menu summon setup.default.agent
fi

if [[ "$agent" == "agy" || "$agent" == "antigravity" ]]; then
  if omarchy-cmd-missing agy; then
    echo "agy is not installed or not on PATH." >&2
    exit 1
  fi

  command=(agy)
  if [[ -n ${prompt:-} ]]; then
    command+=(--prompt-interactive "$prompt")
  fi

  if [[ $inline == "true" ]]; then
    exec "${command[@]}"
  else
    exec omarchy-launch-tui --app-id=org.omarchy.agent "${command[@]}"
  fi
fi

if [[ "$agent" == "cursor" ]]; then
  if omarchy-cmd-missing cursor-agent; then
    echo "cursor-agent is not installed or not on PATH." >&2
    exit 1
  fi

  command=(cursor-agent --yolo)
  [[ -n ${prompt:-} ]] && command+=("$prompt")

  if [[ $inline == "true" ]]; then
    exec "${command[@]}"
  else
    exec omarchy-launch-tui --app-id=org.omarchy.agent "${command[@]}"
  fi
fi

# Fallback to upstream system omarchy-agent for all other agents
args=()
[[ $inline == "true" ]] && args+=(--inline)
[[ $pick == "true" ]] && args+=(--pick)
[[ -n ${prompt:-} ]] && args+=(--prompt "$prompt")

exec /usr/bin/omarchy-agent "${args[@]}"
{{- end -}}
