#!/usr/bin/env bash
# backdrop-split — split the current Omarchy theme background across every
# connected monitor and assign one segment per display via the Backdrop
# plugin IPC, so a single artwork spans the whole monitor array.
#
# Invoked from:
#   - ~/.config/omarchy/hooks/theme-set.d/backdrop-split  (omarchy theme set)
#   - run_after_34-augustus-backdrop-split                (every dots sync)
#
# Geometry is computed from the live Hyprland monitor layout: the image is
# cover-fitted over the full logical desktop bounding box, rendered at the
# highest monitor scale, and each display gets its logical rect cropped out
# and resampled to its native resolution.
set -euo pipefail

for cmd in omarchy-shell omarchy hyprctl magick python3; do
	command -v "$cmd" >/dev/null 2>&1 || {
		echo "backdrop-split: missing '$cmd' — not an Omarchy+Backdrop machine, skipping" >&2
		exit 0
	}
done

# The Backdrop plugin must own the background target, or assignments would
# silently no-op.
if ! omarchy-shell background assignments >/dev/null 2>&1; then
	echo "backdrop-split: Backdrop IPC unavailable (plugin disabled or shell down), skipping" >&2
	exit 0
fi

# Resolve the current theme background file from its hash.
hash="$(omarchy theme bg current 2>/dev/null | tr -d '[:space:]' || true)"
if [[ -z "$hash" ]]; then
	echo "backdrop-split: no current background set, skipping" >&2
	exit 0
fi
src="$(find "$HOME/.config/omarchy/themes" -maxdepth 3 -type f -name "${hash}.*" 2>/dev/null | head -1)"
if [[ -z "$src" ]]; then
	echo "backdrop-split: no file for background hash $hash, skipping" >&2
	exit 0
fi

out_dir="$HOME/.config/omarchy/backdrop/segments"
mkdir -p "$out_dir"

# Optional framing, read from ~/.config/omarchy/backdrop/settings (KEY=VALUE):
#   ZOOM   >=1, how hard to zoom into the image before mapping (1 = cover-fit)
#   FOCUSX/FOCUSY  0..1, the image point kept at the zoom center
# A painting whose interesting content sits off-center needs zoom+focus so
# every monitor gets meaningful art instead of a near-black region.
zoom=1; focus_x=0.5; focus_y=0.5
settings="$HOME/.config/omarchy/backdrop/settings"
if [[ -r "$settings" ]]; then
	# shellcheck disable=SC1090
	source "$settings"
	zoom="${ZOOM:-1}"; focus_x="${FOCUSX:-0.5}"; focus_y="${FOCUSY:-0.5}"
fi

# Zoom into the image around the focal point before mapping: crop a
# (1/zoom)-sized window centered on FOCUSX/FOCUSY (clamped to the image).
pre="$src"
if awk -v z="$zoom" 'BEGIN{exit !(z > 1.001)}'; then
	read -r sw sh <<<"$(identify -format '%w %h' "$src")"
	cw=$(( sw / zoom )); ch=$(( sh / zoom ))
	cx=$(awk -v sw="$sw" -v cw="$cw" -v f="$focus_x" 'BEGIN{c=int(f*sw-cw/2); print c<0?0:(c>sw-cw?sw-cw:c)}')
	cy=$(awk -v sh="$sh" -v ch="$ch" -v f="$focus_y" 'BEGIN{c=int(f*sh-ch/2); print c<0?0:(c>sh-ch?sh-ch:c)}')
	pre="$out_dir/.pre-crop.png"
	magick "$src" -crop "${cw}x${ch}+${cx}+${cy}" +repage "$pre"
fi

# Plan the crops. Fields per monitor: name|cropX|cropY|cropW|cropH|nativeW|nativeH
plan="$(ZOOM="$zoom" FOCUSX="$focus_x" FOCUSY="$focus_y" python3 <<'PY'
import json, math, os, subprocess

zoom = float(os.environ.get("ZOOM", "1"))
fx = min(max(float(os.environ.get("FOCUSX", "0.5")), 0), 1)
fy = min(max(float(os.environ.get("FOCUSY", "0.5")), 0), 1)

mons = json.loads(subprocess.check_output(["hyprctl", "monitors", "-j"]))
mons = [m for m in mons if m.get("active", True) and not m.get("disabled", False)]
if not mons:
    sys.exit("no active monitors")

for m in mons:
    s = m["scale"]
    m["_lw"], m["_lh"] = m["width"] / s, m["height"] / s

min_x = min(m["x"] for m in mons)
min_y = min(m["y"] for m in mons)
max_x = max(m["x"] + m["_lw"] for m in mons)
max_y = max(m["y"] + m["_lh"] for m in mons)
density = max(m["scale"] for m in mons)

canvas_w = math.ceil((max_x - min_x) * density)
canvas_h = math.ceil((max_y - min_y) * density)

for m in mons:
    ox = round((m["x"] - min_x) * density)
    oy = round((m["y"] - min_y) * density)
    ow = round(m["_lw"] * density)
    oh = round(m["_lh"] * density)
    print(f"{m['name']}|{ox}|{oy}|{ow}|{oh}|{m['width']}|{m['height']}")

print(f"CANVAS|{canvas_w}|{canvas_h}")
PY
)"

canvas="$(grep '^CANVAS|' <<<"$plan" | cut -d'|' -f2,3 | tr '|' 'x')"
cw="${canvas%x*}" ch="${canvas#*x}"

# Idempotent: same background + same layout -> byte-identical outputs.
# Writes are atomic (tmp + mv): the shell may reload the QML plugin at any
# moment (e.g. during a concurrent `chezmoi apply`), and a half-written or
# missing segment file crashes the backdrop plugin and gets it auto-disabled.
status=0
while IFS='|' read -r name ox oy ow oh mw mh; do
	[[ "$name" == "CANVAS" ]] && continue
	seg="$out_dir/${name}.png"
	tmp="$(mktemp "$out_dir/.${name}.XXXXXX.png")"
	if ! magick "$pre" \
		-resize "${cw}x${ch}^" -gravity center -extent "${cw}x${ch}" \
		-crop "${ow}x${oh}+${ox}+${oy}" +repage \
		-resize "${mw}x${mh}!" \
		-strip \
		"$tmp"; then
		echo "backdrop-split: magick failed for $name" >&2
		rm -f "$tmp"
		status=1
		continue
	fi
	chmod 644 "$tmp"
	mv -f "$tmp" "$seg"
	# Deliberately without -q: -q fakes success when the IPC target is gone.
	if ! omarchy-shell background setForScreen "$name" "$seg"; then
		echo "backdrop-split: setForScreen $name failed" >&2
		status=1
	fi
done <<<"$plan"

exit "$status"
