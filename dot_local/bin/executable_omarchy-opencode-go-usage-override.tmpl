{{- if and (hasKey .chezmoi.osRelease "id") (eq .chezmoi.osRelease.id "omarchy") -}}
#!/usr/bin/python3
# omarchy:summary=Record real OpenCode Go limits read off the workspace dashboard
# omarchy:args=--rolling PCT [--rolling-resets DURATION] --weekly PCT [...] --monthly PCT [...]
# omarchy:hidden=true
"""Persist OpenCode Go limits read off https://opencode.ai/workspace/<id>/go.

OpenCode exposes no quota endpoint, so `omarchy-agent-usage-opencode` can
only report raw token totals per provider, plus whatever ceilings you type
into OPENCODE_USAGE_LIMITS by hand. The Go plan's real Rolling/Weekly/Monthly
meters live only in the workspace UI.

This is the write side of that gap. `omarchy-opencode-go-usage-scrape` reads
the three windows off the page and calls this; the /opencode-go-usage skill
calls it when a human read them instead. Either way the numbers land in
~/.config/omarchy/agents/opencode-go-dashboard.json, where the collector
prefers them over configured quotas for the next 24 hours (see
DASHBOARD_OVERRIDE_MAX_AGE there).

Percentages are 0-100 — the page renders `usagePercent` directly. Reset
countdowns are durations like "30d22h", "3h52m", or "45m"; the page carries
them as `resetInSec`, so the scraper converts and this parses back.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
import tempfile
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any

DASHBOARD_URL = "https://opencode.ai/workspace/wrk_01M0JWEHT6TBW13JZBZQVW1XVB/go"
PROVIDER = "opencode-go"

DURATION_RE = re.compile(
  r"^\s*(?:(?P<days>\d+)d)?\s*(?:(?P<hours>\d+)h)?\s*(?:(?P<minutes>\d+)m)?\s*$"
)


def parse_duration(text: str) -> timedelta:
  match = DURATION_RE.match(text)
  if not match or not any(match.groups()):
    raise argparse.ArgumentTypeError(
      f"{text!r} is not a duration like '30d22h', '3h52m', or '45m'"
    )
  parts = {key: int(value) for key, value in match.groupdict(default="0").items()}
  return timedelta(days=parts["days"], hours=parts["hours"], minutes=parts["minutes"])


def parse_percent(text: str) -> float:
  value = float(text)
  if not 0 <= value <= 100:
    raise argparse.ArgumentTypeError(f"{text!r} is not a percentage between 0 and 100")
  return value / 100.0


def agents_config_dir() -> Path:
  root = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
  folder = root / "omarchy" / "agents"
  folder.mkdir(parents=True, exist_ok=True)
  return folder


def write_json(path: Path, payload: dict) -> None:
  handle_fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
  tmp = Path(tmp_name)
  try:
    with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
      handle.write(json.dumps(payload, indent=2) + "\n")
    tmp.chmod(0o644)
    tmp.replace(path)
  except BaseException:
    tmp.unlink(missing_ok=True)
    raise


def build_limit(label: str, percent: float, resets_in: timedelta | None) -> dict[str, Any]:
  now = datetime.now().astimezone()
  return {
    "label": label,
    # The panel shows several providers' limits side by side, so the title
    # carries the plan the way quota_limits() does for configured ceilings.
    "title": f"Go {label}",
    "percent": round(percent, 4),
    "resetsAt": (now + resets_in).isoformat() if resets_in is not None else "",
  }


def main() -> int:
  parser = argparse.ArgumentParser(description=__doc__)
  parser.add_argument("--rolling", type=parse_percent, required=True, help="Rolling window, 0-100")
  parser.add_argument("--rolling-resets", type=parse_duration, default=None)
  parser.add_argument("--weekly", type=parse_percent, required=True, help="Weekly window, 0-100")
  parser.add_argument("--weekly-resets", type=parse_duration, default=None)
  parser.add_argument("--monthly", type=parse_percent, required=True, help="Monthly window, 0-100")
  parser.add_argument("--monthly-resets", type=parse_duration, default=None)
  parser.add_argument("--source", default=DASHBOARD_URL, help="page the numbers came from")
  parser.add_argument("--no-refresh", action="store_true", help="skip the immediate omarchy-agent-usage-update run")
  args = parser.parse_args()

  payload = {
    "capturedAt": datetime.now(timezone.utc).isoformat(),
    "source": args.source,
    "provider": PROVIDER,
    "limits": [
      build_limit("Rolling", args.rolling, args.rolling_resets),
      build_limit("Weekly", args.weekly, args.weekly_resets),
      build_limit("Monthly", args.monthly, args.monthly_resets),
    ],
  }
  write_json(agents_config_dir() / "opencode-go-dashboard.json", payload)

  if not args.no_refresh:
    os.system("omarchy-agent-usage-update >/dev/null 2>&1 || true")

  print(json.dumps(payload, indent=2))
  return 0


if __name__ == "__main__":
  sys.exit(main())
{{- end -}}
