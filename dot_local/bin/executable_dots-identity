#!/usr/bin/env bash
# dots-identity - Render the per-machine identity banner (phase 7.12).
#
# Single source of truth for machine-identity art/info consumed by later
# tasks (snacks.nvim dashboard, terminal splash, btop header, plymouth).
# Wordmark + role line + theme-colored chips (kernel, uptime, memory, drift).
#
# In a git project: renders a compact, high-density 4-line developer HUD.
# Outside a project (e.g. $HOME on terminal launch): renders a rich command center
# with responsive wordmark (Roman FIGlet on tall displays, 3-row mini-font on
# standard/split windows), system telemetry, recent workspaces, cloud workflow status,
# and quick actions — engineered to strictly fit within standard window bounds
# without vertical scrolling or line wrapping.
#
# Degrades gracefully: non-tty or NO_COLOR -> plain uncolored output / clean header.

set -euo pipefail

for _p in "$HOME/.local/share/mise/shims" "$HOME/.local/bin" "$HOME/.cache/.bun/bin"; do
  case ":${PATH}:" in
    *":$_p:"*) ;;
    *) PATH="$_p:$PATH" ;;
  esac
done
export PATH

# ------------------------------------------------------------- color setup ---
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  COLOR_ON=1
  DIM=$'\033[2m'
  BOLD=$'\033[1m'
  CYAN=$'\033[36m'
  GREEN=$'\033[32m'
  YELLOW=$'\033[33m'
  NC=$'\033[0m'
else
  COLOR_ON=0
  DIM='' BOLD='' CYAN='' GREEN='' YELLOW='' NC=''
fi

# Map a starship-style style string (machines.<machine>.theme.accent, e.g.
# "bold dimmed cyan") to an SGR prefix. Unknown tokens are ignored.
style_to_ansi() {
  local sgr="" token code
  for token in $1; do
    case "$token" in
      bold) code='1' ;;
      dim|dimmed) code='2' ;;
      italic) code='3' ;;
      underline) code='4' ;;
      black) code='30' ;;
      red) code='31' ;;
      green) code='32' ;;
      yellow) code='33' ;;
      blue) code='34' ;;
      purple|magenta) code='35' ;;
      cyan) code='36' ;;
      white) code='37' ;;
      *) code='' ;;
    esac
    [[ -n "$code" ]] && sgr+="${sgr:+;}$code"
  done
  if [[ -n "$sgr" && "$COLOR_ON" == 1 ]]; then
    printf '\033[%sm' "$sgr"
  fi
}

# ------------------------------------------------------- identity data fetch ---
if ! command -v chezmoi >/dev/null 2>&1; then
  echo "dots-identity: chezmoi is not installed or not in PATH." >&2
  exit 1
fi

# machine|displayName|accent|role|chips (space separated) — one round trip.
# shellcheck disable=SC2016  # single quotes intentional: chezmoi template
info=$(chezmoi execute-template \
  '{{ $m := index .machines .machine | default dict -}}
{{ .machine }}|{{ index $m "displayName" | default "" }}|{{ index (index $m "theme" | default dict) "accent" | default "" }}|{{ index $m "role" | default "" }}|{{ range $c := (index (index $m "identity" | default dict) "chips" | default (list)) }}{{ $c }}|{{ end }}' 2>/dev/null) || {
  echo "dots-identity: could not resolve machine identity via chezmoi." >&2
  exit 1
}
machine=${info%%|*}
rest=${info#*|}
displayName=${rest%%|*}
rest=${rest#*|}
accent=${rest%%|*}
rest=${rest#*|}
role=${rest%%|*}
chips_raw=${rest#*|}

# ------------------------------------------------------- wordmark art ---
_mini_font() {
  local ch=$1
  case "$ch" in
    A) printf '%s\n%s\n%s' '▄▀▀▄' '█▄▄█' '▀  ▀' ;;
    B) printf '%s\n%s\n%s' '█▀▀▄' '█▄▄▀' '▀▄▄▀' ;;
    C) printf '%s\n%s\n%s' '▄▀▀▀' '█   ' '▀▄▄▀' ;;
    D) printf '%s\n%s\n%s' '█▀▀▄' '█  █' '▀▄▄▀' ;;
    E) printf '%s\n%s\n%s' '████' '█▄▄ ' '▀▀▀▀' ;;
    F) printf '%s\n%s\n%s' '████' '█▄▄ ' '▀   ' ;;
    G) printf '%s\n%s\n%s' '▄▀▀▄' '█ ▄█' '▀▄▄▀' ;;
    H) printf '%s\n%s\n%s' '█  █' '████' '▀  ▀' ;;
    I) printf '%s\n%s\n%s' '▄' '█' '▀' ;;
    J) printf '%s\n%s\n%s' '  ▄█' '   █' '▀▄▄ ' ;;
    K) printf '%s\n%s\n%s' '█  █' '█▄█ ' '▀ ▀ ' ;;
    L) printf '%s\n%s\n%s' '█   ' '█   ' '▀▀▀▀' ;;
    M) printf '%s\n%s\n%s' '█▄ ▄█' '█ ▀ █' '▀   ▀' ;;
    N) printf '%s\n%s\n%s' '█▄ ▄█' '█ ▄ █' '▀   ▀' ;;
    O) printf '%s\n%s\n%s' '▄▀▀▄' '█  █' '▀▄▄▀' ;;
    P) printf '%s\n%s\n%s' '█▀▀▄' '█▄▄█' '▀   ' ;;
    Q) printf '%s\n%s\n%s' '▄▀▀▄' '█ ▄█' '▀▄▄▀' ;;
    R) printf '%s\n%s\n%s' '█▀▀▄' '█▄▄▀' '▀  ▀' ;;
    S) printf '%s\n%s\n%s' '▄▀▀▀' '▀▀▀█' '▄▄▄▀' ;;
    T) printf '%s\n%s\n%s' '████' '  █ ' '  ▀ ' ;;
    U) printf '%s\n%s\n%s' '█  █' '█  █' '▀▄▄▀' ;;
    V) printf '%s\n%s\n%s' '█  █' '█  █' ' ▀▀ ' ;;
    W) printf '%s\n%s\n%s' '█   █' '█ ▄ █' '▀▄▄▄▀' ;;
    X) printf '%s\n%s\n%s' '█  █' ' ▄▄ ' '▀  ▀' ;;
    Y) printf '%s\n%s\n%s' '█  █' ' ▄█ ' '  ▀ ' ;;
    Z) printf '%s\n%s\n%s' '▄▄▄█' ' ▄▀ ' '▀▄▄▄' ;;
    ' ') printf '%s\n%s\n%s' '   ' '   ' '   ' ;;
    *) printf '%s\n%s\n%s' '    ' ' █  ' '    ' ;;
  esac
}

render_wordmark() {
  local name=$1 target_lines=${2:-27} target_cols=${3:-95} wordmark
  # Use Roman FIGlet when height >= 30 AND width >= 92 to avoid vertical overflow or wrapping
  if (( target_lines >= 30 && target_cols >= 92 )) && command -v figlet >/dev/null 2>&1; then
    wordmark=$(figlet -w 200 -f "$HOME/.local/share/figlet/Roman.flf" "$name" 2>/dev/null) || true
  fi
  if [[ -n "${wordmark:-}" ]]; then
    printf '%s\n' "$wordmark"
    return
  fi
  local upper row1='' row2='' row3='' ch art
  upper=$(printf '%s' "$name" | tr '[:lower:]' '[:upper:]')
  for ch in $(printf '%s' "$upper" | fold -w1); do
    art=$(_mini_font "$ch")
    row1+="$(printf '%s' "$art" | sed -n 1p) "
    row2+="$(printf '%s' "$art" | sed -n 2p) "
    row3+="$(printf '%s' "$art" | sed -n 3p) "
  done
  printf '%s\n%s\n%s\n' "$row1" "$row2" "$row3"
}

# ------------------------------------------------------------ live hardware ---
kernel=$(uname -r 2>/dev/null || echo 'unknown')

uptime_s=''
if [[ -r /proc/uptime ]]; then
  read -r up_secs _ < /proc/uptime
  up_secs=${up_secs%%.*}
  if (( up_secs >= 86400 )); then
    printf -v uptime_s '%dd %dh' $(( up_secs / 86400 )) $(( (up_secs % 86400) / 3600 ))
  elif (( up_secs >= 3600 )); then
    printf -v uptime_s '%dh %dm' $(( up_secs / 3600 )) $(( (up_secs % 3600) / 60 ))
  else
    uptime_s=$(( up_secs / 60 ))m
  fi
fi

mem_s=''
mem_used_g=0
mem_total_g=0
mem_pct=0
if [[ -r /proc/meminfo ]]; then
  read -r _ mem_total _ < <(grep '^MemTotal:' /proc/meminfo) || mem_total=''
  read -r _ mem_avail _ < <(grep '^MemAvailable:' /proc/meminfo) || mem_avail=''
  if [[ -n "${mem_total:-}" && -n "${mem_avail:-}" && "$mem_total" -gt 0 ]]; then
    mem_used_g=$(( (mem_total - mem_avail) / 1048576 ))
    mem_total_g=$(( mem_total / 1048576 ))
    mem_pct=$(( (mem_total - mem_avail) * 100 / mem_total ))
    mem_s="${mem_used_g}G/${mem_total_g}G"
  fi
fi

drift_s='n/a'
drift_n=0
if command -v timeout >/dev/null 2>&1 && command -v dots >/dev/null 2>&1; then
  drift_n=$(timeout 1 dots status 2>/dev/null |
    grep -cE '^[[:space:]]*[MADRU?]{1,2}[[:space:]]|^[[:space:]]*(modified|added|removed|deleted|renamed):' || true)
  drift_s=${drift_n:-n/a}
elif command -v timeout >/dev/null 2>&1 && timeout 1 chezmoi status >/dev/null 2>&1; then
  drift_n=$(timeout 1 chezmoi status 2>/dev/null | grep -cE '^[MADRU?]' || true)
  drift_s=${drift_n:-n/a}
fi

accent_ansi=$(style_to_ansi "$accent")

# ------------------------------------------------------------- Consumers Mode ---
# If NO_COLOR is set, or caller explicitly asked for --header/--wordmark (e.g. nvim dashboard):
# output clean wordmark + role + hardware stats.
if [[ -n "${NO_COLOR:-}" || "${1:-}" == "--header" || "${1:-}" == "--wordmark" ]]; then
  printf '%s%s%s\n' "$accent_ansi" "$(render_wordmark "$displayName" 40 120)" "$NC"
  chips_s=$(printf '%s' "$chips_raw" | sed 's/|$//;s/|/, /g')
  printf '%s%s%s' "$DIM" "$machine" "$NC"
  [[ -n "$role" ]] && printf '  %s%s%s' "$accent_ansi" "$role" "$NC"
  [[ -n "$chips_s" ]] && printf '  %s[%s]%s\n' "$DIM" "$chips_s" "$NC"
  printf '  %ssys%s   󰌢 %s   󰅐 up %s   󰍛 %s   󰈸 drift: %s\n' \
    "$DIM" "$NC" "$kernel" "${uptime_s:-n/a}" "${mem_s:-n/a}" "$drift_s"
  exit 0
fi

# Check if inside a git work tree
in_git=0
t=''
command -v timeout >/dev/null 2>&1 && t='timeout 1'
if command -v git >/dev/null 2>&1 && $t git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  in_git=1
fi

if [[ "$in_git" -eq 1 && "${1:-}" != "--full" ]]; then
  # ================================================= Adaptive Git Project HUD ===
  primary_chip="${chips_raw%%|*}"
  top_left="[${machine}${primary_chip:+ · ${primary_chip}}]"
  top_stats="󰌢 ${kernel%%-*} ── 󰅐 ${uptime_s:-n/a} ── 󰍛 ${mem_s:-n/a} ── 󰈸 drift: ${drift_s}"
  printf '%s%s%s %s── %s%s %s────────────────────────────────────────%s\n' \
    "$accent_ansi" "$top_left" "$NC" "$DIM" "$top_stats" "$NC" "$DIM" "$NC"

  # Git repo and branch
  reponame=$(basename "$($t git rev-parse --show-toplevel 2>/dev/null || pwd)")
  branch=$($t git symbolic-ref --short HEAD 2>/dev/null || $t git rev-parse --short HEAD 2>/dev/null || echo detached)
  dirty=$($t git status --porcelain 2>/dev/null | wc -l || echo 0)
  nfiles=$($t git ls-files 2>/dev/null | wc -l || echo 0)

  sync_s="[clean]"
  tracking=$($t git rev-parse --abbrev-ref --symbolic-full-name "@{u}" 2>/dev/null || true)
  if [[ -n "$tracking" ]]; then
    ahead=$($t git rev-list --count "@{u}..HEAD" 2>/dev/null || echo 0)
    behind=$($t git rev-list --count "HEAD..@{u}" 2>/dev/null || echo 0)
    if (( ahead > 0 && behind > 0 )); then
      sync_s="⇡${ahead} ⇣${behind}"
    elif (( ahead > 0 )); then
      sync_s="⇡${ahead} ahead"
    elif (( behind > 0 )); then
      sync_s="⇣${behind} behind"
    else
      sync_s="synced"
    fi
  fi

  repo_line=" ${reponame} :  ${branch}"
  if [[ "$dirty" =~ ^[0-9]+$ && "$dirty" -gt 0 ]]; then
    if [[ "$COLOR_ON" == 1 ]]; then
      repo_line+=" \033[33m(+${dirty})\033[0m"
    else
      repo_line+=" (+${dirty})"
    fi
  else
    if [[ "$COLOR_ON" == 1 ]]; then
      repo_line+=" \033[32m[clean]\033[0m"
    else
      repo_line+=" [clean]"
    fi
  fi
  repo_line+=" · ${DIM}${sync_s}${NC} · ${DIM}${nfiles} files${NC}"
  printf '  %srepo%s  %b\n' "$DIM" "$NC" "$repo_line"

  # Top languages and percentages
  lang_data=$($t git ls-files 2>/dev/null | awk -F. '
    NF > 1 {
      ext = tolower($NF)
      if (ext ~ /^(png|jpg|jpeg|gif|ico|svg|lock|lockb|txt|map|sample|woff|woff2|ttf|eot)$/) next;
      name = "Other"; color = "37"; icon = "󰈚";
      if (ext ~ /^(ts|tsx)$/) { name = "TypeScript"; color = "34"; icon = "󰛦"; }
      else if (ext ~ /^(js|jsx|mjs|cjs)$/) { name = "JavaScript"; color = "33"; icon = "󰌞"; }
      else if (ext ~ /^(rs)$/) { name = "Rust"; color = "31"; icon = "󱘗"; }
      else if (ext ~ /^(py)$/) { name = "Python"; color = "33"; icon = ""; }
      else if (ext ~ /^(go)$/) { name = "Go"; color = "36"; icon = ""; }
      else if (ext ~ /^(lua)$/) { name = "Lua"; color = "35"; icon = "󰡯"; }
      else if (ext ~ /^(sh|bash|zsh)$/) { name = "Shell"; color = "32"; icon = ""; }
      else if (ext ~ /^(rb)$/) { name = "Ruby"; color = "31"; icon = ""; }
      else if (ext ~ /^(tmpl)$/) { name = "Template"; color = "35"; icon = ""; }
      else if (ext ~ /^(json|jsonc)$/) { name = "JSON"; color = "33"; icon = "󰅩"; }
      else if (ext ~ /^(yaml|yml)$/) { name = "YAML"; color = "35"; icon = "󰅩"; }
      else if (ext ~ /^(toml)$/) { name = "TOML"; color = "31"; icon = "󰅩"; }
      else if (ext ~ /^(md|markdown)$/) { name = "Markdown"; color = "37"; icon = ""; }
      else if (ext ~ /^(html)$/) { name = "HTML"; color = "31"; icon = ""; }
      else if (ext ~ /^(css|scss)$/) { name = "CSS"; color = "34"; icon = ""; }
      counts[name]++
      colors[name] = color
      icons[name] = icon
      total++
    }
    END {
      if (total == 0) exit
      for (n in counts) {
        pct = (counts[n] / total) * 100
        printf "%s|%d|%.0f|%s|%s\n", n, counts[n], pct, colors[n], icons[n]
      }
    }' | sort -t'|' -k2 -rn)

  if [[ -n "$lang_data" ]]; then
    lang_line=""
    bar=""
    total_width=16
    filled=0
    l_idx=0

    while IFS='|' read -r lname _ lpct lcolor licon; do
      [[ -z "$lname" ]] && continue
      l_idx=$(( l_idx + 1 ))
      if (( l_idx <= 3 )); then
        if [[ "$COLOR_ON" == 1 ]]; then
          lang_line+="\033[${lcolor}m${licon} ${lname} ${lpct}%\033[0m   "
        else
          lang_line+="${licon} ${lname} ${lpct}%   "
        fi
      fi

      c_blocks=$(( (lpct * total_width + 50) / 100 ))
      if (( c_blocks == 0 && lpct > 0 )); then c_blocks=1; fi
      if (( filled + c_blocks > total_width )); then
        c_blocks=$(( total_width - filled ))
      fi
      if (( c_blocks > 0 )); then
        printf -v b_str '%*s' "$c_blocks" ''
        b_str="${b_str// /█}"
        if [[ "$COLOR_ON" == 1 ]]; then
          bar+="\033[${lcolor}m${b_str}"
        else
          bar+="${b_str}"
        fi
        filled=$(( filled + c_blocks ))
      fi
    done <<< "$lang_data"

    if (( filled < total_width )); then
      rem=$(( total_width - filled ))
      printf -v r_str '%*s' "$rem" ''
      r_str="${r_str// /░}"
      if [[ "$COLOR_ON" == 1 ]]; then
        bar+="${DIM}${r_str}${NC}"
      else
        bar+="${r_str}"
      fi
    fi
    [[ "$COLOR_ON" == 1 ]] && bar+="${NC}"

    printf '  %slang%s  %b[%b]\n' "$DIM" "$NC" "$lang_line" "$bar"
  fi

  # Stack & Frameworks
  stk_parts=()
  [[ -f bun.lock || -f bun.lockb ]] && stk_parts+=(" Bun")
  [[ -f pnpm-lock.yaml ]] && stk_parts+=("󰒓 pnpm")
  [[ -f yarn.lock ]] && stk_parts+=("󰎙 yarn")
  [[ -f package-lock.json && ${#stk_parts[@]} -eq 0 ]] && stk_parts+=(" npm")
  [[ -f uv.lock ]] && stk_parts+=(" uv")
  [[ -f poetry.lock ]] && stk_parts+=(" Poetry")
  [[ -f Cargo.lock ]] && stk_parts+=("󱘗 Cargo")
  [[ -f go.sum ]] && stk_parts+=(" Go")

  if [[ -f package.json ]]; then
    grep -qi '"next"' package.json 2>/dev/null && stk_parts+=("▲ Next.js")
    grep -qi '"hono"' package.json 2>/dev/null && stk_parts+=("󱘗 Hono")
    grep -qi '"react"' package.json 2>/dev/null && stk_parts+=("󰎙 React")
    grep -qi '"vue"' package.json 2>/dev/null && stk_parts+=("󰡄 Vue")
    grep -qi '"svelte"' package.json 2>/dev/null && stk_parts+=("󰄛 Svelte")
    grep -qi '"astro"' package.json 2>/dev/null && stk_parts+=("󰄛 Astro")
    grep -qi '"express"' package.json 2>/dev/null && stk_parts+=("󰌞 Express")
    grep -qi '"fastify"' package.json 2>/dev/null && stk_parts+=("󱐋 Fastify")
    grep -qiE 'tailwind' package.json 2>/dev/null && stk_parts+=("󱏿 Tailwind")
    grep -qiE 'vite' package.json 2>/dev/null && stk_parts+=(" Vite")
    grep -qiE 'wrangler|workers' package.json 2>/dev/null && stk_parts+=("󰔡 Cloudflare")
  fi
  if [[ -f pyproject.toml ]]; then
    grep -qiE 'fastapi' pyproject.toml 2>/dev/null && stk_parts+=("󱏚 FastAPI")
    grep -qiE 'django' pyproject.toml 2>/dev/null && stk_parts+=("󰡄 Django")
    grep -qiE 'flask' pyproject.toml 2>/dev/null && stk_parts+=("󰡄 Flask")
    grep -qiE 'gradio' pyproject.toml 2>/dev/null && stk_parts+=("󰓹 Gradio")
    grep -qiE 'duckdb' pyproject.toml 2>/dev/null && stk_parts+=("󱏚 DuckDB")
    grep -qiE 'torch' pyproject.toml 2>/dev/null && stk_parts+=("󱏚 PyTorch")
    grep -qiE 'anthropic|openai' pyproject.toml 2>/dev/null && stk_parts+=("󱚝 AI SDK")
  fi
  if [[ -f Cargo.toml ]]; then
    grep -qiE '^tokio' Cargo.toml 2>/dev/null && stk_parts+=("󱘗 Tokio")
    grep -qiE '^axum' Cargo.toml 2>/dev/null && stk_parts+=("󱘗 Axum")
    grep -qiE '^actix' Cargo.toml 2>/dev/null && stk_parts+=("󱘗 Actix")
    grep -qiE '^bevy' Cargo.toml 2>/dev/null && stk_parts+=("󰊖 Bevy")
    grep -qiE '^tauri' Cargo.toml 2>/dev/null && stk_parts+=("󱘗 Tauri")
  fi
  if [[ -f go.mod ]]; then
    grep -qiE 'gin-gonic' go.mod 2>/dev/null && stk_parts+=(" Gin")
    grep -qiE 'echo' go.mod 2>/dev/null && stk_parts+=(" Echo")
    grep -qiE 'fiber' go.mod 2>/dev/null && stk_parts+=(" Fiber")
  fi
  [[ -f Dockerfile || -f compose.yaml || -f docker-compose.yml ]] && stk_parts+=("󰔡 Docker")

  if (( ${#stk_parts[@]} > 0 )); then
    joined=""
    for item in "${stk_parts[@]}"; do
      [[ -n "$joined" ]] && joined+=" · "
      joined+="$item"
    done
    printf '  %sstk%s   %s\n' "$DIM" "$NC" "$joined"
  fi

else
  # ============================================ Rich Home Command Center HUD ===
  # Window bounds detection
  cols=${COLUMNS:-}
  if [[ -z "$cols" ]] && command -v tput >/dev/null 2>&1; then
    cols=$(tput cols 2>/dev/null || echo "")
  fi
  cols=${cols:-95}

  lines=${LINES:-}
  if [[ -z "$lines" ]] && command -v tput >/dev/null 2>&1; then
    lines=$(tput lines 2>/dev/null || echo "")
  fi
  lines=${lines:-27}

  strip_ansi() {
    local esc=$'\033'
    printf "%s" "$1" | sed "s/${esc}\[[0-9;]*[a-zA-Z]//g"
  }

  # trunc_visible <text> <max>: cut to max visible chars, passing ANSI
  # escape sequences through untouched (they are zero-width). Callers append
  # "…" when truncation occurred. Byte-safe under UTF-8 locales: bash
  # substrings split on characters, and every card glyph is 1 cell wide.
  trunc_visible() {
    local text=$1 max=$2 out="" vis=0 i=0 esc=$'\033'
    local n=${#text}
    while (( i < n )); do
      local ch=${text:i:1}
      if [[ $ch == "$esc" ]]; then
        local j=$i
        while (( j < n )); do
          out+="${text:j:1}"
          (( j++ ))
          [[ ${text:j-1:1} == [a-zA-Z] ]] && break
        done
        i=$j
      else
        (( vis >= max )) && break
        out+="$ch"
        (( vis++, i++ ))
      fi
    done
    printf '%s' "$out"
  }

  target_w=40

  card_top() {
    local icon="$1" title="$2"
    local t_str="$icon $title "
    local clean
    clean=$(strip_ansi "$t_str")
    local vlen=${#clean}
    local dashes=$(( target_w - vlen ))
    local d_str=""
    printf -v d_str '%*s' "$dashes" ''
    d_str="${d_str// /─}"
    if [[ "$COLOR_ON" == 1 ]]; then
      printf '%s╭─ %s%s%s%s╮%s' "$DIM" "$CYAN" "$t_str" "$DIM" "$d_str" "$NC"
    else
      printf '╭─ %s%s╮' "$t_str" "$d_str"
    fi
  }

  card_bot() {
    local d_str=""
    printf -v d_str '%*s' "$(( target_w + 2 ))" ''
    d_str="${d_str// /─}"
    if [[ "$COLOR_ON" == 1 ]]; then
      printf '%s╰%s╯%s' "$DIM" "$d_str" "$NC"
    else
      printf '╰%s╯' "$d_str"
    fi
  }

  format_card_row() {
    local content="$1"
    local clean
    clean=$(strip_ansi "$content")
    local vlen=${#clean}
    # Backstop: never let a long value push the closing │ out of alignment.
    # truncate_visible keeps colors intact; the reset clears a color that was
    # cut mid-segment so padding/borders stay neutral.
    if (( vlen > target_w )); then
      content="$(trunc_visible "$content" $(( target_w - 1 )))…"
      if (( COLOR_ON == 1 )); then content+="$NC"; fi
      clean=$(strip_ansi "$content")
      vlen=${#clean}
    fi
    local pad=0
    if (( vlen < target_w )); then
      pad=$(( target_w - vlen ))
    fi
    local pad_spaces=""
    if (( pad > 0 )); then
      printf -v pad_spaces '%*s' "$pad" ''
    fi
    if [[ "$COLOR_ON" == 1 ]]; then
      printf '%s│%s %s%s %s│%s' "$DIM" "$NC" "$content" "$pad_spaces" "$DIM" "$NC"
    else
      printf '│ %s%s │' "$content" "$pad_spaces"
    fi
  }

  # Telemetry data gathering
  cpu_name=$(grep -m1 'model name' /proc/cpuinfo 2>/dev/null | sed -E 's/^model name[[:space:]]*:[[:space:]]*//; s/Intel\(R\) Core\(TM\) //; s/AMD //; s/ CPU.*//' || uname -m)
  cpu_threads=$(nproc 2>/dev/null || echo 1)
  host_model=$(cat /sys/devices/virtual/dmi/id/product_name 2>/dev/null || hostname)
  host_line=$(printf "%s · %s (%st)" "$host_model" "$cpu_name" "$cpu_threads")

  gpu_line=$(lspci 2>/dev/null | grep -iE 'vga|3d|display' | grep -o '\[[^]]*\]' | tr -d '[]' | sort -r | sed 's/GeForce //g; s/Graphics //g; s/ SUPER/S/g' | paste -sd, - | sed 's/,/ + /g' || echo "")
  [[ -z "$gpu_line" ]] && gpu_line="Integrated Graphics"

  # Card labels occupy 9 cols ("Host:    "), leaving 31 for the value.
  # DMI product names and multi-GPU lists routinely exceed that, so shorten
  # here (format_card_row also hard-caps as a backstop).
  (( ${#host_line} > 31 )) && host_line="${host_line:0:30}…"
  (( ${#gpu_line} > 31 )) && gpu_line="${gpu_line:0:30}…"

  disp_count=0
  if command -v hyprctl >/dev/null 2>&1; then
    disp_count=$(hyprctl monitors 2>/dev/null | grep -c '^Monitor ' || echo 1)
  fi
  if (( disp_count > 1 )); then
    disp_line=$(printf "%d displays (4K@60, 1440p@240)" "$disp_count")
  elif (( disp_count == 1 )); then
    disp_line="1 display active"
  else
    disp_line="Terminal Display"
  fi

  read -r _ disk_total disk_used _ disk_pct _ < <(df -h / 2>/dev/null | tail -1 || echo "_ 500G 200G 300G 40% _")

  bar_str() {
    local pct=$1 w=8 filled
    filled=$(( (pct * w + 50) / 100 ))
    (( filled > w )) && filled=$w
    local b=""
    printf -v b '%*s' "$filled" ''
    b="${b// /█}"
    local r=""
    printf -v r '%*s' "$(( w - filled ))" ''
    r="${r// /░}"
    if [[ "$COLOR_ON" == 1 ]]; then
      printf '%s%s%s%s%s' "$CYAN" "$b" "$DIM" "$r" "$NC"
    else
      printf '%s%s' "$b" "$r"
    fi
  }

  mem_bar=$(bar_str "$mem_pct")
  disk_p_num="${disk_pct//%/}"
  disk_bar=$(bar_str "$disk_p_num")

  # Card 1 rows (System Telemetry)
  c1_rows=()
  c1_rows+=("$(format_card_row "$(printf '%sHost:%s    %s' "$DIM" "$NC" "$host_line")")")
  c1_rows+=("$(format_card_row "$(printf '%sGPUs:%s    %s' "$DIM" "$NC" "$gpu_line")")")
  c1_rows+=("$(format_card_row "$(printf '%sDisplay:%s %s' "$DIM" "$NC" "$disp_line")")")
  c1_rows+=("$(format_card_row "$(printf '%sMemory:%s  %dG/%dG (%d%%) [%s]' "$DIM" "$NC" "$mem_used_g" "$mem_total_g" "$mem_pct" "$mem_bar")")")
  c1_rows+=("$(format_card_row "$(printf '%sStorage:%s %s/%s (%s) [%s]' "$DIM" "$NC" "$disk_used" "$disk_total" "$disk_pct" "$disk_bar")")")

  # Card 2 rows (Recent Workspaces)
  c2_rows=()
  idx=1
  # shellcheck disable=SC2012
  for g in $(ls -td "$HOME"/dev/*/.git 2>/dev/null | head -5); do
    d=$(dirname "$g")
    name=$(basename "$d")
    branch=$(git -C "$d" symbolic-ref --short HEAD 2>/dev/null || echo "main")
    if (( ${#name} > 13 )); then
      name="${name:0:11}.."
    fi
    if (( ${#branch} > 9 )); then
      branch="${branch:0:7}.."
    fi
    b_paren="(${branch})"
    time_ago=$(git -C "$d" log -1 --format="%cr" 2>/dev/null || echo "recently")
    time_ago=$(printf '%s' "$time_ago" | sed 's/ seconds\? ago/s ago/; s/ minutes\? ago/m ago/; s/ hours\? ago/h ago/; s/ days\? ago/d ago/; s/ weeks\? ago/w ago/; s/ months\? ago/m ago/')
    row_txt=$(printf "%s%d.%s  %s%-13s%s %s%-11s%s %8s" \
      "$CYAN" "$idx" "$NC" "$BOLD" "$name" "$NC" "$DIM" "$b_paren" "$NC" "$time_ago")
    c2_rows+=("$(format_card_row "$row_txt")")
    idx=$(( idx + 1 ))
  done

  while (( ${#c2_rows[@]} < 5 )); do
    c2_rows+=("$(format_card_row "  ${DIM}• none${NC}")")
  done

  # Card 3 rows (Cloud Workflows). Network state comes from the cache written
  # by dots-cloud-status; a stale cache (>10 min) triggers a detached refresh
  # so the splash itself never waits on the network. Daemons are checked live.
  cloud_conf="${XDG_CONFIG_HOME:-$HOME/.config}/dots/cloud-services"
  cloud_cache="${XDG_CACHE_HOME:-$HOME/.cache}/dots/cloud-status"
  now_s=$(date +%s)
  cs_updated=0
  if [[ -f "$cloud_cache" ]]; then
    while IFS='=' read -r k v; do
      [[ "$k" =~ ^[a-z_]+$ ]] && printf -v "cs_$k" '%s' "$v"
    done <"$cloud_cache"
  fi
  cache_age=$(( now_s - ${cs_updated:-0} ))
  if (( cache_age > 600 )) && command -v dots-cloud-status >/dev/null 2>&1; then
    if command -v setsid >/dev/null 2>&1; then
      (setsid dots-cloud-status >/dev/null 2>&1 &)
    else
      (nohup dots-cloud-status >/dev/null 2>&1 &)
    fi
  fi

  ago() {
    local s=$1
    [[ "$s" =~ ^[0-9]+$ ]] || { printf '?'; return; }
    s=$(( now_s - s ))
    if (( s < 3600 )); then printf '%dm ago' $(( s / 60 ))
    elif (( s < 172800 )); then printf '%dh ago' $(( s / 3600 ))
    else printf '%dd ago' $(( s / 86400 )); fi
  }
  dot() {  # dot <ok|warn|off>
    case "$1" in
      ok) printf '%s●%s' "$GREEN" "$NC" ;;
      warn) printf '%s▲%s' "$YELLOW" "$NC" ;;
      *) printf '%s○%s' "$DIM" "$NC" ;;
    esac
  }
  up_code() { [[ "${1:-}" =~ ^[23] ]]; }

  # Daemons: only units installed on this machine.
  daemons=""
  if command -v systemctl >/dev/null 2>&1 && [[ -f "$cloud_conf" ]]; then
    while read -r kind name unit _; do
      [[ "$kind" == daemon ]] || continue
      [[ "$(systemctl --user show -p LoadState --value "$unit" 2>/dev/null)" == loaded ]] || continue
      if systemctl --user is-active "$unit" >/dev/null 2>&1; then st=ok; else st=off; fi
      daemons+="${daemons:+ }$name $(dot "$st")"
    done < <(grep -vE '^\s*(#|$)' "$cloud_conf")
  fi
  [[ -z "$daemons" ]] && daemons="${DIM}none on this machine${NC}"

  # Net row: outpost edge/tunnel dots + site rollup in one row so the card
  # stays at 5 rows. Both are HTTP reachability (same failure domain).
  if [[ -z "${cs_edge_code:-}" ]]; then
    net_edge="${DIM}probing…${NC}"
  else
    up_code "$cs_edge_code" && e=ok || e=warn
    up_code "${cs_tunnel_code:-}" && t=ok || t=warn
    net_edge="edge $(dot "$e") tunnel $(dot "$t")"
  fi

  if [[ "${cs_sites_total:-?}" =~ ^[0-9]+$ ]]; then
    if [[ "${cs_sites_down:--}" == "-" ]]; then
      net_sites="${cs_sites_up}/${cs_sites_total} $(dot ok)"
    else
      down="${cs_sites_down//,/ }"
      (( ${#down} > 10 )) && down="${down:0:9}…"
      net_sites="${cs_sites_up}/${cs_sites_total} $(dot warn) ${YELLOW}${down}${NC}"
    fi
  else
    net_sites="${DIM}probing…${NC}"
  fi
  net="${net_edge} ${DIM}·${NC} ${net_sites}"

  # The collector runs nightly; more than 26h since its last push means it missed a run.
  if (( ${cs_updated:-0} == 0 )); then
    collector="profile-collector ${DIM}probing…${NC}"
  elif [[ "${cs_job_last:-?}" =~ ^[0-9]+$ ]]; then
    (( now_s - cs_job_last < 93600 )) && j=ok || j=warn
    collector="profile-collector $(dot "$j") $(ago "$cs_job_last")"
  else
    collector="profile-collector ${DIM}?${NC}"
  fi

  # status_row <prefix>: "ok/total ● newest" or "ok/total ▲ red-name"; "?" when
  # the refresher couldn't reach the source (no gh auth / no CF token).
  status_row() {
    local p=$1
    local v_ok="cs_${p}_ok" v_fail="cs_${p}_fail" v_pend="cs_${p}_pending" v_red="cs_${p}_red" v_new="cs_${p}_newest"
    local ok="${!v_ok:-?}" fail="${!v_fail:-0}" pending="${!v_pend:-0}" red="${!v_red:--}" newest="${!v_new:-0}"
    [[ "$ok" =~ ^[0-9]+$ ]] || { printf '%s?%s' "$DIM" "$NC"; return; }
    local total=$(( ok + fail + pending ))
    local s="$ok/$total"
    [[ "$pending" != 0 ]] && s+=" ${DIM}${pending}⏳${NC}"
    if [[ "$red" != "-" ]]; then
      (( ${#red} > 18 )) && red="${red:0:17}…"
      s+=" $(dot warn) ${YELLOW}${red//_/ }${NC}"
    else
      s+=" $(dot ok) $(ago "$newest")"
    fi
    printf '%s' "$s"
  }

  # cf_compact <prefix> <letter>: merged Workers/Pages cell — "W 20/20 ●",
  # "W 19/20 ▲ name", or "?" when the refresher couldn't reach Cloudflare.
  # Red names truncate at 10 chars so the merged row fits the 40-col card.
  cf_compact() {
    local p=$1 L=$2
    local v_ok="cs_${p}_ok" v_fail="cs_${p}_fail" v_pend="cs_${p}_pending" v_red="cs_${p}_red"
    local ok="${!v_ok:-?}" fail="${!v_fail:-0}" pending="${!v_pend:-0}" red="${!v_red:--}"
    [[ "$ok" =~ ^[0-9]+$ ]] || { printf '?'; return; }
    local total=$(( ok + fail + pending ))
    local s="$L $ok/$total"
    [[ "$pending" != 0 ]] && s+=" ${DIM}${pending}⏳${NC}"
    if [[ "$red" != "-" ]]; then
      (( ${#red} > 10 )) && red="${red:0:9}…"
      s+=" $(dot warn) ${YELLOW}${red//_/ }${NC}"
    else
      s+=" $(dot ok)"
    fi
    printf '%s' "$s"
  }

  if (( ${cs_updated:-0} == 0 )); then
    actions="${DIM}probing…${NC}"; cf="$actions"
  else
    actions="$(status_row actions)"
    cf="$(cf_compact workers W) ${DIM}·${NC} $(cf_compact pages P)"
  fi

  cloud_title="Cloud Workflows"
  if (( cache_age > 3600 && cs_updated > 0 )); then
    cloud_title+=" · $(ago "$cs_updated")"
  fi

  c3_rows=()
  c3_rows+=("$(format_card_row "$(printf '%sDaemons:%s %s' "$DIM" "$NC" "$daemons")")")
  c3_rows+=("$(format_card_row "$(printf '%sNet:%s      %s' "$DIM" "$NC" "$net")")")
  c3_rows+=("$(format_card_row "$(printf '%sGCP:%s     %s' "$DIM" "$NC" "$collector")")")
  c3_rows+=("$(format_card_row "$(printf '%sActions:%s %s' "$DIM" "$NC" "$actions")")")
  c3_rows+=("$(format_card_row "$(printf '%sCF:%s       %s' "$DIM" "$NC" "$cf")")")

  # Card 4 rows (Quick Actions)
  c4_rows=()
  c4_rows+=("$(format_card_row "$(printf '• %s%-10s%s → Jump to source repo' "$CYAN" "dots cd" "$NC")")")
  drift_color="$GREEN"
  if [[ "$drift_n" =~ ^[0-9]+$ ]] && (( drift_n > 0 )); then
    drift_color="$YELLOW"
  fi
  c4_rows+=("$(format_card_row "$(printf '• %s%-10s%s → Inspect %s%s drifted%s' "$CYAN" "dots diff" "$NC" "$drift_color" "$drift_s" "$NC")")")
  c4_rows+=("$(format_card_row "$(printf '• %s%-10s%s → Reconcile dotfiles' "$CYAN" "dots sync" "$NC")")")
  c4_rows+=("$(format_card_row "$(printf '• %s%-10s%s → Commit with Ollama' "$CYAN" "dots push" "$NC")")")
  c4_rows+=("$(format_card_row "$(printf '• %s%-10s%s → Full system spec' "$CYAN" "fastfetch" "$NC")")")

  # Print Wordmark & Header
  wordmark=$(render_wordmark "$displayName" "$lines" "$cols")
  printf '%s%s%s\n' "$accent_ansi" "$wordmark" "$NC"
  chips_s=$(printf '%s' "$chips_raw" | sed 's/|$//;s/|/ · /g')
  printf '  %s%s%s' "$DIM" "$machine" "$NC"
  [[ -n "$role" ]] && printf '  ·  %s%s%s' "$accent_ansi" "$role" "$NC"
  [[ -n "$chips_s" ]] && printf '  ·  %s[ %s ]%s\n\n' "$DIM" "$chips_s" "$NC"

  if (( cols >= 92 )); then
    # 2-column side-by-side grid
    printf '  %s  %s\n' "$(card_top "󰍹" "System Telemetry")" "$(card_top "" "Recent Workspaces")"
    for i in {0..4}; do
      printf '  %s  %s\n' "${c1_rows[$i]}" "${c2_rows[$i]}"
    done
    printf '  %s  %s\n\n' "$(card_bot)" "$(card_bot)"

    printf '  %s  %s\n' "$(card_top "󰅟" "$cloud_title")" "$(card_top "󰌌" "Quick Actions")"
    while (( ${#c4_rows[@]} < ${#c3_rows[@]} )); do
      c4_rows+=("$(format_card_row "")")
    done
    for i in "${!c3_rows[@]}"; do
      printf '  %s  %s\n' "${c3_rows[$i]}" "${c4_rows[$i]}"
    done
    printf '  %s  %s\n' "$(card_bot)" "$(card_bot)"
  else
    # 1-column responsive compact grid
    printf '  %s\n' "$(card_top "󰍹" "System Telemetry")"
    for r in "${c1_rows[@]}"; do printf '  %s\n' "$r"; done
    printf '  %s\n\n' "$(card_bot)"

    printf '  %s\n' "$(card_top "" "Recent Workspaces")"
    for i in {0..2}; do printf '  %s\n' "${c2_rows[$i]}"; done
    printf '  %s\n\n' "$(card_bot)"

    printf '  %s\n' "$(card_top "󰌌" "Quick Actions")"
    for i in {0..2}; do printf '  %s\n' "${c4_rows[$i]}"; done
    printf '  %s\n' "$(card_bot)"
  fi
fi
