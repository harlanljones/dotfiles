{{- if and (hasKey .chezmoi.osRelease "id") (eq .chezmoi.osRelease.id "omarchy") -}}
#!/usr/bin/python3
# omarchy:summary=Record real Cursor plan usage read from Cursor Agent or dashboard
# omarchy:args=--included PCT [--auto PCT] [--api PCT] [--reset-date YYYY-MM-DD]
# omarchy:hidden=true
"""Persist Cursor's plan usage read from Cursor Agent's /usage view.

The automated scraper drives only Cursor Agent's read-only /usage command and
passes Included, Auto, API, plan, reset date, and on-demand state here. The
older manual `--included`/`--resets` workflow remains supported as a fallback.

Cursor bills included usage on a single monthly cycle — there's no
session/weekly split like ClinePass — so this takes one percentage, not
three. --resets is optional and rarely known precisely; the dashboard shows
the cycle reset date, not a countdown, so pass a duration like "12d" if you
want a reset time shown, and omit it otherwise.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
import tempfile
from datetime import date, datetime, time, timedelta, timezone
from pathlib import Path
from typing import Any

DASHBOARD_URL = "https://cursor.com/dashboard"

DURATION_RE = re.compile(
  r"^\s*(?:(?P<days>\d+)d)?\s*(?:(?P<hours>\d+)h)?\s*(?:(?P<minutes>\d+)m)?\s*$"
)


def parse_duration(text: str) -> timedelta:
  match = DURATION_RE.match(text)
  if not match or not any(match.groups()):
    raise argparse.ArgumentTypeError(
      f"{text!r} is not a duration like '12d', '13h', or '45m'"
    )
  parts = {key: int(value) for key, value in match.groupdict(default="0").items()}
  return timedelta(days=parts["days"], hours=parts["hours"], minutes=parts["minutes"])


def parse_percent(text: str) -> float:
  value = float(text)
  if not 0 <= value <= 100:
    raise argparse.ArgumentTypeError(f"{text!r} is not a percentage between 0 and 100")
  return value / 100.0


def parse_date(text: str) -> date:
  try:
    return date.fromisoformat(text)
  except ValueError as error:
    raise argparse.ArgumentTypeError(f"{text!r} is not a date like '2026-09-09'") from error


def agents_config_dir() -> Path:
  root = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
  folder = root / "omarchy" / "agents"
  folder.mkdir(parents=True, exist_ok=True)
  return folder


def write_json(path: Path, payload: dict) -> None:
  handle_fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
  tmp = Path(tmp_name)
  try:
    with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
      handle.write(json.dumps(payload, indent=2) + "\n")
    tmp.chmod(0o644)
    tmp.replace(path)
  except BaseException:
    tmp.unlink(missing_ok=True)
    raise


def main() -> int:
  parser = argparse.ArgumentParser(description=__doc__)
  parser.add_argument("--included", type=parse_percent, required=True, help="Included usage this cycle, 0-100")
  parser.add_argument("--auto", type=parse_percent, default=None, help="Auto share of included usage, 0-100")
  parser.add_argument("--api", type=parse_percent, default=None, help="API share of included usage, 0-100")
  parser.add_argument("--resets", type=parse_duration, default=None)
  parser.add_argument("--reset-date", type=parse_date, default=None)
  parser.add_argument("--plan", default="")
  parser.add_argument("--on-demand", default="")
  parser.add_argument("--source", default=DASHBOARD_URL)
  parser.add_argument("--no-refresh", action="store_true", help="skip the immediate omarchy-agent-usage-update run")
  args = parser.parse_args()

  now = datetime.now().astimezone()
  if args.reset_date is not None:
    resets_at = datetime.combine(args.reset_date, time.min, tzinfo=timezone.utc).isoformat()
  else:
    resets_at = (now + args.resets).isoformat() if args.resets is not None else ""

  limits = [
    {
      "label": "Included usage (this cycle)",
      "title": "Included",
      "percent": round(args.included, 4),
      "resetsAt": resets_at,
      "binding": True,
    }
  ]
  if args.auto is not None:
    limits.append({"label": "Auto", "title": "Auto", "percent": round(args.auto, 4), "resetsAt": resets_at, "binding": False})
  if args.api is not None:
    limits.append({"label": "API", "title": "API", "percent": round(args.api, 4), "resetsAt": resets_at, "binding": False})

  payload = {
    "capturedAt": datetime.now(timezone.utc).isoformat(),
    "source": args.source,
    "tierLabel": args.plan,
    "usageStatusText": "On-demand usage is " + args.on_demand.lower() if args.on_demand else "",
    "limits": limits,
  }
  write_json(agents_config_dir() / "cursor-dashboard.json", payload)

  if not args.no_refresh:
    os.system("omarchy-agent-usage-update >/dev/null 2>&1 || true")

  print(json.dumps(payload, indent=2))
  return 0


if __name__ == "__main__":
  sys.exit(main())
{{- end -}}
