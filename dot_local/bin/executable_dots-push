#!/usr/bin/env bash
# dots-push - Commit & push the chezmoi dotfiles repo with an Ollama-generated
# conventional commit message. Invoked directly or via `dots push`.
#
# Usage:
#   dots-push
#
# Message generation is delegated to ollama-commit-msg.sh (the same generator
# used by the <leader>P/<leader>C LazyVim keymaps): chat API + system prompt +
# few-shot example, char-budgeted truncation, lockfile/minified exclusion, and
# proper sanitization. Do not reinvent that here — a naive `ollama run` +
# `head -n1` + blind 72-char cut mangles multi-line or larger-diff output
# (truncates mid-token instead of stopping at a clean boundary).
#
# Environment overrides (see ollama-commit-msg.sh for the full list):
#   CHEZMOI_DIR                 Chezmoi source directory (default: ~/.local/share/chezmoi)
#   OLLAMA_COMMIT_MODEL         Model used for message generation
#                               (default: qwen2.5-coder:7b)
#   OLLAMA_COMMIT_MAX_DIFF_CHARS  Diff chars sent to Ollama (default: 20000)
#   DOTS_PUSH_NO_CAPTURE        Set to 1 to skip the omarchy template capture step
#                               (used by `dots push`, which already captured).
set -euo pipefail

DOTFILES="${CHEZMOI_DIR:-$HOME/.local/share/chezmoi}"
MSG_GENERATOR="$HOME/.local/bin/ollama-commit-msg.sh"

cd "$DOTFILES"

# Capture `create_` templates (shell.json) + plugin manifest first:
# `chezmoi re-add` below refuses templates, so without this step shell.json
# drift would be silently left out of the commit. Best-effort — never block
# the push. Skip with DOTS_PUSH_NO_CAPTURE=1 (used by `dots push --no-capture`
# flows that already captured).
if [[ "${DOTS_PUSH_NO_CAPTURE:-0}" != "1" ]] && command -v omarchy-dotfiles-sync >/dev/null 2>&1; then
  omarchy-dotfiles-sync >/dev/null 2>&1 || echo "warning: template capture failed; continuing with re-add only." >&2
fi

chezmoi re-add >/dev/null 2>&1 || true

if git diff --quiet && git diff --cached --quiet && [ -z "$(git ls-files --others --exclude-standard)" ]; then
  git push
  echo "Nothing to commit; pushed."
  exit 0
fi

git add -A

msg=""
if [[ -x "$MSG_GENERATOR" ]]; then
  msg="$("$MSG_GENERATOR" 2>/dev/null || true)"
fi
msg="$(printf '%s\n' "$msg" | sed '/./,$!d')"

# Generator failure (missing binary, Ollama down, stderr discarded above)
# shows up as empty output — distinct from a generator that ran but produced
# a bad message, which the hook validation below catches.
if [[ -z "$msg" ]]; then
  echo "warning: generator produced no message; using safe default" >&2
  msg="chore: dots sync"
fi

# Validate the generated message with the same rules the commit-msg hook
# enforces (dot_config/git/hooks/executable_commit-msg), so a garbled or
# non-conventional Ollama output can never be committed (cf. ba99c33).
# Fail closed: fall back to a safe plain default rather than a corrupt message.
msg_hook="$HOME/.config/git/hooks/commit-msg"
[[ -x "$msg_hook" ]] || msg_hook="$DOTFILES/dot_config/git/hooks/executable_commit-msg"
if [[ -x "$msg_hook" ]]; then
  msg_tmp="$(mktemp)"
  trap 'rm -f "$msg_tmp"' EXIT
  printf '%s\n' "$msg" > "$msg_tmp"
  if ! "$msg_hook" "$msg_tmp" >/dev/null; then
    echo "warning: generated commit message invalid; using safe default" >&2
    msg="chore: dots sync"
  fi
  rm -f "$msg_tmp"
  trap - EXIT
else
  echo "warning: commit-msg hook not found or not executable; skipping message validation" >&2
fi

# Fixed literal, always valid; belt-and-braces check in case the hook is absent.
[[ -z "$msg" ]] && msg="chore: dots sync"

git commit -m "$msg"
git push
echo "Pushed: $(printf '%s' "$msg" | head -n1)"
