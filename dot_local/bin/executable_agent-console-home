#!/bin/bash
# Super+` : open the agent scratchpad, seeding it with the Omarchy default agent in ~ (not ~/Work).
# Hyprland's Lua config: `hyprctl dispatch` takes Lua dispatcher expressions.
#
# Two invocations of this script can race for one keypress: the SUPER+grave
# binding, and the scratchpad's on_created_empty seed (bindings.lua re-declares
# the rule so qconsole's `omarchy-agent` seed in ~/Work is replaced by this
# script). The lock file serializes them: whichever runs first claims it and
# spawns; the other becomes a no-op ensure-open so it can neither spawn a
# duplicate agent nor toggle-close the console the first one just opened. The
# 20s window must outlast a cold launch (uwsm-app -> xdg-terminal-exec ->
# ghostty -> hermes), whose window maps long after the spawn starts.
LOCK=/tmp/.agent-console-home.lock

fresh_lock() {
  [ -f "$LOCK" ] && [ $(( $(date +%s) - $(stat -c %Y "$LOCK" 2>/dev/null || echo 0) )) -lt 20 ]
}

# Idempotent open: create the scratchpad if absent, never close an open one.
ensure_open() {
  if ! hyprctl workspaces -j | jq -e 'any(.[]; .name == "special:scratchpad")' >/dev/null; then
    hyprctl dispatch 'hl.dsp.workspace.toggle_special("scratchpad")'
  fi
}

if fresh_lock; then
  ensure_open
  exit 0
fi

# Claim the lock before toggling: toggling an empty scratchpad is what fires
# the seed invocation, so the claim must already be in place when it starts.
touch "$LOCK"
( sleep 20; rm -f "$LOCK" ) &

hyprctl dispatch 'hl.dsp.workspace.toggle_special("scratchpad")'

# Spawn only if no agent window exists anywhere (not just in the scratchpad).
if ! hyprctl clients -j | jq -e 'any(.[]; .class == "org.omarchy.agent")' >/dev/null; then
  agent=$(omarchy-default-agent)
  [ -n "$agent" ] || { notify-send "No default agent set" "Run: omarchy default agent <name>"; exit 1; }
  hyprctl dispatch "hl.exec_cmd(\"bash -c 'cd ~ && exec omarchy-launch-tui --app-id=org.omarchy.agent $agent'\")"
else
  # No spawn happened; restore plain toggle semantics immediately.
  rm -f "$LOCK"
fi
