#!/usr/bin/env bash
# dots - Ergonomic CLI wrapper for chezmoi dotfiles management
# Provides fast syncing, noise-reduced diffing, drift absorption, and health checks.

set -euo pipefail

for _p in "$HOME/.local/share/mise/shims" "$HOME/.local/bin" "$HOME/.cache/.bun/bin"; do
  case ":${PATH}:" in
    *":$_p:"*) ;;
    *) PATH="$_p:$PATH" ;;
  esac
done
export PATH

# ANSI color styling
BOLD=$'\033[1m'
DIM=$'\033[2m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
RED=$'\033[0;31m'
CYAN=$'\033[0;36m'
NC=$'\033[0m'

ensure_chezmoi() {
  if ! command -v chezmoi >/dev/null 2>&1; then
    echo -e "${RED}error:${NC} chezmoi is not installed or not in PATH." >&2
    exit 1
  fi
}

get_source_dir() {
  ensure_chezmoi
  chezmoi source-path 2>/dev/null || echo "$HOME/.local/share/chezmoi"
}

# ------------------------------------------------- template drift helpers ---
# Files with the chezmoi `create_` attribute (e.g. omarchy shell.json) are
# invisible to `chezmoi status/diff`: chezmoi never reports them as modified
# after initial creation, and `chezmoi re-add` refuses to overwrite their
# templates. Drift must be detected by comparing the rendered template
# against the live target, and captured live -> repo via
# omarchy-dotfiles-sync (single source of truth, never duplicated here).
SHELL_LIVE_FILE="$HOME/.config/omarchy/shell.json"

shell_template_path() {
  printf '%s/dot_config/omarchy/create_private_shell.json.tmpl' "$(get_source_dir)"
}

# shell_template_drift: 0 = drifted, 1 = in sync, 2 = skipped (no live file,
# missing template, or not an omarchy host). Prints a short reason on stdout
# when skipped/drifted for callers that want it.
shell_template_drift() {
  local tmpl live rendered
  tmpl="$(shell_template_path)"
  live="$SHELL_LIVE_FILE"
  [[ -f "$live" ]] || { echo "skipped (no live shell.json)"; return 2; }
  [[ -f "$tmpl" ]] || { echo "skipped (template not present)"; return 2; }
  rendered=$(chezmoi execute-template < "$tmpl" 2>/dev/null) || { echo "skipped (template render failed)"; return 2; }
  [[ -n "$rendered" ]] || { echo "skipped (not an omarchy host)"; return 2; }
  if cmp -s <(printf '%s\n' "$rendered") "$live"; then
    return 1
  fi
  echo "drifted"
  return 0
}

shell_template_diff() {
  local tmpl live tmp
  tmpl="$(shell_template_path)"
  live="$SHELL_LIVE_FILE"
  tmp="$(mktemp)"
  chezmoi execute-template < "$tmpl" > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
  diff -u --label "chezmoi template (rendered)" --label "live $live" "$tmp" "$live" || true
  rm -f "$tmp"
}

capture_templates() {
  # Best-effort live -> repo capture for `create_` templates + plugin
  # manifest. Never writes to $HOME. Pass-through args to the sync script
  # (-n/--dry-run, --prune, --commit supported).
  if command -v omarchy-dotfiles-sync >/dev/null 2>&1; then
    omarchy-dotfiles-sync "$@" || return $?
  elif [[ ! -d "$HOME/.config/omarchy" ]]; then
    # Not an Omarchy host (Hadrian, Vespasian): nothing to capture.
    return 0
  else
    echo -e "${YELLOW}warning:${NC} omarchy-dotfiles-sync not found; template capture skipped." >&2
    return 1
  fi
}

usage() {
  cat <<EOF
${BOLD}dots${NC} - Ergonomic Chezmoi Dotfiles Manager

${BOLD}USAGE:${NC}
  dots <command> [options] [arguments]

${BOLD}COMMANDS:${NC}
  ${CYAN}sync, apply${NC}       Apply managed dotfiles to your home directory
  ${CYAN}diff${NC}              Show clean diff of pending changes (scripts hidden by default)
  ${CYAN}status, st${NC}        Show state of managed files (modified, added, untracked)
  ${CYAN}absorb, add${NC}       Capture live drift back into chezmoi repo (templates + re-add)
  ${CYAN}capture, cap${NC}     Capture create_ templates + plugin manifest (live -> repo)
  ${CYAN}edit, ed${NC}          Edit the source template for a target managed file
  ${CYAN}cd${NC}                Open a shell or print the chezmoi source directory path
  ${CYAN}backup${NC}           Snapshot files an apply would change (rollback safety)
  ${CYAN}uninstall${NC}        Remove chezmoi-managed files (restores latest backup)
  ${CYAN}update, pull${NC}      Pull latest dotfiles from git remote and apply
  ${CYAN}push, pp${NC}          Capture templates, commit & push with Ollama-generated message
  ${CYAN}doctor${NC}            Run diagnostics on tools, age keys, agent links, template drift
  ${CYAN}theme${NC}             Pick, list, show, or switch this machine's color theme
  ${CYAN}age, key${NC}          Manage age encryption key & 1Password backup/restore
  ${CYAN}setup${NC}             Run interactive system onboarding & setup wizard
  ${CYAN}help${NC}              Show this help message

${BOLD}OPTIONS FOR SYNC:${NC}
  -n, --dry-run      Show what changes would be made without applying them
  -v, --verbose      Show detailed output during sync
  -f, --force        Force overwrite without interactive prompts

${BOLD}OPTIONS FOR DIFF:${NC}
  -a, --all          Include generated script contents in the diff output

${BOLD}OPTIONS FOR THEME:${NC}
  dots theme                   Open the interactive picker in a terminal
  dots theme menu              Open the picker explicitly
  dots theme list              Print all available coordinated themes
  dots theme set <name>        Select a theme by name
  --no-sync                    Update the machine selection without applying it

${BOLD}OPTIONS FOR PUSH:${NC}
  Captures `create_` templates (shell.json) + plugin manifest via
  omarchy-dotfiles-sync, then delegates to dots-push: re-adds locally
  modified targets, stages all changes, generates a one-line conventional
  commit message with local Ollama, commits, and pushes to origin.
  Falls back to a dated message when Ollama is unavailable.
  Use --no-capture to skip the template capture step.
  Environment overrides:
    OLLAMA_COMMIT_MODEL   Model used for message generation
                          (default: qwen2.5-coder:7b)
    CHEZMOI_DIR           Chezmoi source directory
                          (default: ~/.local/share/chezmoi)

${BOLD}OPTIONS FOR CAPTURE:${NC}
  Standalone live -> repo capture for drift chezmoi cannot see: `create_`
  templates (omarchy shell.json) + plugin manifest. Never writes to $HOME.
  -n, --dry-run      Preview what would be captured without writing
  --prune            Also drop plugin manifest entries no longer installed
  --commit           Commit just the captured paths (same as sync script flag)

${BOLD}OPTIONS FOR ABSORB:${NC}
  No args: capture `create_` templates (shell.json) + plugin manifest, then
  re-add all modified managed files. File args: re-add those targets; shell.json
  is intercepted to template capture since `chezmoi re-add` refuses templates.
  -n, --dry-run      Preview template capture + re-add without writing
  --prune            Also drop plugin manifest entries no longer installed
  --omarchy          Capture omarchy templates/manifest only (skip generic re-add)

${BOLD}OPTIONS FOR BACKUP:${NC}
  Archives the current on-disk state of every managed target that an apply
  would change (from 'chezmoi status'), so a bad apply can be rolled back.
  Encrypted targets are backed up like ordinary files (their current
  on-disk state; archives are chmod 600 and the backup dir is 700).
  Location: ~/.local/share/dots-backups/<timestamp>.tar.gz (+ .manifest.tsv)
  -n, --dry-run      List what would be archived without writing anything

${BOLD}OPTIONS FOR UNINSTALL:${NC}
  Restores the latest backup (if any), then removes every chezmoi-managed
  file from the home directory. Never touches unmanaged files: ~/.hermes/
  profiles, state.db, memories, sessions, .env, or dotfiles-showcase.
  Requires confirmation on a TTY; refuses to run non-interactively without:
  --yes              Skip the confirmation prompt (for non-interactive use)

${BOLD}OPTIONS FOR THEME:${NC}
  Themes are listed in .chezmoidata/themes.yaml; each machine picks one with
  machines.<machine>.theme.name. "set" edits that value in the source repo and
  re-applies, so the choice syncs to other checkouts on the next dots push.
  list, ls           List available themes (current one marked with *)
  current            Print the current theme key
  set <name>         Switch theme and run dots sync
    --no-sync        Only edit the source repo; apply later with dots sync
  inspect <name>     Show a theme's registry entry and snapshot manifest
  import-aether      Import an Omarchy v4 colors.toml (from Aether, or a
                     public Omarchy theme) as a new immutable theme snapshot.
                     See docs/aether-theming-integration-proposal.md.
      --from-colors-toml PATH --id <slug> --label <text>  [--source-name ..]
                     [--source-repo URL] [--replace]
      --from-aether [BLUEPRINT]  (Augustus only; requires the aether CLI)
${BOLD}OPTIONS FOR AGE / KEY:${NC}
  status             Show key file path, derived public key, and 1Password status
  backup [vault]     Save age private key to 1Password vault (default: Personal)
  restore [uri]      Restore age private key from 1Password URI

${BOLD}EXAMPLES:${NC}
  dots sync                # Fast apply managed dotfiles
  dots diff                # View clean config diff (incl. create_ template drift)
  dots diff --all          # View full diff including run_* scripts
  dots status              # View modified files (incl. create_ template drift)
  dots absorb              # Capture templates + re-add all drift
  dots absorb -n           # Preview template + re-add drift without writing
  dots capture             # Capture create_ templates + plugin manifest only
  dots capture -n          # Preview template/manifest drift without writing
  dots absorb ~/.zshrc     # Capture local changes into chezmoi source
  dots absorb ~/.config/omarchy/shell.json  # Regenerate shell.json template (or: dots capture)
  dots update              # Pull remote changes and apply
  dots push                # Capture templates, commit with AI message, push
  dots doctor              # Verify keys, toolchains, links & template drift
  dots theme               # List themes, current one marked
  dots theme set tokyonight-storm  # Switch theme everywhere on this machine
EOF
}

# ------------------------------------------------------------------- theme ---
# A theme is data, not files: .chezmoidata/themes.yaml registers it, the
# per-tool palettes live in .chezmoitemplates/themes/<name>/, and templates
# render whichever name machines.<machine>.theme.name selects. Switching only
# rewrites that one value, so run_onchange scripts (Windows Terminal fragment,
# bat cache, Claude theme) re-run on their own during the following sync.

theme_current() {
  chezmoi execute-template \
    '{{ with (index .machines .machine).theme }}{{ if hasKey . "name" }}{{ .name }}{{ end }}{{ end }}' 2>/dev/null
}

theme_names() {
  chezmoi execute-template '{{ range $name, $t := .themes }}{{ $name }}{{ "\t" }}{{ $t.label }}{{ "\n" }}{{ end }}'
}

cmd_theme() {
  ensure_chezmoi
  local sub
  if [[ $# -eq 0 ]]; then
    if [[ -t 0 && -t 1 ]]; then
      sub="menu"
    else
      sub="list"
    fi
  else
    sub="$1"
    shift
  fi

  case "$sub" in
    menu|pick|select)
      cmd_theme_menu "$@"
      ;;
    list|ls)
      local current name label
      current="$(theme_current)"
      while IFS=$'\t' read -r name label; do
        [[ -n "$name" ]] || continue
        if [[ "$name" == "$current" ]]; then
          echo -e " ${GREEN}*${NC} ${BOLD}${name}${NC}  ${DIM}${label}${NC}"
        else
          echo -e "   ${name}  ${DIM}${label}${NC}"
        fi
      done < <(theme_names)
      [[ -n "$current" ]] || echo -e "${YELLOW}note:${NC} this machine has no theme.name in .chezmoidata/machines.yaml"
      ;;
    current)
      theme_current
      ;;
    set)
      cmd_theme_set "$@"
      ;;
    inspect)
      cmd_theme_inspect "$@"
      ;;
    import-aether)
      if ! command -v dots-theme-import-aether >/dev/null 2>&1; then
        echo -e "${RED}error:${NC} dots-theme-import-aether is not installed or not in PATH." >&2
        exit 1
      fi
      exec dots-theme-import-aether "$@"
      ;;
    *)
      echo -e "${RED}error:${NC} Unknown theme command '$sub'. Use: dots theme [menu|list|current|set <name>|inspect <name>|import-aether ...]" >&2
      exit 1
      ;;
  esac
}

cmd_theme_inspect() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "Usage: dots theme inspect <name>" >&2
    exit 1
  fi
  if ! theme_names | cut -f1 | grep -qxF "$name"; then
    echo -e "${RED}error:${NC} unknown theme '$name'." >&2
    exit 1
  fi
  chezmoi execute-template "{{ toJson (index .themes \"$name\") }}" | jq . 2>/dev/null || \
    chezmoi execute-template "{{ toJson (index .themes \"$name\") }}"
  local snapshot_dir manifest
  snapshot_dir="$(get_source_dir)/.chezmoitemplates/themes/$name"
  manifest="$snapshot_dir/manifest.yaml"
  if [[ -f "$manifest" ]]; then
    echo -e "\n${DIM}snapshot manifest ($manifest):${NC}"
    cat "$manifest"
  fi
}

cmd_theme_menu() {
  local no_sync=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-sync) no_sync=1 ;;
      -*) echo -e "${RED}error:${NC} Unknown option '$1'." >&2; exit 1 ;;
      *) echo -e "${RED}error:${NC} Unexpected argument '$1'." >&2; exit 1 ;;
    esac
    shift
  done

  local current selection name
  current="$(theme_current)"

  if command -v fzf >/dev/null 2>&1; then
    selection="$(
      theme_names |
        fzf \
          --delimiter=$'\t' \
          --with-nth=2 \
          --height=60% \
          --layout=reverse \
          --border=rounded \
          --prompt='Theme › ' \
          --header="Current: ${current:-none}  •  Enter applies  •  Esc cancels"
    )" || return 0
    name="${selection%%$'\t'*}"
  else
    local -a names labels
    local theme_name label
    while IFS=$'\t' read -r theme_name label; do
      [[ -n "$theme_name" ]] || continue
      names+=("$theme_name")
      labels+=("$label [$theme_name]")
    done < <(theme_names)

    echo -e "${BOLD}Choose a theme for this machine${NC} (current: ${current:-none})"
    PS3="Theme number (or Ctrl-C to cancel): "
    select selection in "${labels[@]}"; do
      [[ -n "$selection" ]] || {
        echo -e "${YELLOW}Choose one of the numbered themes.${NC}" >&2
        continue
      }
      name="${names[REPLY - 1]}"
      break
    done
  fi

  [[ -n "${name:-}" ]] || return 0
  if [[ $no_sync -eq 1 ]]; then
    cmd_theme_set "$name" --no-sync
  else
    cmd_theme_set "$name"
  fi
}

cmd_theme_set() {
  local name="" no_sync=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-sync) no_sync=1 ;;
      -*) echo -e "${RED}error:${NC} Unknown option '$1'." >&2; exit 1 ;;
      *) name="$1" ;;
    esac
    shift
  done

  if [[ -z "$name" ]]; then
    echo "Usage: dots theme set <name> [--no-sync]   (see: dots theme list)" >&2
    exit 1
  fi

  local machine current src
  machine="$(chezmoi execute-template '{{ .machine }}')"
  current="$(theme_current)"
  src="$(get_source_dir)"

  if [[ -z "$current" ]]; then
    echo -e "${RED}error:${NC} machine '$machine' has no theme.name in .chezmoidata/machines.yaml; theme switching is not wired up there." >&2
    exit 1
  fi
  if ! theme_names | cut -f1 | grep -qxF "$name"; then
    echo -e "${RED}error:${NC} unknown theme '$name'. Available:" >&2
    theme_names | cut -f1 | sed 's/^/  /' >&2
    exit 1
  fi
  if [[ "$name" == "$current" ]]; then
    echo -e "${GREEN}✓${NC} $machine already uses ${BOLD}$name${NC}"
    return 0
  fi

  # Rewrite only machines.<machine>.theme.name, preserving comments and layout
  # (a YAML round-trip would drop the registry's comments).
  python3 - "$src/.chezmoidata/machines.yaml" "$machine" "$name" <<'PY'
import re
import sys

path, machine, name = sys.argv[1:]
lines = open(path, encoding="utf-8").read().split("\n")
try:
    start = lines.index(f"  {machine}:")
except ValueError:
    sys.exit(f"machine {machine} not found in {path}")

in_theme = False
for i in range(start + 1, len(lines)):
    line = lines[i]
    if re.match(r"^ {0,2}\S", line):
        break  # next machine or top-level key
    if re.match(r"^    theme:\s*$", line):
        in_theme = True
        continue
    if in_theme and re.match(r"^    \S", line):
        break  # left the theme block
    match = re.match(r"^(      name:\s*)\S+(.*)$", line)
    if in_theme and match:
        lines[i] = match.group(1) + name + match.group(2)
        open(path, "w", encoding="utf-8").write("\n".join(lines))
        sys.exit(0)
sys.exit(f"theme.name not found for {machine} in {path}")
PY

  echo -e "${GREEN}✓${NC} $machine theme: ${DIM}$current${NC} -> ${BOLD}$name${NC} (source: .chezmoidata/machines.yaml)"

  if [[ $no_sync -eq 1 ]]; then
    echo -e "  ${DIM}apply with: dots sync${NC}"
  else
    cmd_sync
  fi
  echo -e "  ${DIM}Restart Windows Terminal and reopen nvim to see it; dots push syncs the choice.${NC}"
}

cmd_sync() {
  ensure_chezmoi
  local args=()
  local dry_run=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n|--dry-run)
        dry_run=1
        args+=("--dry-run")
        ;;
      -v|--verbose)
        args+=("--verbose")
        ;;
      -f|--force)
        args+=("--force")
        ;;
      *)
        args+=("$1")
        ;;
    esac
    shift
  done

  if [[ $dry_run -eq 1 ]]; then
    echo -e "${YELLOW}== Dry Run: Inspecting pending changes ==${NC}"
    chezmoi apply "${args[@]}"
    return 0
  fi

  echo -e "${CYAN}== Synchronizing dotfiles ==${NC}"
  if chezmoi apply "${args[@]}"; then
    echo -e "${GREEN}✓ Dotfiles successfully synchronized.${NC}"
  else
    local status=$?
    echo -e "${RED}✗ Dotfiles synchronization failed with exit code $status.${NC}" >&2
    return $status
  fi
}

cmd_diff() {
  ensure_chezmoi
  local include_scripts=0
  local passthrough=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -a|--all)
        include_scripts=1
        ;;
      *)
        passthrough+=("$1")
        ;;
    esac
    shift
  done

  if [[ $include_scripts -eq 1 ]]; then
    chezmoi diff "${passthrough[@]}"
  else
    # Default: filter out noisy script contents unless requested
    chezmoi diff --script-contents=false "${passthrough[@]}"
  fi

  # `create_` templates are invisible to `chezmoi diff`; surface shell.json
  # drift explicitly so it is never silently missed.
  if [[ ${#passthrough[@]} -eq 0 ]]; then
    local drift_reason
    if drift_reason=$(shell_template_drift); then
      echo
      echo -e "${YELLOW}--- create_ template drift (invisible to chezmoi diff): $SHELL_LIVE_FILE ---${NC}"
      shell_template_diff
      echo -e "${DIM}Capture with: dots capture${NC}"
    elif [[ "$drift_reason" == skipped* ]]; then
      : # not applicable on this host; stay quiet
    fi
  fi
}

cmd_status() {
  ensure_chezmoi
  local output
  output=$(chezmoi status "$@" 2>/dev/null || true)

  local tmpl_state=""
  local drift_reason
  if [[ $# -eq 0 ]] && drift_reason=$(shell_template_drift); then
    tmpl_state=" M $SHELL_LIVE_FILE (create_ template drift)"
  fi

  if [[ -z "$output" && -z "$tmpl_state" ]]; then
    echo -e "${GREEN}✓ Working tree clean (all managed files match source).${NC}"
    return 0
  fi

  echo -e "${BOLD}Managed Dotfiles Status:${NC}"
  if [[ -n "$output" ]]; then
    while IFS= read -r line; do
      local state="${line:0:2}"
      local file="${line:3}"
      case "$state" in
        " M"|"M ") echo -e "  ${YELLOW}modified:${NC}   $file" ;;
        " A"|"A ") echo -e "  ${GREEN}added:${NC}      $file" ;;
        " D"|"D ") echo -e "  ${RED}deleted:${NC}    $file" ;;
        " ?"|"? ") echo -e "  ${DIM}untracked:${NC}  $file" ;;
        *)         echo -e "  $state $file" ;;
      esac
    done <<< "$output"
  fi
  if [[ -n "$tmpl_state" ]]; then
    echo -e "  ${YELLOW}modified:${NC}   $SHELL_LIVE_FILE ${DIM}(create_ template drift; chezmoi hides this — run 'dots capture')${NC}"
  fi
}

cmd_capture() {
  ensure_chezmoi
  local sync_args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n|--dry-run) sync_args+=("-n") ;;
      --prune) sync_args+=("--prune") ;;
      --commit) sync_args+=("--commit") ;;
      -h|--help)
        echo "Usage: dots capture [-n|--dry-run] [--prune] [--commit]"
        echo "  Capture live -> repo drift that chezmoi cannot see: create_"
        echo "  templates (omarchy shell.json) + plugin manifest. Never writes"
        echo "  to \$HOME; never commits unless --commit is given."
        return 0
        ;;
      -*) echo -e "${RED}error:${NC} Unknown capture flag '$1'." >&2; return 1 ;;
      *) echo -e "${RED}error:${NC} dots capture takes no file arguments (use 'dots absorb <file>')." >&2; return 1 ;;
    esac
    shift
  done

  echo -e "${CYAN}Capturing live drift into chezmoi source (templates + plugin manifest)...${NC}"
  capture_templates "${sync_args[@]}"
}

cmd_absorb() {
  ensure_chezmoi
  local dry_run=0 omarchy_only=0
  local sync_args=() targets=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n|--dry-run) dry_run=1; sync_args+=("-n") ;;
      --prune) sync_args+=("--prune") ;;
      --omarchy) omarchy_only=1 ;;
      -h|--help)
        echo "Usage: dots absorb [-n|--dry-run] [--prune] [--omarchy] [<file-path ...>]"
        echo "  No args: capture create_ templates + plugin manifest, then re-add all drift."
        echo "  File args: re-add those targets (shell.json is routed to template capture)."
        return 0
        ;;
      -*) echo -e "${RED}error:${NC} Unknown absorb flag '$1'." >&2; return 1 ;;
      *) targets+=("$1") ;;
    esac
    shift
  done

  # Omarchy-only capture (templates + plugin manifest, no generic re-add).
  if [[ $omarchy_only -eq 1 ]]; then
    cmd_capture "${sync_args[@]}"
    return $?
  fi

  # No targets: full capture — templates first, then generic re-add.
  # (`chezmoi re-add` refuses `create_` templates, so the sync script must
  # run first; it never writes to $HOME.)
  if [[ ${#targets[@]} -eq 0 ]]; then
    echo -e "${CYAN}Capturing create_ templates + plugin manifest...${NC}"
    capture_templates "${sync_args[@]}" || true
    if [[ $dry_run -eq 1 ]]; then
      echo -e "${CYAN}Would re-add modified managed files (dry run):${NC}"
      chezmoi status 2>/dev/null | sed 's/^/   /' || true
    else
      echo -e "${CYAN}Re-adding modified managed files...${NC}"
      chezmoi re-add || true
    fi
    echo -e "${GREEN}✓ Absorb complete. Review with: dots status${NC}"
    return 0
  fi

  # Targeted absorb: route shell.json to template capture, rest to re-add.
  local readd_targets=()
  local shell_requested=0
  local t
  for t in "${targets[@]}"; do
    case "$t" in
      *omarchy/shell.json|*create_private_shell.json.tmpl)
        shell_requested=1 ;;
      *) readd_targets+=("$t") ;;
    esac
  done

  if [[ $shell_requested -eq 1 ]]; then
    echo -e "${CYAN}Regenerating shell.json template from live (re-add refuses templates)...${NC}"
    capture_templates "${sync_args[@]}" || true
  fi
  if [[ ${#readd_targets[@]} -gt 0 ]]; then
    if [[ $dry_run -eq 1 ]]; then
      echo -e "${CYAN}Would re-add target(s) (dry run):${NC} ${readd_targets[*]}"
      chezmoi status "${readd_targets[@]}" 2>/dev/null | sed 's/^/   /' || true
    else
      echo -e "${CYAN}Re-adding target(s) into chezmoi source:${NC} ${readd_targets[*]}"
      chezmoi re-add "${readd_targets[@]}"
    fi
  fi
  # Surface any remaining template drift so a targeted absorb can't hide it.
  local drift_reason
  if drift_reason=$(shell_template_drift); then
    echo -e "${YELLOW}!${NC} shell.json template still drifted — run 'dots capture' to capture it."
  fi
  echo -e "${GREEN}✓ Target(s) updated in chezmoi source repo.${NC}"
}

cmd_edit() {
  ensure_chezmoi
  if [[ $# -eq 0 ]]; then
    echo -e "${YELLOW}Usage: dots edit <file-path>${NC}"
    return 1
  fi
  chezmoi edit "$@"
}

cmd_cd() {
  local src
  src="$(get_source_dir)"
  if [[ -t 1 && -n "${SHELL:-}" && "${1:-}" != "--print" ]]; then
    echo -e "${CYAN}Entering chezmoi source directory:${NC} $src"
    cd "$src" && exec "$SHELL"
  else
    echo "$src"
  fi
}

cmd_update() {
  ensure_chezmoi
  local src
  src="$(get_source_dir)"
  echo -e "${CYAN}Pulling latest changes in $src...${NC}"
  git -C "$src" pull --rebase
  echo -e "${CYAN}Applying updated dotfiles...${NC}"
  cmd_sync "$@"
}

cmd_push() {
  if ! command -v dots-push >/dev/null 2>&1; then
    echo -e "${RED}error:${NC} dots-push is not installed or not in PATH." >&2
    exit 1
  fi
  local capture=1
  local passthrough=()
  for a in "$@"; do
    case "$a" in
      --no-capture) capture=0 ;;
      *) passthrough+=("$a") ;;
    esac
  done
  if [[ $capture -eq 1 ]]; then
    echo -e "${CYAN}Capturing create_ templates before commit...${NC}"
    capture_templates || echo -e "${YELLOW}warning:${NC} template capture failed; continuing with re-add only." >&2
  fi
  # dots-push captures on its own; the capture above already handled it
  # (or the user explicitly opted out) — avoid running it twice.
  export DOTS_PUSH_NO_CAPTURE=1
  echo -e "${CYAN}== Committing & pushing dotfiles repo (Ollama-generated message) ==${NC}"
  exec dots-push "${passthrough[@]}"
}

cmd_doctor() {
  ensure_chezmoi
  local src
  src="$(get_source_dir)"

  echo -e "${BOLD}=== Dotfiles Health & Diagnostics ===${NC}"

  # 1. Chezmoi binary
  local cm_ver
  cm_ver=$(chezmoi --version 2>/dev/null | head -n 1 || echo "unknown")
  echo -e " ${GREEN}✓${NC} ${BOLD}chezmoi:${NC} $cm_ver"

  # 2. Source repo git status
  if [[ -d "$src/.git" ]]; then
    local branch dirty
    branch=$(git -C "$src" branch --show-current 2>/dev/null || echo "detached")
    dirty=$(git -C "$src" status --porcelain 2>/dev/null | wc -l)
    if [[ "$dirty" -eq 0 ]]; then
      echo -e " ${GREEN}✓${NC} ${BOLD}source repo:${NC} $src (branch: ${CYAN}$branch${NC}, clean)"
    else
      echo -e " ${YELLOW}!${NC} ${BOLD}source repo:${NC} $src (branch: ${CYAN}$branch${NC}, ${YELLOW}$dirty uncommitted changes${NC})"
    fi
  else
    echo -e " ${RED}✗${NC} ${BOLD}source repo:${NC} $src is not a git repository"
  fi

  # 3. Age encryption key & 1Password
  local age_key="${HOME}/.config/chezmoi/key.txt"
  if [[ -f "$age_key" ]]; then
    echo -e " ${GREEN}✓${NC} ${BOLD}age key:${NC} found at $age_key"
  elif command -v age >/dev/null 2>&1; then
    echo -e " ${DIM}–${NC} ${BOLD}age:${NC} installed (custom key path or unencrypted config)"
  else
    echo -e " ${YELLOW}!${NC} ${BOLD}age:${NC} age binary not found in PATH"
  fi
  local op_bin
  op_bin="$(get_op_cmd)"
  if [[ -n "$op_bin" ]]; then
    local op_ver
    op_ver=$("$op_bin" --version 2>/dev/null || echo "installed")
    if "$op_bin" whoami >/dev/null 2>&1; then
      echo -e " ${GREEN}✓${NC} ${BOLD}1password:${NC} $op_bin v$op_ver (authenticated)"
    else
      echo -e " ${DIM}–${NC} ${BOLD}1password:${NC} $op_bin v$op_ver (installed; authenticate via desktop app or 'eval \$($op_bin signin)')"
    fi
  fi

  # 3b. SSH Agent & Git Commit Signing
  local ssh_sock="${SSH_AUTH_SOCK:-${HOME}/.1password/agent.sock}"
  if [[ ! -S "$ssh_sock" ]] || ! SSH_AUTH_SOCK="$ssh_sock" ssh-add -l >/dev/null 2>&1; then
    if ! pgrep -x wsl-ssh-bridge >/dev/null 2>&1 && command -v wsl-ssh-bridge >/dev/null 2>&1; then
      rm -f "$ssh_sock"
      (wsl-ssh-bridge >/dev/null 2>&1 &)
      sleep 0.5
    fi
  fi

  if [[ -S "$ssh_sock" ]]; then
    local key_count
    key_count=$(SSH_AUTH_SOCK="$ssh_sock" ssh-add -l 2>/dev/null | grep -E -c '^[0-9]+' || true)
    key_count="${key_count:-0}"
    if [[ "$key_count" -gt 0 ]]; then
      echo -e " ${GREEN}✓${NC} ${BOLD}ssh agent:${NC} active at $ssh_sock ($key_count key(s) loaded)"
    elif SSH_AUTH_SOCK="$ssh_sock" ssh-add -l 2>&1 | grep -qi 'no identities'; then
      echo -e " ${YELLOW}!${NC} ${BOLD}ssh agent:${NC} connected but no keys loaded (enable SSH agent in 1Password)"
    else
      echo -e " ${YELLOW}!${NC} ${BOLD}ssh agent:${NC} socket present but not responding"
    fi
  else
    echo -e " ${DIM}–${NC} ${BOLD}ssh agent:${NC} socket not active ($ssh_sock)"
  fi

  local git_signing
  git_signing=$(git config --get commit.gpgsign 2>/dev/null || echo "false")
  if [[ "$git_signing" == "true" ]]; then
    local sign_key
    sign_key=$(git config --get user.signingkey 2>/dev/null || echo "unset")
    echo -e " ${GREEN}✓${NC} ${BOLD}git signing:${NC} enabled (key: ${sign_key:0:24}...)"
  else
    echo -e " ${DIM}–${NC} ${BOLD}git signing:${NC} not enabled"
  fi

  # 4. Runtime managers (Mise / Bun)
  if command -v mise >/dev/null 2>&1; then
    local mise_ver
    mise_ver=$(mise --version 2>/dev/null | head -n 1)
    echo -e " ${GREEN}✓${NC} ${BOLD}mise:${NC} $mise_ver"
    local missing_tools
    missing_tools=$(mise ls --missing 2>/dev/null | wc -l || echo 0)
    if [[ "$missing_tools" -gt 0 ]]; then
      echo -e "   ${YELLOW}!${NC} ${DIM}$missing_tools requested mise tool(s) missing; run: mise install${NC}"
    fi

    # 4a. pipx-backed mise tools can report "installed" with an empty venv
    # (interrupted `uv tool install`); catch that before `hermes` etc. fail at runtime.
    local pipx_installs="$HOME/.local/share/mise/installs"
    if [[ -d "$pipx_installs" ]]; then
      local version_dir tool_name venv_dir sp_dir
      while IFS= read -r version_dir; do
        tool_name="$(basename "$(dirname "$version_dir")")"
        tool_name="${tool_name#pipx-}"
        venv_dir="$version_dir/$tool_name"
        [[ -d "$venv_dir" ]] || continue
        sp_dir=$(find "$venv_dir/lib" -mindepth 2 -maxdepth 2 -type d -name "site-packages" 2>/dev/null | head -n1)
        if [[ -z "$sp_dir" ]] || [[ -z "$(ls -A "$sp_dir" 2>/dev/null)" ]]; then
          echo -e "   ${YELLOW}!${NC} ${DIM}pipx:$tool_name venv looks empty/broken; run: mise uninstall pipx:$tool_name && mise install pipx:$tool_name${NC}"
        fi
      done < <(find "$pipx_installs" -mindepth 2 -maxdepth 2 -type d -path "*/pipx-*" 2>/dev/null)
    fi
  fi
  if command -v bun >/dev/null 2>&1; then
    local bun_ver
    bun_ver=$(bun --version 2>/dev/null | head -n 1)
    echo -e " ${GREEN}✓${NC} ${BOLD}bun:${NC} v$bun_ver"
  fi

  # 5. Agent skills catalog
  local shared_skills="$HOME/.agents/skills"
  if [[ -d "$shared_skills" ]]; then
    local skill_count
    skill_count=$(find "$shared_skills" -maxdepth 2 -name "SKILL.md" 2>/dev/null | wc -l)
    echo -e " ${GREEN}✓${NC} ${BOLD}agent skills:${NC} $skill_count skill(s) linked in $shared_skills"
  else
    echo -e " ${DIM}–${NC} ${BOLD}agent skills:${NC} $shared_skills not initialized yet"
  fi

  # 6. Live vs baseline drift check on Claude Code settings
  local claude_settings="$HOME/.claude/settings.json"
  if [[ -f "$claude_settings" ]]; then
    echo -e " ${GREEN}✓${NC} ${BOLD}claude settings:${NC} present at $claude_settings (dynamic drift auto-merged)"
  fi

  # 7. create_ template drift (invisible to `chezmoi status`; live -> repo only)
  local drift_reason
  if drift_reason=$(shell_template_drift); then
    echo -e " ${YELLOW}!${NC} ${BOLD}shell.json template:${NC} DRIFTED — live $SHELL_LIVE_FILE differs from rendered template"
    echo -e "   ${DIM}capture with: dots capture${NC}"
  elif [[ "$drift_reason" == skipped* ]]; then
    echo -e " ${DIM}–${NC} ${BOLD}shell.json template:${NC} $drift_reason"
  else
    echo -e " ${GREEN}✓${NC} ${BOLD}shell.json template:${NC} matches live $SHELL_LIVE_FILE"
  fi

  # 8. Omarchy plugin manifest vs installed plugins
  local manifest plugins_dir
  manifest="$src/.chezmoidata/omarchy_plugins.yaml"
  plugins_dir="$HOME/.config/omarchy/plugins"
  if [[ -f "$manifest" && -d "$plugins_dir" ]]; then
    local declared installed_git
    declared=$(grep -c -- '- url:' "$manifest" 2>/dev/null || echo 0)
    installed_git=$(find "$plugins_dir" -maxdepth 3 -name HEAD -path '*/.git/*' 2>/dev/null | wc -l)
    if [[ "$declared" -eq "$installed_git" ]]; then
      echo -e " ${GREEN}✓${NC} ${BOLD}omarchy plugins:${NC} manifest matches ($declared git-backed)"
    else
      echo -e " ${YELLOW}!${NC} ${BOLD}omarchy plugins:${NC} manifest declares $declared, $installed_git installed — run 'dots capture' (--prune drops uninstalled)"
    fi
  fi

  # 9. Drift watcher (auto-capture on live change; omarchy only)
  if systemctl --user list-unit-files omarchy-drift-capture.path 2>/dev/null | grep -q '\.path'; then
    local watcher_state
    watcher_state=$(systemctl --user is-active omarchy-drift-capture.path 2>/dev/null || true)
    if [[ "$watcher_state" == "active" ]]; then
      echo -e " ${GREEN}✓${NC} ${BOLD}drift watcher:${NC} omarchy-drift-capture.path active (auto-capture + notify)"
    else
      echo -e " ${YELLOW}!${NC} ${BOLD}drift watcher:${NC} omarchy-drift-capture.path is $watcher_state — run 'dots sync' to enable"
    fi
  fi

  echo
  echo -e "${GREEN}Diagnostics complete.${NC}"
}

get_op_cmd() {
  if command -v op.exe >/dev/null 2>&1; then
    echo "op.exe"
  elif command -v op >/dev/null 2>&1; then
    echo "op"
  else
    echo ""
  fi
}

cmd_age() {
  local subcmd="${1:-status}"
  shift || true
  local key_file="${HOME}/.config/chezmoi/key.txt"
  local op_bin
  op_bin="$(get_op_cmd)"

  case "$subcmd" in
    status)
      echo -e "${BOLD}=== Age Encryption & 1Password Status ===${NC}"
      if [[ -f "$key_file" ]]; then
        local perm
        perm=$(stat -c '%a' "$key_file" 2>/dev/null || stat -f '%Lp' "$key_file" 2>/dev/null || echo "ok")
        echo -e " ${GREEN}✓${NC} ${BOLD}age key file:${NC} $key_file (permissions: $perm)"
        if command -v age-keygen >/dev/null 2>&1; then
          local pub
          pub=$(age-keygen -y "$key_file" 2>/dev/null || echo "unable to derive")
          echo -e "   ${CYAN}Public recipient:${NC} $pub"
        fi
      else
        echo -e " ${YELLOW}!${NC} ${BOLD}age key file:${NC} not found at $key_file"
      fi

      if [[ -n "$op_bin" ]]; then
        local op_ver
        op_ver=$("$op_bin" --version 2>/dev/null || echo "installed")
        echo -e " ${GREEN}✓${NC} ${BOLD}1Password CLI ($op_bin):${NC} v$op_ver"
        if "$op_bin" whoami >/dev/null 2>&1; then
          echo -e "   ${GREEN}✓${NC} 1Password session active"
        else
          echo -e "   ${YELLOW}!${NC} 1Password session not authenticated (authenticate via desktop app or 'eval \$($op_bin signin)')"
        fi
      else
        echo -e " ${YELLOW}!${NC} ${BOLD}1Password CLI:${NC} neither op nor op.exe found in PATH"
      fi
      ;;
    backup)
      if [[ ! -f "$key_file" ]]; then
        echo -e "${RED}error:${NC} No age key found at $key_file to backup." >&2
        return 1
      fi
      if [[ -z "$op_bin" ]]; then
        echo -e "${RED}error:${NC} 1Password CLI (op / op.exe) not found in PATH." >&2
        return 1
      fi
      local vault="${1:-}"
      local vault_args=()
      local vault_display="default vault"
      if [[ -n "$vault" ]]; then
        vault_args=("--vault=$vault")
        vault_display="vault '$vault'"
      fi
      echo -e "${CYAN}Backing up $key_file to 1Password $vault_display via $op_bin...${NC}"
      if "$op_bin" item get "chezmoi-age-key" ${vault_args[@]+"${vault_args[@]}"} >/dev/null 2>&1; then
        if "$op_bin" item edit "chezmoi-age-key" notesPlain="$(cat "$key_file")" ${vault_args[@]+"${vault_args[@]}"}; then
          echo -e "${GREEN}✓ Updated existing 'chezmoi-age-key' item in $vault_display.${NC}"
        else
          echo -e "${RED}error:${NC} Failed to update 1Password item. Ensure 1Password is unlocked." >&2
          return 1
        fi
      else
        if "$op_bin" item create --category="Secure Note" --title="chezmoi-age-key" notesPlain="$(cat "$key_file")" ${vault_args[@]+"${vault_args[@]}"}; then
          echo -e "${GREEN}✓ Created 'chezmoi-age-key' secure note in $vault_display.${NC}"
        else
          echo -e "${RED}error:${NC} Failed to create 1Password item. Ensure 1Password is unlocked." >&2
          return 1
        fi
      fi
      ;;
    restore)
      local uri="${1:-}"
      if [[ -z "$op_bin" ]]; then
        echo -e "${RED}error:${NC} 1Password CLI (op / op.exe) not found in PATH." >&2
        return 1
      fi
      mkdir -p "$(dirname "$key_file")"
      local tmp
      tmp="$(mktemp)"
      if [[ -n "$uri" ]]; then
        echo -e "${CYAN}Restoring age key from 1Password ($uri) via $op_bin...${NC}"
        if "$op_bin" read "$uri" > "$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
          mv "$tmp" "$key_file"
          chmod 600 "$key_file"
          echo -e "${GREEN}✓ Age key restored to $key_file (0600).${NC}"
          return 0
        fi
      else
        echo -e "${CYAN}Retrieving 'chezmoi-age-key' from 1Password via $op_bin...${NC}"
        if "$op_bin" item get "chezmoi-age-key" --fields notesPlain > "$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
          mv "$tmp" "$key_file"
          chmod 600 "$key_file"
          echo -e "${GREEN}✓ Age key restored to $key_file (0600).${NC}"
          return 0
        fi
      fi
      rm -f "$tmp"
      echo -e "${RED}error:${NC} Failed to read secret from 1Password. Ensure 1Password is unlocked and item exists." >&2
      return 1
      ;;
    *)
      echo "Usage: dots age [status|backup <vault>|restore <uri>]"
      return 1
      ;;
  esac
}

cmd_setup() {
  local src
  src="$(get_source_dir)"
  if [[ -x "$src/setup.sh" ]]; then
    exec "$src/setup.sh" "$@"
  elif [[ -f "$src/setup.sh" ]]; then
    exec bash "$src/setup.sh" "$@"
  else
    echo -e "${RED}error:${NC} setup.sh not found in $src" >&2
    exit 1
  fi
}

# --------------------------------------------------- backup / uninstall -----
DOTS_BACKUP_DIR="$HOME/.local/share/dots-backups"

# Print changed target paths from `chezmoi status` (one per line), excluding
# run_* script entries. Paths are relative to $HOME (no ./ prefix).
changed_managed_targets() {
  chezmoi status 2>/dev/null | awk '
    { path = substr($0, 4)
      sub(/^\.\//, "", path)
      if (path !~ /run_/ && path != "") print path
    }' | sort -u
}

latest_backup_archive() {
  ls -1t "$DOTS_BACKUP_DIR"/*.tar.gz 2>/dev/null | head -n 1
}

cmd_backup() {
  ensure_chezmoi
  local dry_run=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n|--dry-run) dry_run=1 ;;
      -h|--help)
        echo "Usage: dots backup [-n|--dry-run]"
        echo "  Archive the current state of targets an apply would change"
        echo "  to $DOTS_BACKUP_DIR (tar.gz + sha256 manifest)."
        return 0 ;;
      -*) echo -e "${RED}error:${NC} Unknown backup flag '$1'." >&2; return 1 ;;
      *) echo -e "${RED}error:${NC} dots backup takes no arguments." >&2; return 1 ;;
    esac
    shift
  done

  local t
  # Drop targets that do not currently exist on disk (nothing to snapshot).
  # Read line-by-line: targets may contain spaces.
  local -a existing=()
  while IFS= read -r t; do
    [[ -n "$t" ]] || continue
    [[ -e "$HOME/$t" || -L "$HOME/$t" ]] && existing+=("$t")
  done < <(changed_managed_targets | sort -u)

  if [[ ${#existing[@]} -eq 0 ]]; then
    echo -e "${GREEN}✓${NC} Nothing to back up (no apply-modified managed files on disk)."
    return 0
  fi

  if [[ $dry_run -eq 1 ]]; then
    echo -e "${CYAN}Would archive (pre-apply state):${NC}"
    printf '  %s\n' "${existing[@]}"
    return 0
  fi

  mkdir -p "$DOTS_BACKUP_DIR"
  chmod 700 "$DOTS_BACKUP_DIR"
  local stamp archive manifest n
  stamp="$(date +%Y%m%dT%H%M%S)"
  # Second-resolution timestamps can collide with an earlier backup in the
  # same run; append -N until the name is free.
  n=2
  while [[ -e "$DOTS_BACKUP_DIR/$stamp.tar.gz" ]]; do
    stamp="$(date +%Y%m%dT%H%M%S)-$((n++))"
  done
  archive="$DOTS_BACKUP_DIR/$stamp.tar.gz"
  manifest="$DOTS_BACKUP_DIR/$stamp.manifest.tsv"

  {
    printf 'path\tsha256\n'
    for t in "${existing[@]}"; do
      # .evotai/evot.env is intentionally NOT excluded here: it holds provider
      # env config, so any backup of would-change targets must include it.
      if [[ -L "$HOME/$t" ]]; then
        printf '%s\tlink->%s\n' "$t" "$(readlink -- "$HOME/$t")"
      else
        printf '%s\t%s\n' "$t" "$(sha256sum -- "$HOME/$t" | awk '{print $1}')"
      fi
    done
  } > "$manifest"

  # Archive each target with its home-relative path preserved. tar archives
  # symlinks as symlinks by default, so restore reproduces the link, not a
  # copy of its target (deliberately no -h, which would dereference them).
  if tar -C "$HOME" -czf "$archive" -- "${existing[@]}"; then
    chmod 600 "$archive" "$manifest"
    echo -e "${GREEN}✓${NC} Backed up ${#existing[@]} file(s) to ${BOLD}$archive${NC}"
  else
    rm -f "$archive" "$manifest"
    echo -e "${RED}error:${NC} tar failed; no backup written." >&2
    return 1
  fi
}

# Targets that must never be removed by uninstall, even if chezmoi claims them.
uninstall_is_protected() {
  local t="$1"
  case "$t" in
    .hermes/profiles/*|.hermes/state.db|.hermes/memories*|.hermes/sessions*|.hermes/.env|.hermes/*/.env|.env|.config/opencode/opencode.json|.evotai/evot.env)
      # .evotai/evot.env holds provider env config (secrets-adjacent); never delete.
      return 0 ;;
    *) return 1 ;;
  esac
}

cmd_uninstall() {
  ensure_chezmoi
  local assume_yes=0 dry_run=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes|-y) assume_yes=1 ;;
      -n|--dry-run) dry_run=1 ;;
      -h|--help)
        echo "Usage: dots uninstall [--yes] [-n|--dry-run]"
        echo "  Restore the latest backup (if any), then remove every"
        echo "  chezmoi-managed file from \$HOME. Non-interactive runs need --yes."
        echo "  Always kept (never deleted): .hermes state/env, opencode.json,"
        echo "  .evotai/evot.env (provider env config)."
        return 0 ;;
      -*) echo -e "${RED}error:${NC} Unknown uninstall flag '$1'." >&2; return 1 ;;
      *) echo -e "${RED}error:${NC} dots uninstall takes no positional arguments." >&2; return 1 ;;
    esac
    shift
  done

  # Managed files only, excluding entries that require decryption (they
  # would prompt); protected paths are dropped as a hard second guard.
  local all_targets=() t
  while IFS= read -r t; do
    [[ -n "$t" ]] || continue
    uninstall_is_protected "$t" && continue
    all_targets+=("$t")
  done < <(chezmoi managed --include files --exclude encrypted 2>/dev/null)

  if [[ ${#all_targets[@]} -eq 0 ]]; then
    echo -e "${GREEN}✓${NC} No removable managed files; nothing to uninstall."
    return 0
  fi

  if [[ $dry_run -eq 1 ]]; then
    echo -e "${CYAN}Would remove ${#all_targets[@]} managed file(s):${NC}"
    printf '  %s\n' "${all_targets[@]}"
    echo -e "${YELLOW}kept (protected):${NC} .hermes state/env, .config/opencode/opencode.json, .evotai/evot.env"
    return 0
  fi

  if [[ $assume_yes -ne 1 ]]; then
    if [[ ! -t 0 || ! -t 1 ]]; then
      echo -e "${RED}error:${NC} refusing to uninstall without a TTY; pass --yes to confirm non-interactively." >&2
      return 1
    fi
    echo -e "${YELLOW}This removes ${#all_targets[@]} chezmoi-managed file(s) from \$HOME.${NC}"
    read -r -p "Type 'uninstall' to confirm: " reply
    if [[ "$reply" != "uninstall" ]]; then
      echo "Aborted."
      return 1
    fi
  fi

  # 1. Restore the latest backup before removal, so files an apply overwrote
  #    come back to their pre-apply state (anything untracked is then removed).
  local latest
  latest="$(latest_backup_archive)"
  if [[ -n "$latest" ]]; then
    echo -e "${CYAN}Restoring latest backup: $(basename "$latest")${NC}"
    tar -C "$HOME" -xzf "$latest"
  else
    echo -e "${DIM}no backup found in $DOTS_BACKUP_DIR; skipping restore.${NC}"
  fi

  # 2. Remove managed files (only if they exist; never touch anything else).
  local removed=0
  for t in "${all_targets[@]}"; do
    if [[ -f "$HOME/$t" || -L "$HOME/$t" ]]; then
      rm -f -- "$HOME/$t" && removed=$((removed + 1))
    fi
  done
  echo -e "${GREEN}✓${NC} Uninstalled: removed $removed managed file(s) from \$HOME."
}

# Subcommand dispatch
main() {
  local cmd="${1:-help}"
  shift || true

  case "$cmd" in
    sync|apply)     cmd_sync "$@" ;;
    diff)           cmd_diff "$@" ;;
    status|st)      cmd_status "$@" ;;
    absorb|add)     cmd_absorb "$@" ;;
    capture|cap)    cmd_capture "$@" ;;
    edit|ed)        cmd_edit "$@" ;;
    cd)             cmd_cd "$@" ;;
    update|pull)    cmd_update "$@" ;;
    backup)         cmd_backup "$@" ;;
    uninstall)      cmd_uninstall "$@" ;;
    push|pp)        cmd_push "$@" ;;
    doctor)         cmd_doctor "$@" ;;
    theme)          cmd_theme "$@" ;;
    age|key)        cmd_age "$@" ;;
    setup)          cmd_setup "$@" ;;
    help|-h|--help) usage ;;
    *)
      echo -e "${RED}error:${NC} Unknown command '$cmd'." >&2
      echo "Run 'dots help' for usage instructions." >&2
      exit 1
      ;;
  esac
}

main "$@"
