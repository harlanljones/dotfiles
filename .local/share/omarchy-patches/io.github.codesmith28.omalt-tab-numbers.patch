Numbers for workspaces in omalt-tab: 1-9 and 0 jump to workspaces 1-10, and
home-row keys a s d f g h j k l jump to the Nth window in the workspace
(upstream has these the other way round). Window badges and header hints
show the new keys. Applied by `omarchy-plugin-patches apply`.

diff --git i/AltTabOverlay.qml w/AltTabOverlay.qml
index cec9a00..69bcf30 100644
--- i/AltTabOverlay.qml
+++ w/AltTabOverlay.qml
@@ -95,7 +95,7 @@ Item {
     property bool isOpening: false
 
     readonly property string socketPath: (Quickshell.env("XDG_RUNTIME_DIR") || "/run/user/1000") + "/omalt-tab.sock"
-    readonly property var wsLetters: ["a", "s", "d", "f", "g", "h", "j", "k", "l", ";"]
+    readonly property var wsLetters: ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"]
 
     // In-memory check for Hyprland bindings hook to avoid unnecessary process spawns
     FileView {
@@ -780,14 +780,15 @@ Item {
                         root.selectedIndex = root.mruList.length - 1;
                         root.updateSelectionFromIndex();
                     }
-                } else if (event.key >= Qt.Key_1 && event.key <= Qt.Key_9) {
-                    root.jumpWindow(event.key - Qt.Key_0);
+                } else if (event.key >= Qt.Key_0 && event.key <= Qt.Key_9) {
+                    root.jumpWorkspace(String(event.key - Qt.Key_0));
                 } else if (event.key === Qt.Key_Print || event.key === Qt.Key_SysReq || ((event.key === Qt.Key_S || event.key === Qt.Key_Print) && (event.modifiers & Qt.MetaModifier))) {
                     root.takeScreenshot();
                 } else if (event.text && event.text.length === 1) {
                     var ch = event.text.toLowerCase();
-                    if ("asdfghjkl;".indexOf(ch) !== -1) {
-                        root.jumpWorkspace(ch);
+                    var winIdx = "asdfghjkl".indexOf(ch);
+                    if (winIdx !== -1) {
+                        root.jumpWindow(winIdx + 1);
                     }
                 }
                 event.accepted = true;
