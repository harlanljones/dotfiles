+    -- Number keys jump to workspaces 1-10 (0 is workspace 10)
+    for i = 1, 10 do
+        local key = tostring(i % 10)
+        bind_action(key, "workspace " .. key)
     end
 
-    -- Window numbers: 1-9
-    for i = 1, 9 do
-        bind_action(tostring(i), "window " .. i)
+    -- Home row keys jump to the Nth window in the workspace: asdfghjkl
+    local win_keys = { "a", "s", "d", "f", "g", "h", "j", "k", "l" }
+    for idx, k in ipairs(win_keys) do
+        bind_action(k, "window " .. idx)
     end
 
     -- Explicit release binds (guarded by dynamic read_dev_mode())
