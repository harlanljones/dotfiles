diff --git i/hypr/bindings.lua w/hypr/bindings.lua
index e33e1e6..80dbc65 100644
--- i/hypr/bindings.lua
+++ w/hypr/bindings.lua
@@ -123,16 +123,16 @@ hl.define_submap("omalt-tab", function()
         bind_action(dir, dir:lower())
     end
 
-    -- Home row workspace keys: asdfghjkl;
-    local ws_keys = { "a", "s", "d", "f", "g", "h", "j", "k", "l", "semicolon" }
-    local ws_letters = { "a", "s", "d", "f", "g", "h", "j", "k", "l", ";" }
