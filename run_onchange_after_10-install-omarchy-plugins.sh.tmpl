{{- if eq .machine "augustus" -}}
#!/bin/bash
# Installs/enables third-party Omarchy shell plugins listed in
# .chezmoidata/omarchy_plugins.yaml. Managed by chezmoi; this script is
# regenerated (and rerun) whenever that manifest changes.
#
# chezmoi data hash: {{ .omarchyPlugins | toJson | sha256sum }}

set -euo pipefail

command -v omarchy >/dev/null 2>&1 || { echo "omarchy: not found, skipping plugin sync" >&2; exit 0; }

PLUGINS_DIR="$HOME/.config/omarchy/plugins"

# Prints the plugin id (manifest.json "id") of the installed plugin whose
# origin remote matches $1, or nothing if none is installed for that url.
installed_id_for_url() {
  local url="${1%.git}"
  local dir remote
  [[ -d "$PLUGINS_DIR" ]] || return 0
  for dir in "$PLUGINS_DIR"/*/; do
    [[ -d "$dir/.git" ]] || continue
    remote="$(git -C "$dir" remote get-url origin 2>/dev/null || true)"
    remote="${remote%.git}"
    if [[ "$remote" == "$url" ]]; then
      jq -r '.id' "$dir/manifest.json" 2>/dev/null || true
      return 0
    fi
  done
  return 0
}

# The Theme modes plugin is locally patched below. Temporarily reverse that
# patch before an upstream update so Git sees a clean worktree, then reapply it
# after all plugin updates have finished.
theme_modes_dir="$PLUGINS_DIR/esemczak.theme-modes"
theme_modes_patch="$HOME/.local/share/omarchy-patches/esemczak.theme-modes-profiles.patch"
if [[ -d "$theme_modes_dir/.git" && -f "$theme_modes_patch" ]] \
  && git -C "$theme_modes_dir" apply --reverse --check "$theme_modes_patch"; then
  echo "omarchy plugin: temporarily removing Theme modes profiles patch for update"
  git -C "$theme_modes_dir" apply --reverse "$theme_modes_patch"
fi

# The omalt-tab compact patch is applied below. Temporarily reverse it (like
# Theme modes above) before an upstream update so Git sees a clean worktree,
# then reapply it after all plugin updates have finished.
omalt_tab_dir="$PLUGINS_DIR/io.github.codesmith28.omalt-tab"
omalt_tab_patch="$HOME/.local/share/omarchy-patches/io.github.codesmith28.omalt-tab-compact.patch"
if [[ -d "$omalt_tab_dir/.git" && -f "$omalt_tab_patch" ]] \
  && git -C "$omalt_tab_dir" apply --reverse --check "$omalt_tab_patch"; then
  echo "omarchy plugin: temporarily removing omalt-tab compact patch for update"
  git -C "$omalt_tab_dir" apply --reverse "$omalt_tab_patch"
fi

{{- range .omarchyPlugins }}
{{- if .enabled }}

url="{{ .url }}"
id="$(installed_id_for_url "$url")"
if [[ -n "$id" ]]; then
  echo "omarchy plugin: already installed ($id), updating: $url"
  omarchy plugin update "$id" --yes || true
else
  echo "omarchy plugin: installing $url"
  omarchy plugin add "$url" --enable --yes
fi
{{- end }}
{{- end }}

# Keep local Theme modes enhancements after its upstream repository is updated.
if [[ -d "$theme_modes_dir/.git" && -f "$theme_modes_patch" ]]; then
  if git -C "$theme_modes_dir" apply --reverse --check "$theme_modes_patch"; then
    echo "omarchy plugin: Theme modes profiles patch already applied"
  elif git -C "$theme_modes_dir" apply --check "$theme_modes_patch"; then
    echo "omarchy plugin: applying Theme modes profiles patch"
    git -C "$theme_modes_dir" apply "$theme_modes_patch"
  else
    echo "omarchy plugin: Theme modes profiles patch no longer applies; update the managed patch before continuing" >&2
    exit 1
  fi
fi

# Compact sizing for omalt-tab: 0.85x token set (denser cards for the 4K
# panel) plus matching test assertions. Same reverse-before-update discipline
# as Theme modes above so upstream updates apply to a clean tree and the
# sizing re-applies after.
omalt_tab_dir="$PLUGINS_DIR/io.github.codesmith28.omalt-tab"
omalt_tab_patch="$HOME/.local/share/omarchy-patches/io.github.codesmith28.omalt-tab-compact.patch"
if [[ -d "$omalt_tab_dir/.git" && -f "$omalt_tab_patch" ]]; then
  if git -C "$omalt_tab_dir" apply --reverse --check "$omalt_tab_patch"; then
    echo "omarchy plugin: omalt-tab compact patch already applied"
  elif git -C "$omalt_tab_dir" apply --check "$omalt_tab_patch"; then
    echo "omarchy plugin: applying omalt-tab compact patch"
    git -C "$omalt_tab_dir" apply "$omalt_tab_patch"
  else
    echo "omarchy plugin: omalt-tab compact patch no longer applies; update the managed patch before continuing" >&2
    exit 1
  fi
fi
{{- end -}}
