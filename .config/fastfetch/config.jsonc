{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "file", "source": "~/.config/omarchy/branding/about.txt", "color": { "1": "magenta", "2": "yellow" }, "padding": { "top": 2, "right": 6, "left": 2 } },
  "display": { "disableLinewrap": true },
  "modules": [
    "break",
    { "type": "custom", "format": "\u001b[33m═══ Imperator Diocletian · Dominus Machinae ═══" },
    "break",
    { "type": "host", "key": "Domus", "keyColor": "yellow" },
    { "type": "cpu", "key": "Legiones", "keyColor": "yellow" },
    { "type": "gpu", "key": "Ars", "keyColor": "yellow", "detectionMethod": "pci", "format": "{name}" },
    { "type": "memory", "key": "Memoria", "keyColor": "yellow" },
    { "type": "disk", "key": "Horrea", "keyColor": "yellow" },
    { "type": "display", "key": "Specula", "keyColor": "yellow" },
    "break",
    { "type": "custom", "format": "OS      Diocletian (Roman Imperium)" },
    { "type": "kernel", "key": "Nucleus", "keyColor": "magenta" },
    { "type": "wm", "key": "Forum", "keyColor": "magenta" },
    { "type": "terminal", "key": "Tabularium", "keyColor": "magenta" },
    { "type": "shell", "key": "Lingua", "keyColor": "magenta" },
    { "type": "uptime", "key": "Imperium", "keyColor": "magenta" },
    "break",
    "colors"
  ]
}
