# Secrets rendered from 1Password by bootstrap, one per line:
#   <template><TAB><target>
# Both paths are relative to $HOME. Templates hold only op://Agents/...
# references (see `op inject`); the Agents vault is the only one allowed, and
# bootstrap skips templates that name any other vault. Targets are excluded
# from the repo and written mode 600.
.config/yadm/secrets/git-identity.tpl	.config/git/identity
.config/yadm/secrets/audio-defaults.conf.tpl	.config/wireplumber/wireplumber.conf.d/51-audio-defaults.conf
