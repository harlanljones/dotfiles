#!/bin/sh
# Standard Git LFS hook (as generated by `git lfs install`).
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'post-merge' file in ~/.config/yadm/git-hooks."; exit 2; }
git lfs post-merge "$@"
