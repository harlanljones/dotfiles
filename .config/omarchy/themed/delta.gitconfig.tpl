# Rendered from ~/.config/omarchy/themed/delta.gitconfig.tpl on `omarchy theme set`.
[delta]
  minus-style                   = syntax "{{ mix background red 20% }}"
  minus-non-emph-style          = syntax "{{ mix background red 20% }}"
  minus-emph-style              = syntax "{{ mix background red 40% }}"
  minus-empty-line-marker-style = syntax "{{ mix background red 20% }}"
  line-numbers-minus-style      = "{{ red }}"
  plus-style                    = syntax "{{ mix background green 20% }}"
  plus-non-emph-style           = syntax "{{ mix background green 20% }}"
  plus-emph-style               = syntax "{{ mix background green 40% }}"
  plus-empty-line-marker-style  = syntax "{{ mix background green 20% }}"
  line-numbers-plus-style       = "{{ green }}"
  line-numbers-zero-style       = "{{ muted }}"
