{{- /* hasKey: CI's shellcheck job renders scripts without a chezmoi config. */ -}}
{{- if and (hasKey . "machine") (eq .machine "vespasian") -}}
#!/usr/bin/env bash
# Windows 11 Developer Experience & Debloat Tweaks:
# - Restores instant classic right-click context menu (bypasses slow "Show more options")
# - Disables Bing web search suggestions in Start Menu
# - Enables file extensions and hidden files in Explorer
# - Sets File Explorer to open to "This PC"
# - Shows full path in Explorer title bar
# - Auto-hides, left-aligns, and removes clutter from the taskbar
# - Disables lockscreen tips and promotional suggestions

set -euo pipefail

windows_tool="$HOME/.local/bin/wsl-windows-tool"
if [[ ! -x "$windows_tool" ]] || ! reg_exe="$($windows_tool path reg)" || \
   ! powershell_exe="$($windows_tool path powershell)"; then
  echo "windows-debloat: not running under WSL, skipping"
  exit 0
fi

echo "windows-debloat: applying Windows developer registry tweaks..."

set_reg() {
  local key="$1"
  shift
  "$reg_exe" add "$key" "$@" >/dev/null 2>&1 || true
}

# 1. Classic Windows 10/compact context menu
set_reg 'HKCU\Software\Classes\CLSID\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\InprocServer32' /f /ve

# 2. Disable Bing search suggestions in Start Menu
set_reg 'HKCU\Software\Microsoft\Windows\CurrentVersion\Search' /v BingSearchEnabled /t REG_DWORD /d 0 /f
set_reg 'HKCU\Software\Microsoft\Windows\CurrentVersion\Search' /v CortanaConsent /t REG_DWORD /d 0 /f

# 3. File Explorer developer settings
set_reg 'HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced' /v HideFileExt /t REG_DWORD /d 0 /f
set_reg 'HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced' /v Hidden /t REG_DWORD /d 1 /f
set_reg 'HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced' /v LaunchTo /t REG_DWORD /d 1 /f
set_reg 'HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\CabinetState' /v FullPath /t REG_DWORD /d 1 /f

# 4. Keep the Windows taskbar compact and out of the way beneath Zebar
set_reg 'HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced' /v TaskbarAl /t REG_DWORD /d 0 /f
set_reg 'HKCU\Software\Microsoft\Windows\CurrentVersion\Search' /v SearchboxTaskbarMode /t REG_DWORD /d 0 /f
set_reg 'HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced' /v TaskbarDa /t REG_DWORD /d 0 /f
set_reg 'HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced' /v ShowTaskViewButton /t REG_DWORD /d 0 /f
set_reg 'HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced' /v ShowCopilotButton /t REG_DWORD /d 0 /f

# StuckRects3 byte 8: 3 enables taskbar auto-hide; 2 keeps it always visible.
"$powershell_exe" -NoProfile -Command '
  $path = "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\StuckRects3";
  $settings = (Get-ItemProperty -Path $path -Name Settings -ErrorAction SilentlyContinue).Settings;
  if ($settings -and $settings[8] -ne 3) {
    $settings[8] = 3;
    Set-ItemProperty -Path $path -Name Settings -Value $settings;
    Stop-Process -Name explorer -Force
  }' < /dev/null

# 5. Disable suggestions and tips
set_reg 'HKCU\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager' /v SystemPaneSuggestionsEnabled /t REG_DWORD /d 0 /f
set_reg 'HKCU\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager' /v RotatingLockScreenOverlayEnabled /t REG_DWORD /d 0 /f
set_reg 'HKCU\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager' /v SubscribedContent-338387Enabled /t REG_DWORD /d 0 /f

echo "windows-debloat: registry tweaks applied successfully"
{{- end -}}
