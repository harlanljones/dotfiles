    {{- $hasMatchingKey = true }}
  {{- end }}
{{- end }}
{{- if not $hasMatchingKey }}
# No matching age identity on this machine, so the encrypted entries cannot be
# decrypted. Hide them rather than letting `chezmoi apply` abort partway
# through -- that failure is what left Hadrian half-adopted. Restore
# ~/.config/chezmoi/key.txt (docs/recovery.md) matching the recipient key and
# they come back on the next apply; .chezmoiignore is re-evaluated every run.
.config/opencode/opencode.json
{{- end }}
