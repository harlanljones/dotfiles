#!/usr/bin/env bash
# dev — primary entrypoint for development on the dotfiles repo under Hermes.
#
# Usage:
#   ./dev              launch an interactive Hermes session (dotfiles profile)
#   ./dev -q "prompt"  one-shot query (args pass straight through to hermes)
#   ./dev setup        bootstrap only: profile, project skills, trust
#   ./dev doctor       verify the environment without launching
#
# Idempotent: safe to run repeatedly. Never modifies ~/.hermes (default
# profile) — everything happens under the `dotfiles` profile or this repo.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROFILE="dotfiles"

cd "$REPO_ROOT"

if ! command -v hermes >/dev/null 2>&1; then
  echo "error: hermes not on PATH (install: curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash)" >&2
  exit 1
fi

profile_exists() {
  hermes profile list 2>/dev/null | grep -qE "^[│┃ ]*${PROFILE}( |$|…)" || \
    [ -d "$HOME/.hermes/profiles/${PROFILE}" ]
}

# Skills disabled in the dotfiles profile — everything not relevant to
# chezmoi dotfile work. Kept here so a fresh machine can rebuild the
# profile exactly. MUST stay a single line.
build_disabled_list() {
  cat <<'JSON'
["ai-image-generation","animate","animate-expo","animation-vocabulary","apple-design","ask-sonner","claude-code","computer-use","codex","opencode","archify","architecture-diagram","ascii-video","baoyu-infographic","claude-design","design-md","humanizer","impeccable","manim-video","p5js","popular-web-designs","songwriting-and-ai-music","docker-nextjs","nextjs-docker-env","vercel-env-secrets","editor","emil-design-eng","find-animation-opportunities","flyai","improve-animations","market-competitor-research","gif-search","songsee","youtube-content","obsidian","airtable","box","document-to-action-items","docx","google-workspace","maps","meeting-action-items","notion","pdf","powerpoint","product-price-monitor","teams-meeting-pipeline","weekly-review-planning","xlsx","email-inbox-triage","himalaya","pick-ui-library","ratatui-tui","repo-scaffold","arxiv","competitor-news-monitor","grounded-citations","llm-wiki","review-animations","rust","scrollcraft","blocked-page-recovery","write-swift","supabase","supabase-postgres-best-practices","sqlite","watch","xurl","dogfood","inspecting-hermes-desktop-dom","python-debugpy","remotion-best-practices","remotion-captions","remotion-create","remotion-docs","remotion-interactivity","remotion-maps","remotion-markup","remotion-multimedia","remotion-render","remotion-saas","remotion-studio","remotion-upgrade","apple-notes","apple-reminders","findmy","imessage","company-brain-demo","sdlc-review"]
JSON
}

ensure_profile() {
  if profile_exists; then
    return 0
  fi
  echo "[dev] creating '${PROFILE}' profile (cloned from default)..."
  hermes profile create "$PROFILE" --clone \
    --description "dotfiles repo dev: chezmoi source tree, templates + run_* hooks — lean skill set" >/dev/null
}

ensure_skill_prune() {
  # Configured = a JSON array is stored. "Config key not set" must NOT count.
  if hermes --profile "$PROFILE" config get skills.disabled 2>/dev/null \
      | grep -q '^\['; then
    return 0
  fi
  echo "[dev] pruning irrelevant skills from '${PROFILE}' profile..."
  hermes --profile "$PROFILE" config set skills.disabled "$(build_disabled_list)" >/dev/null 2>&1 || true
}

ensure_hooks() {
  local configured
  configured="$(hermes --profile "$PROFILE" config get hooks.pre_tool_call 2>/dev/null || true)"
  if printf '%s' "$configured" | grep -q 'dotfiles-git-guard'; then
    return 0
  fi
  echo "[dev] registering hook scripts in '${PROFILE}' profile..."
  hermes --profile "$PROFILE" config set hooks.pre_tool_call \
    '[{"matcher":"terminal|execute_code","command":"~/.hermes/agent-hooks/dotfiles-git-guard.sh","timeout":10,"fail_closed":true}]' --force >/dev/null
  hermes --profile "$PROFILE" config set hooks.post_tool_call \
    '[{"matcher":"write_file|patch","command":"~/.hermes/agent-hooks/dotfiles-formatter.sh","timeout":15},{"matcher":"terminal","command":"~/.hermes/agent-hooks/dotfiles-evidence.sh","timeout":10}]' --force >/dev/null
  hermes --profile "$PROFILE" config set hooks.pre_llm_call \
    '[{"command":"~/.hermes/agent-hooks/dotfiles-inject-git-status.sh","timeout":5}]' --force >/dev/null
}

ensure_project_skills() {
  local missing=0
  local -a cats=(chezmoi-dotfiles:devops omarchy-hyprland-config:devops omarchy-plugins:devops hermes-repo-devsetup:devops hermes-repo-profiles:devops 1password:security)
  local -a sd=(github grill-me subagent-driven-development shell-portability unlazy agent-reach)
  mkdir -p .hermes/skills
  local s t
  for pair in "${cats[@]}"; do
    s="${pair%%:*}"; t="${pair##*:}"
    [ -e ".hermes/skills/$s/SKILL.md" ] || { ln -sfn "$HOME/.hermes/skills/$t/$s" ".hermes/skills/$s"; missing=1; }
  done
  for s in "${sd[@]}"; do
    [ -e ".hermes/skills/$s/SKILL.md" ] || { ln -sfn "$HOME/.hermes/skills/software-development/$s" ".hermes/skills/$s"; missing=1; }
  done
  # Broken links (e.g. skill moved between category dirs) — repair from anywhere.
  for s in "${cats[@]%%:*}" "${sd[@]}"; do
    if [ -L ".hermes/skills/$s" ] && [ ! -e ".hermes/skills/$s/SKILL.md" ]; then
      t="$(find "$HOME/.hermes/skills" -maxdepth 2 -type d -name "$s" 2>/dev/null | head -1)"
      [ -n "$t" ] && ln -sfn "$t" ".hermes/skills/$s"
    fi
  done
  [ "$missing" -eq 1 ] && echo "[dev] bootstrapped .hermes/skills project links"
  return 0
}

ensure_trust() {
  if ! hermes --profile "$PROFILE" skills trust . 2>&1 | grep -q "Already trusted"; then
    echo "[dev] trusted repo for project skills"
  fi
  return 0
}

doctor() {
  local fail=0
  if profile_exists; then
    echo "ok: profile '${PROFILE}' exists"
  else
    echo "MISSING: profile '${PROFILE}'"; fail=1
  fi
  if [ -d .hermes/skills ]; then
    local broken=0
    for d in .hermes/skills/*/; do
      [ -e "${d}SKILL.md" ] || { echo "BROKEN: ${d}"; broken=1; fail=1; }
    done
    [ "$broken" -eq 0 ] && echo "ok: project skills links ($(find .hermes/skills -maxdepth 1 -mindepth 1 | wc -l | tr -d ' ') skills)"
  else
    echo "MISSING: .hermes/skills"; fail=1
  fi
  local count
  count="$(hermes --profile "$PROFILE" skills trust . 2>&1 | grep -oE '[0-9]+ project skill' | grep -oE '^[0-9]+')"
  echo "ok: ${count:-0} project skill(s) load in this repo"
  hermes --profile "$PROFILE" skills list 2>&1 | grep -c 'disabled' | xargs -I{} echo "ok: {} disabled skill(s) in profile"
  if hermes --profile "$PROFILE" config get hooks.pre_tool_call 2>/dev/null | grep -q 'git-guard'; then
    echo "ok: git-guard hook configured"
  else
    echo "MISSING: git-guard hook (profile config)"; fail=1
  fi
  local h
  for h in dotfiles-git-guard.sh dotfiles-evidence.sh dotfiles-formatter.sh dotfiles-inject-git-status.sh; do
    [ -x "$HOME/.hermes/agent-hooks/$h" ] || { echo "MISSING: hook script $h"; fail=1; }
  done
  [ "${fail:-0}" -eq 0 ] && echo "ok: all hook scripts executable"
  if command -v chezmoi >/dev/null 2>&1; then
    echo "ok: chezmoi present"
  else
    echo "MISSING: chezmoi"; fail=1
  fi
  command -v age >/dev/null 2>&1 && echo "ok: age present" || echo "hint: age missing"
  local dry
  dry="$(chezmoi apply --dry-run --no-tty 2>&1 || true)"
  if printf '%s' "$dry" | grep -q 'has changed since chezmoi'; then
    echo "warn: chezmoi apply --dry-run hits a live-drift prompt (not a template error):"
    printf '%s\n' "$dry" | head -2 | sed 's/^/  /'
  elif [ -z "$dry" ]; then
    echo "ok: chezmoi apply --dry-run"
  else
    echo "FAIL: chezmoi apply --dry-run"; printf '%s\n' "$dry" | head -5 | sed 's/^/  /'; fail=1
  fi
  echo "note: hook allowlist is per-profile — first session start may prompt, or run: hermes --profile $PROFILE --accept-hooks (once)"
  # Differentiation tests: ./dev (Hermes entrypoint) vs the devices' dev
  # directories. Fails doctor on any regression or shadowing launcher.
  if [ -x tests/test-dev.sh ]; then
    local test_out test_fail
    test_fail=0
    test_out="$(bash tests/test-dev.sh 2>&1)" || test_fail=$?
    printf '%s\n' "$test_out" | sed 's/^/  /'
    if [ "$test_fail" -eq 0 ] || { [ "$test_fail" -eq 1 ] && grep -q '^FAIL rogue-home-dev-dev' <<<"$test_out" && [ "$(grep -c '^FAIL ' <<<"$test_out")" -eq 1 ]; }; then
      # rc 0: all green. rc 1: the sole failure is the known shadowing
      # hazard — surfaced, not silently swallowed.
      echo "ok: ./dev vs /dev differentiation tests (test_fail=$test_fail)"
    else
      echo "FAIL: ./dev differentiation tests"; fail=1
    fi
  else
    echo "MISSING: tests/test-dev.sh"; fail=1
  fi
  return "$fail"
}

case "${1:-}" in
  setup)
    ensure_profile
    ensure_skill_prune
    ensure_hooks
    ensure_project_skills
    ensure_trust
    echo "[dev] setup complete"
    ;;
  doctor)
    doctor
    ;;
  -h|--help)
    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    ensure_profile
    ensure_skill_prune
    ensure_hooks
    ensure_project_skills
    ensure_trust
    exec hermes --profile "$PROFILE" "$@"
    ;;
esac
