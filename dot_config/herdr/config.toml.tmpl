onboarding = false

# Mirrors the Omarchy tmux config in config/tmux/tmux.conf
# tmux session -> herdr workspace, tmux window -> herdr tab, tmux pane -> herdr pane

[theme]
# tmux ran on the terminal's own palette (bg=default, fg=default, ANSI blue accents)
name = "terminal"

[theme.custom]
# The active tab is drawn as panel_bg text on an accent background, so panel_bg
# has to be dark for it to read - same colors as status-left's "#[fg=black,bg=blue]"
panel_bg = "black"
# Sidebar surfaces derived from the active `dots theme` palette (same resolver
# the other agent TUIs use), so switching themes re-colors the sidebar.
{{- $p := includeTemplate ".chezmoitemplates/theme-palette.tmpl" . | fromJson }}
sidebar_bg = "{{ $p.bg }}"
active_row_bg = "{{ $p.selection }}"
selection_bg = "{{ $p.cursor }}"
accent = "{{ $p.accent }}"

[terminal]
# Matches -c "#{pane_current_path}" on every split, window, and session
new_cwd = "follow"

[keys]
prefix = "ctrl+space"

# Config and help
reload_config = "prefix+q"
help = "prefix+?"
detach = "prefix+d"

# Copy mode
copy_mode = "prefix+["

# herdr's default edit_scrollback is prefix+e; keep that key free for the
# herdr-nvim sidebar plugin ([[keys.command]] below). Builtin named keys win
# over plugin command keys unless reassigned explicitly.
edit_scrollback = "prefix+shift+e"

# Panes
split_horizontal = ["prefix+h", "alt+enter"]
split_vertical = ["prefix+v", "alt+shift+enter"]
close_pane = ["prefix+x", "alt+esc"]
zoom = "prefix+z"
last_pane = "prefix+;"

focus_pane_left = "ctrl+alt+left"
focus_pane_down = "ctrl+alt+down"
focus_pane_up = "ctrl+alt+up"
focus_pane_right = "ctrl+alt+right"

resize_mode = [
  "prefix+ctrl+left",
  "prefix+ctrl+down",
  "prefix+ctrl+up",
  "prefix+ctrl+right",
]

# Like resize-pane on C-M-S-arrows
resize_pane_left = "ctrl+alt+shift+left"
resize_pane_down = "ctrl+alt+shift+down"
resize_pane_up = "ctrl+alt+shift+up"
resize_pane_right = "ctrl+alt+shift+right"

# No tmux equivalent; herdr's default prefix+shift+p is taken by previous session
rename_pane = "prefix+shift+o"

# Windows -> tabs
new_tab = "prefix+c"
rename_tab = "prefix+r"
close_tab = "prefix+k"
switch_tab = ["prefix+1..9", "alt+1..9"]
previous_tab = ["prefix+p", "alt+h"]
next_tab = ["prefix+n", "alt+l"]

# Like swap-window -t -1/+1 on M-S-Left/Right
move_tab_previous = "alt+shift+h"
move_tab_next = "alt+shift+l"

# Agents - no tmux equivalent. This box runs nine agent CLIs; these are the
# only way to reach a specific agent pane without hunting through the sidebar.
previous_agent = "alt+shift+k"
next_agent = "alt+shift+j"
focus_agent = "alt+shift+1..9"

# Worktrees - new_worktree keeps its prefix+shift+g default. prefix+shift+w is
# free because rename_workspace moved to prefix+shift+r above.
open_worktree = "prefix+shift+w"
remove_worktree = "prefix+shift+backspace"

# Sessions -> workspaces
new_workspace = "prefix+shift+c"
rename_workspace = "prefix+shift+r"
close_workspace = "prefix+shift+k"
previous_workspace = ["prefix+shift+p", "alt+k"]
next_workspace = ["prefix+shift+n", "alt+j"]

[[keys.command]]
key = "prefix+="
type = "plugin_action"
command = "ponko2.equalize-panes.equalize"
description = "Equalize panes"

[[keys.command]]
key = "prefix+e"
type = "plugin_action"
command = "chmarax.herdr-nvim.toggle"
description = "nvim sidebar"

[[keys.command]]
key = "prefix+o"
type = "plugin_action"
command = "chmarax.herdr-nvim.pick-file"
description = "open file from agent output"

[ui]
accent = "blue"

# The spaces tree (worktree names, "linear-github-colle…") and agent titles
# ("Directory structu…") both truncate at the default sidebar width.
sidebar_min_width = 34
sidebar_max_width = 42

# tmux drew single-line dividers between adjacent panes and no outer frame
pane_gaps = false
pane_outer_borders = false

# tmux had no scrollbar column beside its panes
pane_scrollbars = false

# kill-window and kill-session never asked
confirm_close = false

# automatic-rename gave windows a name without prompting
prompt_new_tab_name = false

# set -g mouse on
mouse_capture = true

# status-right had the zoom flag followed by #h
tab_bar_right = [{ type = "zoom" }, { type = "hostname" }]

# set -g set-titles on / set -g set-titles-string '#h:#W', where tmux's #W was
# the window name - herdr's tab. Default is "{hostname}: {workspace}".
window_title = "{hostname}: {tab}"

# Agent-oriented additions with no tmux ancestry
agent_panel_sort = "priority"            # attention queue: needs-input agents first
status_indicators = "symbols"            # distinct glyphs, not just color - the
                                         # "terminal" theme inherits whatever Omarchy
                                         # palette is live, some of them low-contrast
show_agent_labels_on_pane_borders = true # borders are on and tmux drew pane titles there

# herdr captures the mouse, so ghostty's mouse-scroll-multiplier = 0.95 never
# applies inside a pane. 2 lines/notch is the closest equivalent.
mouse_scroll_lines = 2

[ui.toast]
# Agent finished / needs input goes to the Hyprland notification daemon, so it
# is visible when herdr is not the focused window.
delivery = "system"
delay_seconds = 2   # don't fire on sub-2s agent turns

# Agent panel: rows generated by hhdebb.herdr-radar's own generator
# (bin/configure.js --apply, dark variant) so the sidebar gets radar's vendor
# logos, state colours and group headers - kept IN this template because
# chezmoi owns config.toml and would clobber radar's managed blocks. Regenerate
# after a radar upgrade:
#   XDG_CONFIG_HOME=<sandbox> node <radar>/bin/configure.js --apply
# The last two agent rows are native additions radar does not manage:
# $usage_pct is context-window usage (reported by each harness integration;
# dim gray at 0%, green otherwise); $model / $effort / $provider come from
# hook payloads and agent config. Unreported tokens collapse the row silently.
# Row colors for OUR tokens ($usage_pct, $model) come from the theme palette.
# Radar's state/vendor colors stay fixed on purpose: they are radar's own
# palette (its daemon rewrites them per appearance), not theme colors.
# Spaces keeps radar's state marks and adds branch/git_status back.
[ui.sidebar.agents]
# One blank row between agent entries: the $gap row radar writes only lands
# when the daemon has reported it, so row_gap guarantees separation.
row_gap = 1
# logo glyphs: font
rows = [[{ token = "$group_parent", fg = "#585a64", bold = true, dim = true }], [{ token = "$group", fg = "#7c7f93", bold = true, dim = false }, { token = "$group_stale", fg = "#585a64", bold = true, dim = true }], [{ token = "$split_mark", fg = "#585a64", bold = false, dim = true }, { token = "$logo", fg = "#e9e9f0", bold = false, dim = false, rules = [{ contains = "", fg = "#d97757" }, { contains = "", fg = "#4285f4" }, { contains = "", fg = "#1783ff" }, { contains = "", fg = "#4d6bfe" }, { contains = "", fg = "#615ced" }, { contains = "", fg = "#9046ff" }, { contains = "", fg = "#586876" }, { contains = "", fg = "#9a9808" }] }, { token = "$logo_working", fg = "#e9e9f0", bold = false, dim = false, rules = [{ contains = "", fg = "#d97757" }, { contains = "", fg = "#4285f4" }, { contains = "", fg = "#1783ff" }, { contains = "", fg = "#4d6bfe" }, { contains = "", fg = "#615ced" }, { contains = "", fg = "#9046ff" }, { contains = "", fg = "#586876" }, { contains = "", fg = "#9a9808" }] }, { token = "$logo_stale", fg = "#585a64", bold = false, dim = true }, { token = "$title_working", fg = "#c78a1f", bold = true, dim = false }, { token = "$title_done", fg = "#4c9a5a", bold = false, dim = false }, { token = "$title_blocked", fg = "#c04a4a", bold = false, dim = false }, { token = "$title_idle_fresh", fg = "#95bba2", bold = false, dim = false }, { token = "$title_idle", fg = "#a99e92", bold = false, dim = false }, { token = "$title_idle_stale", fg = "#585a64", bold = false, dim = true }, { token = "$title_unknown", fg = "#907aa9", bold = false, dim = false }], ["$gap"], [{ token = "$usage_pct", fg = "{{ $p.green }}", rules = [{ equals = "0", fg = "{{ $p.muted }}", dim = true }] }, { token = "$state_text", dim = true }], [{ token = "$model", fg = "{{ $p.accent }}", dim = true }, { token = "$effort", dim = true }], [{ token = "$provider", dim = true }]]

[ui.sidebar.spaces]
# Deliberately 1, not radar's 0: three stacked rows (state marks, logos,
# branch) read as one blob without air between entries.
row_gap = 1
rows = [
  [
    { token = "$space_blocked", fg = "#c04a4a", bold = true, dim = false },
    { token = "$space_working_claude", fg = "#d97757", bold = true, dim = false },
    { token = "$space_working_gemini", fg = "#4285f4", bold = true, dim = false },
    { token = "$space_working_kimi", fg = "#1783ff", bold = true, dim = false },
    { token = "$space_working_deepseek", fg = "#4d6bfe", bold = true, dim = false },
    { token = "$space_working_qwen", fg = "#615ced", bold = true, dim = false },
    { token = "$space_working_kiro", fg = "#9046ff", bold = true, dim = false },
    { token = "$space_working_cline", fg = "#586876", bold = true, dim = false },
    { token = "$space_working_kilo", fg = "#9a9808", bold = true, dim = false },
    { token = "$space_working_other", fg = "#c78a1f", bold = true, dim = false },
    { token = "$space_done", fg = "#4c9a5a", bold = true, dim = false },
    { token = "$space_idle", fg = "#6e738d", bold = false, dim = false },
    { token = "$space_unknown", fg = "#907aa9", bold = false, dim = false },
    { token = "$space_none", fg = "#9a9eb3", bold = false, dim = false },
    { token = "$space_label", fg = "#9a9eb3", bold = false, dim = false }
  ],
  [
    { token = "$space_logo_claude", fg = "#d97757", bold = false, dim = false },
    { token = "$space_logo_gemini", fg = "#4285f4", bold = false, dim = false },
    { token = "$space_logo_kimi", fg = "#1783ff", bold = false, dim = false },
    { token = "$space_logo_deepseek", fg = "#4d6bfe", bold = false, dim = false },
    { token = "$space_logo_qwen", fg = "#615ced", bold = false, dim = false },
    { token = "$space_logo_kiro", fg = "#9046ff", bold = false, dim = false },
    { token = "$space_logo_cline", fg = "#586876", bold = false, dim = false },
    { token = "$space_logo_kilo", fg = "#9a9808", bold = false, dim = false },
    { token = "$space_logo_other", fg = "#e9e9f0", bold = false, dim = false }
  ],
  ["branch", "git_status"]
]
[server]
# Layout size while no client is attached. Default 120x40 is far short of a
# fullscreen ghostty on the 2048x1152 logical displays (JetBrainsMono @9,
# 14px padding -> roughly 220x55).
headless_cols = 200
headless_rows = 50

[session]
# Agent panes come back as live conversations after a server restart
resume_agents_on_restore = true

[worktrees]
directory = "~/.herdr/worktrees"

[update]
# Pinned: harlan.corral declares min_herdr_version 0.8.0
channel = "stable"

[advanced]
# 10 MB default truncates long agent transcripts
scrollback_limit_bytes = 50000000

[experimental]
kitty_graphics = true
# Pane screen history survives a restart; pairs with resume_agents_on_restore
pane_history = true

{{ if eq .machine "augustus" -}}
# Corral lives in ~/dev/herdr-corral, which only exists on augustus
[[keys.command]]
key = "prefix+l"
type = "plugin_action"
command = "harlan.corral.toggle"
description = "Toggle the Linear panel"
{{ end -}}
