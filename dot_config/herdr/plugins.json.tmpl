[
{{- if eq .machine "augustus" }}
  {
    "plugin_id": "agent-progress",
    "name": "Agent Progress",
    "version": "0.1.0",
    "min_herdr_version": "0.9.0",
    "description": "Shows an agent's estimated task completion and current activity in the native sidebar.",
    "manifest_path": "{{ .chezmoi.homeDir }}/.config/herdr/plugins/github/agent-progress-c4a36df50adc/herdr-plugin.toml",
    "plugin_root": "{{ .chezmoi.homeDir }}/.config/herdr/plugins/github/agent-progress-c4a36df50adc",
    "enabled": true,
    "platforms": [
      "macos"
    ],
    "build": [
      {
        "command": [
          "cargo",
          "build",
          "--release",
          "--locked"
        ]
      }
    ],
    "startup": [
      {
        "command": [
          "target/release/herdr-progress",
          "startup"
        ]
      }
    ],
    "actions": [
      {
        "id": "activate",
        "title": "Print bound progress instructions for selected agent",
        "contexts": [
          "workspace"
        ],
        "command": [
          "target/release/herdr-progress",
          "activate"
        ]
      },
      {
        "id": "configure",
        "title": "Configure agent progress",
        "contexts": [
          "workspace"
        ],
        "command": [
          "target/release/herdr-progress",
          "configure"
        ]
      },
      {
        "id": "doctor",
        "title": "Check agent progress setup",
        "contexts": [
          "workspace"
        ],
        "command": [
          "target/release/herdr-progress",
          "doctor"
        ]
      },
      {
        "id": "start",
        "title": "Start progress publisher",
        "contexts": [
          "workspace"
        ],
        "command": [
          "target/release/herdr-progress",
          "start"
        ]
      },
      {
        "id": "stop",
        "title": "Stop progress publisher before upgrade",
        "contexts": [
          "workspace"
        ],
        "command": [
          "target/release/herdr-progress",
          "stop"
        ]
      },
      {
        "id": "unconfigure",
        "title": "Remove agent progress configuration",
        "contexts": [
          "workspace"
        ],
        "command": [
          "target/release/herdr-progress",
          "unconfigure"
        ]
      }
    ],
    "source": {
      "kind": "local"
    }
  },
  {
    "plugin_id": "chmarax.herdr-nvim",
    "name": "herdr-nvim",
    "version": "1.0.1",
    "min_herdr_version": "0.7.4",
    "description": "Full-height nvim sidebar with agent annotations: toggle with one key, comment code, send to any agent.",
    "manifest_path": "{{ .chezmoi.homeDir }}/.config/herdr/plugins/github/chmarax.herdr-nvim-178624809c23/herdr-plugin.toml",
    "plugin_root": "{{ .chezmoi.homeDir }}/.config/herdr/plugins/github/chmarax.herdr-nvim-178624809c23",
    "enabled": true,
    "platforms": [
      "macos",
      "linux",
      "windows"
    ],
    "build": [
      {
        "platforms": [
          "macos",
          "linux"
        ],
        "command": [
          "bash",
          "herdr/install.sh"
        ]
      },
      {
        "platforms": [
          "windows"
        ],
        "command": [
          "powershell.exe",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "herdr/install.ps1"
        ]
      }
    ],
    "actions": [
      {
        "id": "open-link",
        "title": "nvim sidebar: open clicked file",
        "command": [
          "bin/herdr-nvim",
          "open-link"
        ]
      },
      {
        "id": "pick-file",
        "title": "nvim sidebar: open file from agent output",
        "contexts": [
          "pane"
        ],
        "command": [
          "bin/herdr-nvim",
          "pick-file"
        ]
      },
      {
        "id": "toggle",
        "title": "nvim sidebar: toggle",
        "contexts": [
          "pane",
          "workspace"
        ],
        "command": [
          "bin/herdr-nvim",
          "toggle"
        ]
      }
    ],
    "panes": [
      {
        "id": "picker",
        "title": "open file",
        "placement": "popup",
        "command": [
          "bin/herdr-nvim",
          "picker"
        ]
      },
      {
        "id": "sidebar",
        "title": "nvim sidebar",
        "placement": "split",
        "command": [
          "bin/herdr-nvim",
          "sidebar"
        ]
      }
    ],
    "link_handlers": [
      {
        "id": "file-path",
        "title": "Open in nvim sidebar",
        "pattern": "^~?[\\w.@/()\\[\\]\\\\:+-]+[\\\\/][\\w.@()\\[\\]\\\\:+-]+\\.[A-Za-z]\\w*(?::\\d+){0,2}$",
        "action": "open-link"
      },
      {
        "id": "file-url",
        "title": "Open in nvim sidebar",
        "pattern": "^file://",
        "action": "open-link"
      }
    ],
    "source": {
      "kind": "github",
      "owner": "ChmaraX",
      "repo": "herdr-nvim",
      "resolved_commit": "0450dc7b4c40c986052541c00dba5cdcd1be7ac6",
      "managed_path": "{{ .chezmoi.homeDir }}/.config/herdr/plugins/github/chmarax.herdr-nvim-178624809c23",
      "installed_unix_ms": 1789599022275
    }
  },
  {
    "plugin_id": "harlan.corral",
    "name": "Corral",
    "version": "0.1.0",
    "min_herdr_version": "0.8.0",
    "description": "Dispatch Linear issues to agent panes and sync status back to Linear.",
    "manifest_path": "{{ .chezmoi.homeDir }}/dev/herdr-corral/herdr-plugin.toml",
    "plugin_root": "{{ .chezmoi.homeDir }}/dev/herdr-corral",
    "enabled": true,
    "platforms": [
      "linux",
      "macos"
    ],
    "build": [
      {
        "command": [
          "cargo",
          "build",
          "--release",
          "--locked"
        ]
      }
    ],
    "startup": [
      {
        "command": [
          "./target/release/corral",
          "reconcile"
        ]
      }
    ],
    "actions": [
      {
        "id": "install-shim",
        "title": "Install corral shim",
        "description": "Symlink ~/.local/bin/corral so agents can bind themselves",
        "command": [
          "./target/release/corral",
          "install-shim"
        ]
      },
      {
        "id": "pause",
        "title": "Pause Linear write-back",
        "command": [
          "./target/release/corral",
          "pause"
        ]
      },
      {
        "id": "toggle",
        "title": "Toggle Linear panel",
        "description": "Open or close the corral panel",
        "contexts": [
          "workspace",
          "tab"
        ],
        "command": [
          "./target/release/corral",
          "open"
        ]
      }
    ],
    "events": [
      {
        "on": "pane.agent_detected",
        "command": [
          "./target/release/corral",
          "event",
          "pane.agent_detected"
        ]
      },
      {
        "on": "pane.agent_status_changed",
        "command": [
          "./target/release/corral",
          "event",
          "pane.agent_status_changed"
        ]
      },
      {
        "on": "pane.closed",
        "command": [
          "./target/release/corral",
          "event",
          "pane.closed"
        ]
      },
      {
        "on": "pane.exited",
        "command": [
          "./target/release/corral",
          "event",
          "pane.exited"
        ]
      }
    ],
    "panes": [
      {
        "id": "panel",
        "title": "Linear",
        "placement": "split",
        "command": [
          "./target/release/corral",
          "panel"
        ]
      }
    ],
    "source": {
      "kind": "local"
    }
  },
