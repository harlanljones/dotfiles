[Unit]
Description=Generate Agent Leaderboard nightly analysis
After=agent-leaderboard-dashboard.service ollama-agent-leaderboard.service

[Service]
Type=oneshot
WorkingDirectory=%h/dev/agent-leaderboard/apps/web
EnvironmentFile=-%h/.config/agent-leaderboard/dashboard.env
ExecStart=%h/.local/share/mise/installs/bun/latest/bin/bun src/cli.ts analyze
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/agent-leaderboard
