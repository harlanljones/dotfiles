[Unit]
Description=Private Agent Leaderboard dashboard
After=network-online.target ollama-agent-leaderboard.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/dev/agent-leaderboard/apps/web
EnvironmentFile=-%h/.config/agent-leaderboard/dashboard.env
ExecStart=%h/.local/share/mise/installs/bun/latest/bin/bun src/server.ts
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/agent-leaderboard

[Install]
WantedBy=default.target
