[Unit]
Description=Private Omarchy Agents dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/dev/omarchy-agents/apps/web
EnvironmentFile=-%h/.config/omarchy-agents/dashboard.env
ExecStart=%h/.local/share/mise/installs/bun/latest/bin/bun src/server.ts
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/omarchy-agents

[Install]
WantedBy=default.target
