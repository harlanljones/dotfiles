customCommands:
  - key: '<c-g>'
    context: 'files'
    description: 'Generate commit message with Ollama'
    command: '~/.local/bin/lazygit-ollama-commit.sh'
    loadingText: 'Generating commit message with Ollama...'
    output: terminal
  - key: '<c-n>'
    context: 'files'
    description: 'Generate commit message with Ollama (no push)'
    command: 'LAZYGIT_OLLAMA_NO_PUSH=1 ~/.local/bin/lazygit-ollama-commit.sh'
    loadingText: 'Generating commit message with Ollama...'
    output: terminal
{{ if eq .machine "vespasian" -}}
{{- $name := (index .machines .machine).theme.name -}}
# Theme selected with `dots theme`: .chezmoitemplates/themes/{{ $name }}/lazygit.yml
{{ include (printf ".chezmoitemplates/themes/%s/lazygit.yml" $name) | trim }}
{{ end -}}
{{ if lookPath "delta" -}}
git:
  # Only rendered when delta is installed
  pager: delta --dark --paging=never
{{- end }}
