# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#060912"

# Main text color
theme[main_fg]="#959aa4"

# Title color for boxes
theme[title]="#959aa4"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#b16371"

# Background color of selected item in processes box. #7b808a maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #25272d gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#25272d"

# Foreground color of selected item in processes box. Use #959aa4 so
# the row text stays readable on the lighter_bg highlight; the previous
# #b16371 produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#959aa4"

# Color of inactive/disabled text
theme[inactive_fg]="#5f5f5f"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #8f939c caps at #ffffff when the foreground is already pure white, so we
# just bind it to #959aa4 directly.
theme[graph_text]="#959aa4"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #7b808a collapsed to the main fg.
theme[meter_bg]="#25272d"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #508381 for a distinct accent instead of #8f939c which capped to white.
theme[proc_misc]="#508381"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#8d718c"
theme[mem_box]="#6c8064"
theme[net_box]="#b16371"
theme[proc_box]="#b16371"

# Box divider line and small boxes line color
theme[div_line]="#5f5f5f"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#6c8064"
theme[temp_mid]="#88785c"
theme[temp_end]="#b16371"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#508381"
theme[cpu_mid]="#6a7c94"
theme[cpu_end]="#8d718c"

# Mem/Disk free meter
theme[free_start]="#8d718c"
theme[free_mid]="#6a7c94"
theme[free_end]="#508381"

# Mem/Disk cached meter
theme[cached_start]="#6a7c94"
theme[cached_mid]="#508381"
theme[cached_end]="#8d718c"

# Mem/Disk available meter
theme[available_start]="#88785c"
theme[available_mid]="#b16371"
theme[available_end]="#b16371"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#6c8064"
theme[used_mid]="#508381"
theme[used_end]="#6a7c94"

# Download graph colors
theme[download_start]="#88785c"
theme[download_mid]="#b16371"
theme[download_end]="#b16371"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#6c8064"
theme[upload_mid]="#508381"
theme[upload_end]="#6a7c94"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#508381"
theme[process_mid]="#6a7c94"
theme[process_end]="#8d718c"
