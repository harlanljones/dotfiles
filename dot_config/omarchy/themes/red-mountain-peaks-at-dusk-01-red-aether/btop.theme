# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#000000"

# Main text color
theme[main_fg]="#e9f4ff"

# Title color for boxes
theme[title]="#e9f4ff"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#7b789e"

# Background color of selected item in processes box. #e9f4ff maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #1a1a1a gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#1a1a1a"

# Foreground color of selected item in processes box. Use #e9f4ff so
# the row text stays readable on the lighter_bg highlight; the previous
# #7b789e produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#e9f4ff"

# Color of inactive/disabled text
theme[inactive_fg]="#686163"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #ecf6ff caps at #ffffff when the foreground is already pure white, so we
# just bind it to #e9f4ff directly.
theme[graph_text]="#e9f4ff"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #e9f4ff collapsed to the main fg.
theme[meter_bg]="#1a1a1a"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #c1d5ff for a distinct accent instead of #ecf6ff which capped to white.
theme[proc_misc]="#c1d5ff"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#b19fce"
theme[mem_box]="#a4c2e9"
theme[net_box]="#a189a8"
theme[proc_box]="#7b789e"

# Box divider line and small boxes line color
theme[div_line]="#686163"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#a4c2e9"
theme[temp_mid]="#ffdcff"
theme[temp_end]="#a189a8"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#c1d5ff"
theme[cpu_mid]="#7b789e"
theme[cpu_end]="#b19fce"

# Mem/Disk free meter
theme[free_start]="#b19fce"
theme[free_mid]="#7b789e"
theme[free_end]="#c1d5ff"

# Mem/Disk cached meter
theme[cached_start]="#7b789e"
theme[cached_mid]="#c1d5ff"
theme[cached_end]="#b19fce"

# Mem/Disk available meter
theme[available_start]="#ffdcff"
theme[available_mid]="#a189a8"
theme[available_end]="#a189a8"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#a4c2e9"
theme[used_mid]="#c1d5ff"
theme[used_end]="#7b789e"

# Download graph colors
theme[download_start]="#ffdcff"
theme[download_mid]="#a189a8"
theme[download_end]="#a189a8"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#a4c2e9"
theme[upload_mid]="#c1d5ff"
theme[upload_end]="#7b789e"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#c1d5ff"
theme[process_mid]="#7b789e"
theme[process_end]="#b19fce"
