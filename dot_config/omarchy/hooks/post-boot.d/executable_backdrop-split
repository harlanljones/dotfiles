#!/usr/bin/env bash
# Omarchy post-boot hook: make sure the Backdrop plugin owns the background
# target (it can end up disabled in favour of omarchy.background), then
# re-split the wallpaper across the monitors.
set -u

# Wait up to 60s for the shell IPC to come up.
for _ in $(seq 30); do
	omarchy-shell shell ping >/dev/null 2>&1 && break
	sleep 2
done

if ! omarchy-shell background assignments >/dev/null 2>&1; then
	omarchy-plugin-enable lgse.backdrop >/dev/null 2>&1 || exit 0
	for _ in $(seq 10); do
		omarchy-shell background assignments >/dev/null 2>&1 && break
		sleep 1
	done
fi

exec "$HOME/.local/bin/backdrop-split" --auto
