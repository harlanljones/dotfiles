{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
{{- if eq .machine "augustus" }}
    "type": "kitty",
    "source": "~/.config/fastfetch/augustus.jpg",
{{- else if eq .machine "vespasian" }}
    {{/* Inline graphics misplace over the WSL pipe (fastfetch can't query cursor position there), so Vespasian uses pre-rendered truecolor half-block art: always aligned, no terminal queries. Source portrait: marble bust of Vespasian, Statens Museum for Kunst, CC0 (https://commons.wikimedia.org/wiki/File:Vespasian_Bust.jpg); vespasian.jpg is the head crop, vespasian.txt its ANSI rendering. */}}
    "type": "file-raw",
    "source": "~/.config/fastfetch/vespasian.txt",
{{- else }}
    "type": "auto",
    "source": "~/.config/fastfetch/augustus.jpg",
{{- end }}
    "height": 18,
    "preserveAspectRatio": true,
    "padding": {
      "top": 0,
      "right": 4,
      "left": 1
    }
  },
  "display": {
    "disableLinewrap": true
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "showPeCoreCount": true,
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "│ ├",
      "detectionMethod": "pci",
      "hideType": "integrated",
      "format": "{name}",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "│ ├󱄄",
      "compactType": "original-with-refresh-rate",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "└ └",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "command",
      "key": "\ue900 OS",
      "keyColor": "blue",
{{- if eq .machine "augustus" }}
      "text": "version=$(omarchy-version 2>/dev/null || cat /etc/os-release | grep PRETTY_NAME | cut -d= -f2 | tr -d '\"') && echo \"Omarchy $version\""
{{- else }}
      "text": "cat /etc/os-release | grep PRETTY_NAME | cut -d= -f2 | tr -d '\"'"
{{- end }}
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "│ ├",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "│ ├󱫐",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "blue"
    },
    {
      "type": "command",
      "key": "│ ├󰈸",
      "keyColor": "blue",
      "text": "drift=$(timeout 1 dots status 2>/dev/null | grep -cE '^[[:space:]]*[MADRU?]{1,2}[[:space:]]|^[[:space:]]*(modified|added|removed|deleted|renamed):' || true); echo \"Chezmoi Drift: $drift unapplied\""
    },
    {
      "type": "command",
      "key": "└ └󰸌",
      "keyColor": "blue",
      "text": "theme=$(omarchy-theme-current 2>/dev/null || dots theme current 2>/dev/null || echo 'Tokyo Night'); printf '%s \\033[38m●\\033[37m●\\033[36m●\\033[35m●\\033[34m●\\033[33m●\\033[32m●\\033[31m●\\033[0m\\n' \"$theme\""
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    }
  ]
}
