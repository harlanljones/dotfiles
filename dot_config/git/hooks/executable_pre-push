#!/usr/bin/env bash
# Gitleaks pre-push hook: scan outgoing commits before they leave the machine.
# Wired via core.hooksPath in ~/.config/git/config (see dot_config/git/config.tmpl),
# so the hook applies to every repo on every machine managed by the dotfiles.
set -euo pipefail

# Degrade gracefully: a machine without gitleaks still pushes, with a warning.
if ! command -v gitleaks >/dev/null 2>&1; then
	echo "pre-push: gitleaks not installed; skipping secret scan (see mise config.toml)" >&2
	exit 0
fi

zero=0000000000000000000000000000000000000000
ranges=()

while read -r old_rev new_rev _ref; do
	# Ref deletion: nothing new is pushed.
	if [[ "$new_rev" == "$zero" ]]; then
		continue
	fi
	if [[ "$old_rev" == "$zero" ]]; then
		# New branch: scan commits not already reachable from an existing ref.
		# git-log ranges, not bare SHAs: gitleaks hands --log-opts straight to
		# git log, which handles "--not --all" natively.
		# Edge case: in a mixed push (update + new branch), commits already
		# reachable from another local unpushed ref are skipped by "--not --all"
		# and go unscanned until that ref is pushed.
		ranges+=("$new_rev --not --all")
	else
		ranges+=("$old_rev..$new_rev")
	fi
done

# No-op-safe: zero-diff or ref-deletion-only push leaves nothing to scan.
if [[ ${#ranges[@]} -eq 0 ]]; then
	exit 0
fi

echo "pre-push: running gitleaks on outgoing commits"
gitleaks detect --source . --log-opts="${ranges[*]}" --no-banner --redact --exit-code 1 ||
	{ echo "pre-push: gitleaks failed" >&2; exit 1; }
