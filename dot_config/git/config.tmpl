{{- $gh := "" -}}
{{- if eq .machine "hadrian" -}}
{{-   $gh = "/opt/homebrew/bin/gh" -}}
{{- else -}}
{{-   $gh = "/usr/bin/gh" -}}
{{- end -}}
{{- /* Fall back to PATH only when the package-manager location is absent
       (Vespasian: gh comes from mise or ~/.local/bin), so the rendered file
       stays unchanged on Augustus and Hadrian. */ -}}
{{- if not (stat $gh) -}}
{{-   $found := lookPath "gh" -}}
{{-   if $found -}}
{{-     $gh = $found -}}
{{-   end -}}
{{- end -}}
# See https://git-scm.com/docs/git-config

[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
[init]
	defaultBranch = master
[pull]
	rebase = true 			 # Rebase (instead of merge) on pull
[push]
	autoSetupRemote = true   # Automatically set upstream branch on push
[diff]
	algorithm = histogram    # Clearer diffs on moved/edited lines
	colorMoved = plain       # Highlight moved blocks in diffs
	mnemonicPrefix = true    # More intuitive refs in diff output
[commit]
	verbose = true           # Include diff comment in commit message template
[column]
	ui = auto 			     # Output in columns when possible
[branch]
	sort = -committerdate    # Sort branches by most recent commit first
[tag]
	sort = -version:refname  # Sort version numbers as you would expect
[rerere]
	enabled = true           # Record and reuse conflict resolutions
	autoupdate = true        # Apply stored conflict resolutions automatically
[user]
	name = Harlan Jones
	email = harlanljones@gmail.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJJ6caZOCH+I3WuG/qfa7fItOrlm1lF95dIqSAxG4kFs
[gpg]
	format = ssh
[gpg "ssh"]
{{- if eq .machine "hadrian" }}
	program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
{{- else if eq .machine "vespasian" }}
	program = "op-ssh-sign"
{{- else }}
	program = "/opt/1Password/op-ssh-sign"
{{- end }}
[commit]
	gpgsign = true

[credential "https://github.com"]
	helper = 
	helper = !{{ $gh }} auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential
{{- if lookPath "delta" }}

# delta pager (only wired up when the binary is installed)

{{- end }}
[core]
	fsmonitor = true
	untrackedCache = true
{{- if lookPath "delta" }}
	pager = delta
{{- end }}
[status]
	showUntrackedFiles = normal
[advice]
	statusUoption = false
{{- if lookPath "delta" }}

[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictstyle = zdiff3
{{- if eq .machine "vespasian" }}
[include]
	path = ~/.config/delta/theme.gitconfig
{{- end }}
{{- end }}

