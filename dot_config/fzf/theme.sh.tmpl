{{- /* hasKey: CI's shellcheck job renders scripts without a chezmoi config. */ -}}
{{- if and (hasKey . "machine") (eq .machine "vespasian") -}}
{{- $name := (index .machines .machine).theme.name -}}
{{- $gen := false -}}
{{- if hasKey .themes $name -}}{{- $tk := index .themes $name -}}{{- if and (hasKey $tk "kind") (eq (index $tk "kind") "generated") -}}{{- $gen = true -}}{{- end -}}{{- end -}}
{{- $p := dict -}}
{{- if $gen -}}{{- $p = includeTemplate ".chezmoitemplates/gen-palette.tmpl" $name | fromJson -}}{{- end }}
#!/usr/bin/env bash
# fzf colors for the {{ (index .themes $name).label }} theme, selected with `dots theme`.
# Sourced by ~/.config/shell/65-theme.sh. Only the color and line-highlight
# options are themed here{{ if $gen }} (derived from the generated
# windows_terminal.json palette; kind: generated themes carry no curated
# fzf.sh){{ else }} — they come from .chezmoitemplates/themes/{{ $name }}/fzf.sh{{ end }}; layout,
# border and info style stay as 10-tools.sh sets them.
export FZF_DEFAULT_OPTS="$FZF_DEFAULT_OPTS \
{{- if $gen }}
  --highlight-line \
  --color=bg+:{{ $p.selectionBackground }} \
  --color=bg:{{ $p.background }} \
  --color=border:{{ $p.brightBlack }} \
  --color=fg:{{ $p.foreground }} \
  --color=gutter:{{ $p.background }} \
  --color=header:{{ $p.yellow }} \
  --color=hl+:{{ $p.cyan }} \
  --color=hl:{{ $p.cyan }} \
  --color=info:{{ $p.brightBlack }} \
  --color=marker:{{ $p.purple }} \
  --color=pointer:{{ $p.purple }} \
  --color=prompt:{{ $p.cyan }} \
  --color=query:{{ $p.foreground }}:regular \
  --color=scrollbar:{{ $p.brightBlack }} \
  --color=separator:{{ $p.yellow }} \
  --color=spinner:{{ $p.purple }} \
{{- else }}
{{ range splitList "\n" (include (printf ".chezmoitemplates/themes/%s/fzf.sh" $name)) -}}
{{ if regexMatch "^\\s*--(color=|highlight-line)" . -}}
{{ . }}
{{ end -}}
{{ end -}}
{{- end }}
"
{{- end -}}
