# Cloud services probed by dots-cloud-status for the splash "Cloud Workflows"
# card. One per line: <kind> <name> <target>. Blank lines and # comments ignored.
#
#   site    <name> <https url>       public endpoint; 2xx/3xx counts as up
#   edge    <name> <https url>       herdr-outpost dashboard (Cloudflare Worker)
#   tunnel  <name> <https url>       herdr-outpost relay via Cloudflare Tunnel
#   daemon  <name> <systemd --user unit>   checked live by the splash
#   actions <owner> <days>           GitHub Actions across owned repos pushed in the
#                                    last <days>: newest commit per branch, red if
#                                    any workflow on it failed (GitHub's rollup)
#   job     <name> <owner/repo:branch:path>   last push of a job's output file
#   cloudflare <workers|pages>       latest Workers Build / Pages deployment per
#                                    project; token in ~/.config/dots/cloudflare.env

daemon  agents   omarchy-agents.service
daemon  hermes   hermes-gateway.service
daemon  relay    herdr-outpost-relay.service

edge    herdr    https://herdr.harlanljones.com
tunnel  relay    https://relay.harlanljones.com

job     collector  harlanljones/harlanljones:profile-cards:skills.svg
actions harlanljones 14

cloudflare workers
cloudflare pages

