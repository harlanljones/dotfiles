{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "sudo *": "ask",
      "chmod -R *": "ask",
      "chown -R *": "ask",
      "dd *": "ask",
      "mkfs*": "ask",
      "shutdown*": "ask",
      "reboot*": "ask",
      "git commit*": "deny",
      "git push*": "deny"
    }
  },
  "mcp": {
    "codebase-memory-mcp": {"command":["/home/harlan/.local/bin/codebase-memory-mcp"],"type":"local"}
  }
}
