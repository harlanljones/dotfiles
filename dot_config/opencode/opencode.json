{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permission": {
    "read": {
      "/tmp/*": "allow"
    },
    "edit": {
      "*": "allow",
      "/tmp/*": "allow"
    },
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "sudo *": "ask",
      "chmod -R *": "ask",
      "chown -R *": "ask",
      "dd *": "ask",
      "mkfs*": "ask",
      "shutdown*": "ask",
      "reboot*": "ask",
      "git commit*": "deny",
      "git push*": "deny"
    }
  },
  "provider": {
    "gmicloud": {
      "models": {
        "MiniMaxAI/MiniMax-M3": {
          "name": "MiniMax M3",
          "reasoning": true,
          "tool_call": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 524288,
            "output": 128000
          }
        }
      }
    },
    "bai": {
      "api": "https://api.b.ai/v1",
      "env": [
        "BAI_API_KEY"
      ],
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "deepseek-v4-flash-vision-exp": {
          "name": "DeepSeek V4 Flash (Vision, exp)"
        },
        "hy3": {
          "name": "HY3"
        },
        "mimo-v2.5": {
          "name": "MiMo v2.5"
        }
      }
    },
    "bai-glm": {
      "api": "https://api.b.ai/v1",
      "env": [
        "BAI_GLM_API_KEY"
      ],
      "models": {
        "glm-5.2": {
          "name": "GLM 5.2"
        },
        "grok-4.6": {
          "name": "Grok 4.6"
        }
      }
    },
    "bai-gpt": {
      "api": "https://api.b.ai/v1",
      "env": [
        "BAI_GPT_API_KEY"
      ],
      "models": {
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna"
        },
        "glm-5.3": {
          "name": "GLM 5.3"
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol"
        }
      }
    },
    "aihubmix": {
      "env": [
        "AIHUBMIX_API_KEY"
      ],
      "models": {
        "coding-kimi-k3-free": {
          "name": "Coding Kimi K3 (Free)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 256000,
            "output": 32768
          }
        }
      }
    },
    "gorouter": {
      "api": "https://gorouter.app/v1",
      "env": [
        "GOROUTER_API_KEY"
      ],
      "models": {
        "claude-opus-5": {
          "name": "Claude Opus 5",
          "reasoning": true,
          "tool_call": true
        },
        "claude-opus-5-thinking": {
          "name": "Claude Opus 5 (Thinking)",
          "reasoning": true,
          "tool_call": true,
          "interleaved": {
            "field": "reasoning_content"
          }
        }
      }
    }
  },
  "mcp": {
    "codebase-memory-mcp": {
      "command": [
        "/home/harlan/.local/bin/codebase-memory-mcp"
      ],
      "type": "local"
    }
  }
}
