/* hyprshell styles — colors are GENERATED from the current dots theme palette
 * (same engine as btop/ghostty), so the alt-tab follows `dots theme set`.
 * Only upstream default-sheet variables are overridden; grid geometry and
 * thumbnail rendering are fixed upstream (hyprshell 4.10 exposes no sizing
 * vars). Reference: https://github.com/H3rmt/hyprshell docs/css-examples/
 */
{{- $name := includeTemplate ".chezmoitemplates/machine-theme-name.tmpl" . -}}
{{- /* The windows_terminal.json snapshot carries leading `#` comment lines;
       rebuild the JSON without them so fromJson can parse it. */ -}}
{{- $buf := "" -}}
{{- range $line := splitList "\n" (include (printf ".chezmoitemplates/themes/%s/windows_terminal.json" $name)) -}}
{{-   if not (hasPrefix "#" (trim $line)) }}{{ $buf = printf "%s%s" $buf $line }}{{ end -}}
{{- end -}}
{{- $p := $buf | fromJson -}}
{{- /* Accent from the theme registry; fall back to the palette blue. */ -}}
{{- $acc := index $p "blue" -}}
{{- if and (hasKey .themes $name) (index .themes $name) -}}
{{-   $t := index .themes $name -}}
{{-   if and (hasKey $t "windows") (index $t "windows") -}}
{{-     $w := index $t "windows" -}}
{{-     if hasKey $w "accent" }}{{ $acc = index $w "accent" }}{{ end -}}
{{-   end -}}
{{- end }}
:root {
    --bg-window-color: {{ $p.background }}e6;
    --bg-color: {{ $p.foreground }}0f;
    --bg-color-hover: {{ $p.foreground }}1f;

    --border-color: {{ $p.brightBlack }}66;
    --border-color-active: {{ $acc }}e6;

    --border-radius: 12px;
    --border-size: 2px;
    --border-style: solid;

    --text-color: {{ $p.foreground }};

    --window-padding: 2px;
}
