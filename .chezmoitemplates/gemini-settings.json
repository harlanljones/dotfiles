{
{{- /* "Dots" theme derived from the active `dots theme` palette via
       theme-palette.tmpl - works for curated AND generated themes, so no
       per-theme gemini.json port is needed. */}}
{{- $p := includeTemplate ".chezmoitemplates/theme-palette.tmpl" . | fromJson }}
  "ui": {
    "theme": "Dots",
    "customThemes": {
      "Dots": {
        "name": "Dots",
        "type": "custom",
        "text": {"primary": {{ $p.fg | toJson }}, "secondary": {{ $p.muted | toJson }}, "response": {{ $p.fg | toJson }}},
        "background": {"primary": {{ $p.bg | toJson }}, "diff": {"added": {{ $p.black | toJson }}, "removed": {{ $p.black | toJson }}}},
        "border": {"default": {{ $p.selection | toJson }}, "focused": {{ $p.accent | toJson }}},
        "ui": {"comment": {{ $p.muted | toJson }}, "symbol": {{ $p.muted | toJson }}, "gradient": [{{ $p.accent | toJson }}, {{ $p.magenta | toJson }}, {{ $p.cyan | toJson }}]},
        "Background": {{ $p.bg | toJson }},
        "Foreground": {{ $p.fg | toJson }},
        "LightBlue": {{ $p.cyan | toJson }},
        "AccentBlue": {{ $p.magenta | toJson }},
        "AccentPurple": {{ $p.magenta | toJson }},
        "AccentCyan": {{ $p.cyan | toJson }},
        "AccentGreen": {{ $p.yellow | toJson }},
        "AccentYellow": {{ $p.green | toJson }},
        "AccentRed": {{ $p.red | toJson }},
        "DiffAdded": {{ $p.black | toJson }},
        "DiffRemoved": {{ $p.black | toJson }},
        "Comment": {{ $p.muted | toJson }},
        "Gray": {{ $p.muted | toJson }},
        "DarkGray": {{ $p.black | toJson }},
        "GradientColors": [{{ $p.accent | toJson }}, {{ $p.magenta | toJson }}, {{ $p.cyan | toJson }}]
      }
    }
  },
  "mcpServers": {
    "codebase-memory-mcp": {"command":"/home/harlan/.local/bin/codebase-memory-mcp","args":[]}
  },
  "hooks": {
    "BeforeTool": [
    {
        "matcher": "google_web_search|grep_search",
        "hooks": [
            {
                "type": "command",
                "command": "node -e \"process.stdout.write(JSON.stringify({hookSpecificOutput:{hookEventName:'BeforeTool',additionalContext:'Code discovery: prefer codebase-memory-mcp search_graph, trace_path, and get_code_snippet over grep or file search.'}}))\""
            }
        ]
    }
],
    "AfterTool": [
    {
        "matcher": "read_file",
        "hooks": [
            {
                "type": "command",
                "command": "'/home/harlan/.local/bin/codebase-memory-mcp' hook-augment --dialect gemini",
                "timeout": 5000
            }
        ]
    }
],
    "SessionStart": [
    {
        "matcher": "startup",
        "hooks": [
            {
                "type": "command",
                "command": "node -e \"process.stdout.write(JSON.stringify({hookSpecificOutput:{hookEventName:'SessionStart',additionalContext:'Code discovery: prefer codebase-memory-mcp search_graph, trace_path, get_code_snippet, query_graph, and search_code; run index_repository first when needed.'}}))\"",
                "timeout": 5000
            },
            {
                "type": "command",
                "command": "test ! -x \"$HOME/.local/bin/herdr-gemini-session\" || \"$HOME/.local/bin/herdr-gemini-session\"",
                "timeout": 5
            }
        ]
    },
    {
        "matcher": "resume",
        "hooks": [
            {
                "type": "command",
                "command": "node -e \"process.stdout.write(JSON.stringify({hookSpecificOutput:{hookEventName:'SessionStart',additionalContext:'Code discovery: prefer codebase-memory-mcp search_graph, trace_path, get_code_snippet, query_graph, and search_code; run index_repository first when needed.'}}))\"",
                "timeout": 5000
            },
            {
                "type": "command",
                "command": "test ! -x \"$HOME/.local/bin/herdr-gemini-session\" || \"$HOME/.local/bin/herdr-gemini-session\"",
                "timeout": 5
            }
        ]
    },
    {
        "matcher": "clear",
        "hooks": [
            {
                "type": "command",
                "command": "node -e \"process.stdout.write(JSON.stringify({hookSpecificOutput:{hookEventName:'SessionStart',additionalContext:'Code discovery: prefer codebase-memory-mcp search_graph, trace_path, get_code_snippet, query_graph, and search_code; run index_repository first when needed.'}}))\"",
                "timeout": 5000
            },
            {
                "type": "command",
                "command": "test ! -x \"$HOME/.local/bin/herdr-gemini-session\" || \"$HOME/.local/bin/herdr-gemini-session\"",
                "timeout": 5
            }
        ]
    }
]
  }
}
