[delta]
  minus-style                   = syntax "#39242c"
  minus-non-emph-style          = syntax "#39242c"
  minus-emph-style              = syntax "#502930"
  minus-empty-line-marker-style = syntax "#39242c"
  line-numbers-minus-style      = "#c34043"
  plus-style                    = syntax "#2d3233"
