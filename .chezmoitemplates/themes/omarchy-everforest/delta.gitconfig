[delta]
  minus-style                   = syntax "#4b4146"
  minus-non-emph-style          = syntax "#4b4146"
  minus-emph-style              = syntax "#644b50"
  minus-empty-line-marker-style = syntax "#4b4146"
  line-numbers-minus-style      = "#e67e80"
  plus-style                    = syntax "#414b46"
