[delta]
  minus-style                   = syntax "#efdddb"
  minus-non-emph-style          = syntax "#efdddb"
  minus-emph-style              = syntax "#e5c8ca"
  minus-empty-line-marker-style = syntax "#efdddb"
  line-numbers-minus-style      = "#b4637a"
  plus-style                    = syntax "#d8dedc"
