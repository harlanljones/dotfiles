{
  "name": "${label}",
  "type": "custom",
  "text": {
    "primary": "${foreground}",
    "secondary": "${dim_foreground}",
    "response": "${foreground}"
  },
  "background": {
    "primary": "${background}",
    "diff": {
      "added": "${plus_bg}",
      "removed": "${minus_bg}"
    }
  },
  "border": {
    "default": "${selection}",
    "focused": "${accent}"
  },
  "ui": {
    "comment": "${muted}",
    "symbol": "${dim_foreground}",
    "gradient": ["${blue}", "${magenta}", "${cyan}"]
  },
  "Background": "${background}",
  "Foreground": "${foreground}",
  "LightBlue": "${cyan}",
  "AccentBlue": "${magenta}",
  "AccentPurple": "${magenta}",
  "AccentCyan": "${cyan}",
  "AccentGreen": "${yellow}",
  "AccentYellow": "${green}",
  "AccentRed": "${red}",
  "DiffAdded": "${plus_bg}",
  "DiffRemoved": "${minus_bg}",
  "Comment": "${muted}",
  "Gray": "${dim_foreground}",
  "DarkGray": "${dark_background}",
  "GradientColors": ["${blue}", "${magenta}", "${cyan}"]
}
