# Homebrew Bundle manifest (macOS)
#
# Restore:  brew bundle --file=~/.Brewfile
# Refresh:  brew bundle dump --file=~/.Brewfile --force
#
# Managed by chezmoi; curate by hand -- this is the declarative source of
# truth for system packages that mise does not manage.

# CLI tools (parity with the Linux pacman list)
brew "age"
brew "direnv"
brew "eza"
brew "fzf"
brew "gh"
brew "lazygit"
brew "mise"
brew "neovim"
brew "starship"
brew "zoxide"
brew "atuin"
brew "delta"

# Depended on by the shell modules, not merely nice to have:
#   fd       -> FZF_DEFAULT_COMMAND / FZF_ALT_C_COMMAND  (10-tools.sh)
#   bat      -> MANPAGER shim                            (10-tools.sh)
#   ripgrep  -> RIPGREP_CONFIG_PATH                      (10-tools.sh)
#   jq       -> the claude settings/mcp sync scripts
brew "fd"
brew "bat"
brew "ripgrep"
brew "jq"

# Repo tooling. CI lints every managed script with `shellcheck -S warning`
# (.github/workflows/ci.yml), so having it locally is what lets you reproduce
# that gate before pushing rather than after.
brew "shellcheck"

# Apps & fonts
cask "ghostty"
cask "font-jetbrains-mono-nerd-font"
