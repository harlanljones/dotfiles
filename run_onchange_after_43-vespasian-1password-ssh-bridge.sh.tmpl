{{- if and (hasKey . "machine") (eq .machine "vespasian") -}}
#!/usr/bin/env bash
# Build and configure 1Password SSH bridge for WSL2
set -euo pipefail

mkdir -p "$HOME/.local/bin" "$HOME/.1password"

# 1. Symlink op-ssh-sign-wsl.exe if present
WIN_OP_SSH_SIGN="/mnt/c/Users/harlan/AppData/Local/Microsoft/WindowsApps/Agilebits.1Password_amwd9z03whsfe/op-ssh-sign-wsl.exe"
if [[ -x "$WIN_OP_SSH_SIGN" ]]; then
  ln -sf "$WIN_OP_SSH_SIGN" "$HOME/.local/bin/op-ssh-sign"
fi

# 2. Build npiperelay.exe if missing
if [[ ! -f "$HOME/.local/bin/npiperelay.exe" ]] && command -v go >/dev/null 2>&1; then
  BUILD_DIR="$(mktemp -d)"
  if git clone --depth=1 https://github.com/jstarks/npiperelay.git "$BUILD_DIR" 2>/dev/null; then
    (cd "$BUILD_DIR" && GOOS=windows go build -o "$HOME/.local/bin/npiperelay.exe" .)
  fi
  rm -rf "$BUILD_DIR"
fi

# 3. Build wsl-ssh-bridge
BRIDGE_SRC="$HOME/.local/share/wsl-ssh-bridge/main.go"
if [[ -f "$BRIDGE_SRC" ]] && command -v go >/dev/null 2>&1; then
  go build -o "$HOME/.local/bin/wsl-ssh-bridge" "$BRIDGE_SRC"
fi
{{- end -}}
