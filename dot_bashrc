# If not running interactively, don't do anything (leave this at the top of this file)
[[ $- != *i* ]] && return

# All the default Omarchy aliases and functions
# (don't mess with these directly, just overwrite them here!)
# /etc/omarchy.conf is written by omarchy-dev-link. When absent, force the
# package default instead of preserving a stale inherited dev-link value before
# we decide which rc file to source.
if [[ -f /etc/omarchy.conf ]]; then
  source /etc/omarchy.conf
  export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
else
  export OMARCHY_PATH=/usr/share/omarchy
fi
# Guarded so Linux boxes without Omarchy (Vespasian, WSL) still get a working
# shell; ~/.config/shell/15-base-bash.sh supplies the base layer there.
if [[ -r "$OMARCHY_PATH/default/bash/rc" ]]; then
  source "$OMARCHY_PATH/default/bash/rc"
  OMARCHY_BASE_LOADED=1
fi

# Everything personal lives in ~/.config/shell/*.sh, shared with zsh and
# sourced in numeric order. See that directory's README for what goes where.
#
# Do not add configuration to this file. Machine-local additions -- including
# anything an installer appends -- belong in ~/.config/shell/99-local.sh, which
# is untracked and sourced last. This file is managed by chezmoi, so edits made
# here are overwritten on the next `chezmoi apply`.
for _shell_module in "${XDG_CONFIG_HOME:-$HOME/.config}"/shell/*.sh; do
  [ -r "$_shell_module" ] && source "$_shell_module"
done
unset _shell_module

# >>> Codex installer >>>
export PATH="/home/harlan/.local/bin:$PATH"
# <<< Codex installer <<<

# opencode
export PATH=/home/harlan/.opencode/bin:$PATH

# >>> grok installer >>>
export PATH="$HOME/.grok/bin:$PATH"
[[ -r "$HOME/.grok/completions/bash/grok.bash" ]] && source "$HOME/.grok/completions/bash/grok.bash"
# <<< grok installer <<<

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/home/harlan/google-cloud-sdk/path.bash.inc' ]; then . '/home/harlan/google-cloud-sdk/path.bash.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/home/harlan/google-cloud-sdk/completion.bash.inc' ]; then . '/home/harlan/google-cloud-sdk/completion.bash.inc'; fi
